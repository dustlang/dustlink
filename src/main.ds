// Description:
//   Dust-native dustlink executable entrypoint.
//   Host CLI dispatch is routed through Dust code (no backend forwarding).
//   Entry point: main() calls LinkerHostCli::run_with_host_args()

forge DustLinkMain {
    proc K::main() -> UInt32 {
        return LinkerHostCli::K::run_with_host_args();
    }
}
