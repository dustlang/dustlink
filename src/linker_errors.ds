// Description:
//   DustLink Error Codes - ABI-stable linker statuses.
//   Provides:
//     - ERR_OK, ERR_FILE_NOT_FOUND, ERR_INVALID_FORMAT
//     - ERR_INVALID_SECTION, ERR_UNDEFINED_SYMBOL
//     - ERR_MULTIPLE_DEFINITION, ERR_INVALID_RELOCATION
//     - ERR_NOT_IMPLEMENTED_YET

forge LinkerErrors {
    const ERR_OK: UInt32 = 0;
    const ERR_FILE_NOT_FOUND: UInt32 = 1;
    const ERR_INVALID_FORMAT: UInt32 = 2;
    const ERR_INVALID_SECTION: UInt32 = 3;
    const ERR_UNDEFINED_SYMBOL: UInt32 = 4;
    const ERR_MULTIPLE_DEFINITION: UInt32 = 5;
    const ERR_INVALID_RELOCATION: UInt32 = 6;
    const ERR_OUT_OF_MEMORY: UInt32 = 7;
    const ERR_INVALID_ADDRESS: UInt32 = 8;
    const ERR_INVALID_ENTRY: UInt32 = 9;
    const ERR_WRITE_FAILED: UInt32 = 10;
    const ERR_INVALID_IMAGE: UInt32 = 11;

    // GCC/LLD-compatible option surface validation errors.
    const ERR_UNSUPPORTED_FLAG: UInt32 = 12;
    const ERR_MISSING_FLAG_VALUE: UInt32 = 13;
    const ERR_UNSUPPORTED_TARGET: UInt32 = 14;
    const ERR_EMPTY_INPUT: UInt32 = 15;
    const ERR_CONFLICTING_OPTIONS: UInt32 = 16;
    const ERR_NOT_IMPLEMENTED_YET: UInt32 = 17;

    proc K::is_error(code: UInt32) -> UInt32 {
        if code == ERR_OK {
            return 0;
        } else {
            return 1;
        }
    }

    proc K::is_success(code: UInt32) -> UInt32 {
        if code == ERR_OK {
            return 1;
        } else {
            return 0;
        }
    }
proc Φ::is_error(code: UInt32) -> UInt32 {
        return 100;
    }
}

