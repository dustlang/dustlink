        if reloc_type == R_AARCH64_TLSDESC_ADD_LO12 { return 1; }
        if reloc_type == R_AARCH64_TLSDESC_CALL { return 1; }
        if reloc_type == R_AARCH64_TLS_DTPMOD { return 1; }
        if reloc_type == R_AARCH64_TLS_DTPREL { return 1; }
        if reloc_type == R_AARCH64_TLS_TPREL { return 1; }
        return 0;
    }

    proc K::aarch64_page_delta_bytes(symbol_plus_addend: UInt64, place_addr: UInt64) -> UInt64 {
        let page_mask = 0 - 4096;
        let sym_page = symbol_plus_addend & page_mask;
        let place_page = place_addr & page_mask;
        if sym_page >= place_page {
            return sym_page - place_page;
        } else {
            return 0 - (place_page - sym_page);
        }
    }

    proc K::aarch64_branch26_patch_word(instr: UInt64, reloc_type: UInt32, delta: UInt64) -> UInt64 {
        let opcode_mask = 4227858432;
        let branch_b = 335544320;
        let branch_bl = 2483027968;
        let top = instr & opcode_mask;
        if reloc_type == R_AARCH64_JUMP26 {
            if top ! branch_b {
                return 0;
            }
        } else {
            if reloc_type == R_AARCH64_CALL26 {
                if top ! branch_bl {
                    return 0;
                }
            } else {
                return 0;
            }
        }
        if (delta & 3) ! 0 {
            return 0;
        }
        if fits_s28(delta) == 0 {
            return 0;
        }
        let imm26 = (delta / 4) & 67108863;
        return (instr & opcode_mask) | imm26;
    }

    proc K::aarch64_condbr19_patch_word(instr: UInt64, delta: UInt64) -> UInt64 {
        let cond_mask = 4278190096;
        let cond_opcode = 1409286144;
        let cond_preserve_mask = 4278190111;
        if (instr & cond_mask) ! cond_opcode {
            return 0;
        }
        if (delta & 3) ! 0 {
            return 0;
        }
        if fits_s21(delta) == 0 {
            return 0;
        }
        let imm19 = (delta / 4) & 524287;
        return (instr & cond_preserve_mask) | (imm19 * 32);
    }

    proc K::aarch64_ld_prel_lo19_patch_word(instr: UInt64, delta: UInt64) -> UInt64 {
        let ld_literal_mask = 452984832;
        let ld_literal_opcode = 402653184;
        let ld_literal_preserve_mask = 4278190111;
        if (instr & ld_literal_mask) ! ld_literal_opcode {
            return 0;
        }
        if (delta & 3) ! 0 {
            return 0;
        }
        if fits_s21(delta) == 0 {
            return 0;
        }
        let imm19 = (delta / 4) & 524287;
        return (instr & ld_literal_preserve_mask) | (imm19 * 32);
    }

    proc K::aarch64_adr_prel_lo21_patch_word(instr: UInt64, delta: UInt64) -> UInt64 {
        let adr_mask = 2667577344;
        let adr_opcode = 268435456;
        let adr_preserve_mask = 2667577375;
        if (instr & adr_mask) ! adr_opcode {
            return 0;
        }
        if fits_s21(delta) == 0 {
            return 0;
        }
        let immlo = delta & 3;
        let immhi = (delta / 4) & 524287;
        return (instr & adr_preserve_mask) | (immlo * 536870912) | (immhi * 32);
    }

    proc K::aarch64_movw_chunk_index(reloc_type: UInt32) -> UInt32 {
        if reloc_type == R_AARCH64_MOVW_UABS_G0 { return 0; }
        if reloc_type == R_AARCH64_MOVW_UABS_G0_NC { return 0; }
        if reloc_type == R_AARCH64_MOVW_UABS_G1 { return 1; }
        if reloc_type == R_AARCH64_MOVW_UABS_G1_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_UABS_G2 { return 2; }
        if reloc_type == R_AARCH64_MOVW_UABS_G2_NC { return 2; }
        if reloc_type == R_AARCH64_MOVW_UABS_G3 { return 3; }
        if reloc_type == R_AARCH64_MOVW_SABS_G0 { return 0; }
        if reloc_type == R_AARCH64_MOVW_SABS_G1 { return 1; }
        if reloc_type == R_AARCH64_MOVW_SABS_G2 { return 2; }
        if reloc_type == R_AARCH64_MOVW_PREL_G0 { return 0; }
        if reloc_type == R_AARCH64_MOVW_PREL_G0_NC { return 0; }
        if reloc_type == R_AARCH64_MOVW_PREL_G1 { return 1; }
        if reloc_type == R_AARCH64_MOVW_PREL_G1_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_PREL_G2 { return 2; }
        if reloc_type == R_AARCH64_MOVW_PREL_G2_NC { return 2; }
        if reloc_type == R_AARCH64_MOVW_PREL_G3 { return 3; }
        if reloc_type == R_AARCH64_TLSGD_MOVW_G1 { return 1; }
        if reloc_type == R_AARCH64_TLSGD_MOVW_G0_NC { return 0; }
        if reloc_type == R_AARCH64_TLSLD_MOVW_G1 { return 1; }
        if reloc_type == R_AARCH64_TLSLD_MOVW_G0_NC { return 0; }
        return 255;
    }

    proc K::aarch64_movw_reloc_class(reloc_type: UInt32) -> UInt32 {
        if reloc_type == R_AARCH64_MOVW_UABS_G0 { return 1; }
        if reloc_type == R_AARCH64_MOVW_UABS_G0_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_UABS_G1 { return 1; }
        if reloc_type == R_AARCH64_MOVW_UABS_G1_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_UABS_G2 { return 1; }
        if reloc_type == R_AARCH64_MOVW_UABS_G2_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_UABS_G3 { return 1; }
        if reloc_type == R_AARCH64_MOVW_SABS_G0 { return 2; }
        if reloc_type == R_AARCH64_MOVW_SABS_G1 { return 2; }
        if reloc_type == R_AARCH64_MOVW_SABS_G2 { return 2; }
        if reloc_type == R_AARCH64_MOVW_PREL_G0 { return 3; }
        if reloc_type == R_AARCH64_MOVW_PREL_G0_NC { return 3; }
        if reloc_type == R_AARCH64_MOVW_PREL_G1 { return 3; }
        if reloc_type == R_AARCH64_MOVW_PREL_G1_NC { return 3; }
        if reloc_type == R_AARCH64_MOVW_PREL_G2 { return 3; }
        if reloc_type == R_AARCH64_MOVW_PREL_G2_NC { return 3; }
        if reloc_type == R_AARCH64_MOVW_PREL_G3 { return 3; }
        if reloc_type == R_AARCH64_TLSGD_MOVW_G1 { return 4; }
        if reloc_type == R_AARCH64_TLSGD_MOVW_G0_NC { return 4; }
        if reloc_type == R_AARCH64_TLSLD_MOVW_G1 { return 4; }
        if reloc_type == R_AARCH64_TLSLD_MOVW_G0_NC { return 4; }
        return 0;
    }

    proc K::aarch64_movw_is_nc(reloc_type: UInt32) -> UInt32 {
        if reloc_type == R_AARCH64_MOVW_UABS_G0_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_UABS_G1_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_UABS_G2_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_PREL_G0_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_PREL_G1_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_PREL_G2_NC { return 1; }
        if reloc_type == R_AARCH64_TLSGD_MOVW_G0_NC { return 1; }
        if reloc_type == R_AARCH64_TLSLD_MOVW_G0_NC { return 1; }
        return 0;
    }

    proc K::aarch64_movw_checked_value(reloc_type: UInt32, value: UInt64) -> UInt32 {
        if aarch64_movw_is_nc(reloc_type) == 1 {
            return 1;
        }
        let class_id = aarch64_movw_reloc_class(reloc_type);
        let idx = aarch64_movw_chunk_index(reloc_type);
        if class_id == 1 {
            if idx == 0 { return fits_u16(value); }
            if idx == 1 { return fits_u32(value); }
            if idx == 2 { return fits_u48(value); }
            return 1;
        }
        if class_id == 2 {
            if idx == 0 { return fits_s16(value); }
            if idx == 1 { return fits_s32(value); }
            if idx == 2 { return fits_s48(value); }
            return 0;
        }
        if class_id == 3 {
            if idx == 0 { return fits_s16(value); }
            if idx == 1 { return fits_s32(value); }
            if idx == 2 { return fits_s48(value); }
            if idx == 3 { return 1; }
            return 0;
        }
        if class_id == 4 {
            return 1;
        }
        return 0;
    }

    proc K::aarch64_movw_divisor(idx: UInt32) -> UInt64 {
        if idx == 0 { return 1; }
        if idx == 1 { return 65536; }
        if idx == 2 { return 4294967296; }
        if idx == 3 { return 281474976710656; }
        return 0;
    }

    proc K::aarch64_movw_patch_word(instr: UInt64, reloc_type: UInt32, value: UInt64) -> UInt64 {
        let movw_class_mask = 528482304;
        let movw_class_opcode = 310378496;
        let movw_imm_preserve_mask = 4292870175;
        if (instr & movw_class_mask) ! movw_class_opcode {
            return 0;
        }
        let idx = aarch64_movw_chunk_index(reloc_type);
        if idx > 3 {
            return 0;
        }
        let hw = (instr / 2097152) & 3;
        if hw ! idx {
            return 0;
        }
        let divisor = aarch64_movw_divisor(idx);
        if divisor == 0 {
            return 0;
        }
        let chunk = (value / divisor) & 65535;
        return (instr & movw_imm_preserve_mask) | (chunk * 32);
    }

    proc K::aarch64_tlsdesc_call_patch_word(instr: UInt64) -> UInt64 {
        let blr_mask = 4294966303;
        let blr_opcode = 3594452992;
        if instr == 0 {
            return 0;
        } else {
            if (instr & blr_mask) ! blr_opcode {
                return 0;
            } else {
                return instr;
            }
        }
    }

    proc K::aarch64_tstbr14_patch_word(instr: UInt64, delta: UInt64) -> UInt64 {
        let tst_mask = 2113929216;
        let tst_opcode_class = 905969664;
        let tst_preserve_mask = 4294443039;
        if (instr & tst_mask) ! tst_opcode_class {
            return 0;
        }
        if (delta & 3) ! 0 {
            return 0;
        }
        if fits_s16(delta) == 0 {
            return 0;
        }
        let imm14 = (delta / 4) & 16383;
        return (instr & tst_preserve_mask) | (imm14 * 32);
    }

    proc K::aarch64_adrp_patch_word(instr: UInt64, reloc_type: UInt32, page_delta: UInt64) -> UInt64 {
        let adrp_mask = 2667577344;
        let adrp_opcode = 2415919104;
        let adrp_preserve_mask = 2667577375;
        if (instr & adrp_mask) ! adrp_opcode {
            return 0;
        }
        if (page_delta & 4095) ! 0 {
            return 0;
        }
        if reloc_type == R_AARCH64_ADR_PREL_PG_HI21 {
            if fits_s33(page_delta) == 0 {
                return 0;
            }
        } else {
            if reloc_type ! R_AARCH64_ADR_PREL_PG_HI21_NC {
                return 0;
            }
        }
        let immlo = (page_delta / 4096) & 3;
        let immhi = (page_delta / 16384) & 524287;
        return (instr & adrp_preserve_mask) | (immlo * 536870912) | (immhi * 32);
    }

    proc K::aarch64_add_lo12_patch_word(instr: UInt64, sum: UInt64) -> UInt64 {
        let add_imm_mask = 2130706432;
        let add_imm_opcode = 285212672;
        let add_shift_mask = 12582912;
        let add_preserve_mask = 4290774015;
        if (instr & add_imm_mask) ! add_imm_opcode {
            return 0;
        }
        if (instr & add_shift_mask) ! 0 {
            return 0;
        }
        let imm12 = sum & 4095;
        return (instr & add_preserve_mask) | (imm12 * 1024);
    }

    proc K::aarch64_ldst_scale_bytes(reloc_type: UInt32) -> UInt64 {
        if reloc_type == R_AARCH64_LDST8_ABS_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_LDST16_ABS_LO12_NC { return 2; }
        if reloc_type == R_AARCH64_LDST32_ABS_LO12_NC { return 4; }
        if reloc_type == R_AARCH64_LDST64_ABS_LO12_NC { return 8; }
        if reloc_type == R_AARCH64_TLSLD_LDST64_DTPREL_LO12_NC { return 8; }
        if reloc_type == R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC { return 8; }
        if reloc_type == R_AARCH64_TLSDESC_LD64_LO12 { return 8; }
        if reloc_type == R_AARCH64_LDST128_ABS_LO12_NC { return 16; }
        if reloc_type == R_AARCH64_TLSLE_LDST128_TPREL_LO12_NC { return 16; }
        if reloc_type == R_AARCH64_TLSLD_LDST128_DTPREL_LO12_NC { return 16; }
        return 0;
    }

    proc K::aarch64_ldst_lo12_patch_word(instr: UInt64, reloc_type: UInt32, sum: UInt64) -> UInt64 {
        let ldst_preserve_mask = 4290774015;
        let scale = aarch64_ldst_scale_bytes(reloc_type);
        if scale == 0 {
            return 0;
        }
        let lo12 = sum & 4095;
        if scale > 1 {
            let scaled = lo12 / scale;
            if (scaled * scale) ! lo12 {
                return 0;
            }
        }
        let imm12 = lo12 / scale;
        return (instr & ldst_preserve_mask) | (imm12 * 1024);
    }

    proc K::apply_aarch64_instruction_relocation(
        section_index: UInt32,
        offset: UInt64,
        reloc_type: UInt32,
        value: UInt64
    ) -> UInt32 {
        let instr = host_linker_read_u32(section_index, offset);
        if reloc_type == R_AARCH64_JUMP26 {
            let patched_jump = aarch64_branch26_patch_word(instr, reloc_type, value);
            if patched_jump == 0 {
                return ERR_INVALID_RELOCATION;
            } else {
                return host_linker_patch_u32(section_index, offset, patched_jump);
            }
        }
        if reloc_type == R_AARCH64_CALL26 {
            let patched_call = aarch64_branch26_patch_word(instr, reloc_type, value);
            if patched_call == 0 {
                return ERR_INVALID_RELOCATION;
            } else {
                return host_linker_patch_u32(section_index, offset, patched_call);
            }
        }
        if reloc_type == R_AARCH64_CONDBR19 {
            let patched_cond = aarch64_condbr19_patch_word(instr, value);
            if patched_cond == 0 {
                return ERR_INVALID_RELOCATION;
            } else {
                return host_linker_patch_u32(section_index, offset, patched_cond);
            }
        }
        if reloc_type == R_AARCH64_LD_PREL_LO19 {
            let patched_ldlit = aarch64_ld_prel_lo19_patch_word(instr, value);
            if patched_ldlit == 0 {
                return ERR_INVALID_RELOCATION;
            } else {
                return host_linker_patch_u32(section_index, offset, patched_ldlit);
            }
        }
        if reloc_type == R_AARCH64_TLSLD_LD_PREL19 {
            let patched_tlsld_ldlit = aarch64_ld_prel_lo19_patch_word(instr, value);
            if patched_tlsld_ldlit == 0 {
                return ERR_INVALID_RELOCATION;
            } else {
                return host_linker_patch_u32(section_index, offset, patched_tlsld_ldlit);
            }
        }
        if reloc_type == R_AARCH64_TLSDESC_LD_PREL19 {
            let patched_tlsdesc_ldlit = aarch64_ld_prel_lo19_patch_word(instr, value);
            if patched_tlsdesc_ldlit == 0 {
                return ERR_INVALID_RELOCATION;
            } else {
                return host_linker_patch_u32(section_index, offset, patched_tlsdesc_ldlit);
            }
        }
        if reloc_type == R_AARCH64_TSTBR14 {
            let patched_tst = aarch64_tstbr14_patch_word(instr, value);
            if patched_tst == 0 {
                return ERR_INVALID_RELOCATION;
            } else {
                return host_linker_patch_u32(section_index, offset, patched_tst);
            }
        }
        if reloc_type == R_AARCH64_ADR_PREL_LO21 {
            let patched_adr = aarch64_adr_prel_lo21_patch_word(instr, value);
            if patched_adr == 0 {
                return ERR_INVALID_RELOCATION;
            } else {
                return host_linker_patch_u32(section_index, offset, patched_adr);
            }
        }
        if reloc_type == R_AARCH64_TLSGD_ADR_PREL21 {
            let patched_tlsgd_adr = aarch64_adr_prel_lo21_patch_word(instr, value);
            if patched_tlsgd_adr == 0 {
                return ERR_INVALID_RELOCATION;
            } else {
                return host_linker_patch_u32(section_index, offset, patched_tlsgd_adr);
            }
        }
        if reloc_type == R_AARCH64_TLSLD_ADR_PREL21 {
            let patched_tlsld_adr = aarch64_adr_prel_lo21_patch_word(instr, value);
            if patched_tlsld_adr == 0 {
                return ERR_INVALID_RELOCATION;
            } else {
                return host_linker_patch_u32(section_index, offset, patched_tlsld_adr);
            }
        }
        if reloc_type == R_AARCH64_TLSDESC_ADR_PREL21 {
            let patched_tlsdesc_adr = aarch64_adr_prel_lo21_patch_word(instr, value);
            if patched_tlsdesc_adr == 0 {
                return ERR_INVALID_RELOCATION;
            } else {
