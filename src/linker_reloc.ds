    proc K::is_signed_32_reloc_x86_64(reloc_type: UInt32) -> UInt32 {
        if reloc_type == R_X86_64_PC32 {
            return 1;
        } else {
            if reloc_type == R_X86_64_32S {
                return 1;
            } else {
                if reloc_type == R_X86_64_PLT32 {
                    return 1;
                } else {
                    if reloc_type == R_X86_64_GOTPCREL {
                        return 1;
                    } else {
                        if reloc_type == R_X86_64_GOTPCRELX {
                            return 1;
                        } else {
                            if reloc_type == R_X86_64_REX_GOTPCRELX {
                                return 1;
                            } else {
                                return 0;
                            }
                        }
                    }
                }
            }
        }
    }

    proc K::validate_relocation_value(reloc_type: UInt32, machine: UInt16, value: UInt64) -> UInt32 {
        if machine == EM_X86_64 {
            if reloc_type == R_X86_64_64 {
                return ERR_OK;
            } else {
                if reloc_type == R_X86_64_PC64 {
                    return ERR_OK;
                } else {
                    if reloc_type == R_X86_64_GLOB_DAT {
                        return ERR_OK;
                    } else {
                        if reloc_type == R_X86_64_JUMP_SLOT {
                            return ERR_OK;
                        } else {
                            if reloc_type == R_X86_64_RELATIVE {
                                return ERR_OK;
                            } else {
                                if is_signed_32_reloc_x86_64(reloc_type) == 1 {
                                    if fits_s32(value) == 1 {
                                        return ERR_OK;
                                    } else {
                                        return ERR_INVALID_RELOCATION;
                                    }
                                }
                            }
                        }
                    }
                }
                if fits_u32(value) == 1 {
                    return ERR_OK;
                } else {
                    return ERR_INVALID_RELOCATION;
                }
            }
        }

        if machine == EM_AARCH64 {
            if reloc_type == R_AARCH64_ABS64 {
                return ERR_OK;
            } else {
                if reloc_type == R_AARCH64_PREL64 {
                    return ERR_OK;
                } else {
                    if reloc_type == R_AARCH64_TLS_DTPMOD {
                        return ERR_OK;
                    }
                    if reloc_type == R_AARCH64_TLS_DTPREL {
                        return ERR_OK;
                    }
                    if reloc_type == R_AARCH64_TLS_TPREL {
                        return ERR_OK;
                    }
                    if aarch64_is_instr_reloc(reloc_type) == 1 {
                        if reloc_type == R_AARCH64_TSTBR14 {
                            if fits_s16(value) == 0 { return ERR_INVALID_RELOCATION; }
                            if (value & 3) ! 0 { return ERR_INVALID_RELOCATION; }
                            return ERR_OK;
                        }
                        if reloc_type == R_AARCH64_CONDBR19 {
                            if fits_s21(value) == 0 { return ERR_INVALID_RELOCATION; }
                            if (value & 3) ! 0 { return ERR_INVALID_RELOCATION; }
                            return ERR_OK;
                        }
                        if reloc_type == R_AARCH64_LD_PREL_LO19 {
                            if fits_s21(value) == 0 { return ERR_INVALID_RELOCATION; }
                            if (value & 3) ! 0 { return ERR_INVALID_RELOCATION; }
                            return ERR_OK;
                        }
                        if reloc_type == R_AARCH64_TLSLD_LD_PREL19 {
                            if fits_s21(value) == 0 { return ERR_INVALID_RELOCATION; }
                            if (value & 3) ! 0 { return ERR_INVALID_RELOCATION; }
                            return ERR_OK;
                        }
                        if reloc_type == R_AARCH64_TLSDESC_LD_PREL19 {
                            if fits_s21(value) == 0 { return ERR_INVALID_RELOCATION; }
                            if (value & 3) ! 0 { return ERR_INVALID_RELOCATION; }
                            return ERR_OK;
                        }
                        if reloc_type == R_AARCH64_ADR_PREL_LO21 {
                            if fits_s21(value) == 0 { return ERR_INVALID_RELOCATION; }
                            return ERR_OK;
                        }
                        if reloc_type == R_AARCH64_TLSGD_ADR_PREL21 {
                            if fits_s21(value) == 0 { return ERR_INVALID_RELOCATION; }
                            return ERR_OK;
                        }
                        if reloc_type == R_AARCH64_TLSLD_ADR_PREL21 {
                            if fits_s21(value) == 0 { return ERR_INVALID_RELOCATION; }
                            return ERR_OK;
                        }
                        if reloc_type == R_AARCH64_TLSDESC_ADR_PREL21 {
                            if fits_s21(value) == 0 { return ERR_INVALID_RELOCATION; }
                            return ERR_OK;
                        }
                        if aarch64_movw_checked_value(reloc_type, value) == 1 {
                            return ERR_OK;
                        }
                        if aarch64_movw_reloc_class(reloc_type) ! 0 {
                            return ERR_INVALID_RELOCATION;
                        }
                        return ERR_OK;
                    }
                    if reloc_type == R_AARCH64_PREL32 {
                        if fits_s32(value) == 1 {
                            return ERR_OK;
                        } else {
                            return ERR_INVALID_RELOCATION;
                        }
                    }
                }
                if fits_u32(value) == 1 {
                    return ERR_OK;
                } else {
                    return ERR_INVALID_RELOCATION;
                }
            }
        }

        if fits_u32(value) == 1 {
            return ERR_OK;
        } else {
            return ERR_INVALID_RELOCATION;
        }
    }

    proc K::validate_relocation_record(
        section: UInt32,
        offset: UInt64,
        sym_idx: UInt32,
        reloc_type: UInt32,
        machine: UInt16,
        section_size: UInt64,
        symbol_count: UInt32
    ) -> UInt32 {
        if section >= MAX_SECTION_INDEX {
            return ERR_INVALID_SECTION;
        } else {
            if sym_idx >= symbol_count {
                return ERR_UNDEFINED_SYMBOL;
            } else {
                if is_supported_reloc(reloc_type, machine) == 0 {
                    return ERR_INVALID_RELOCATION;
                } else {
                    let width = reloc_write_width(reloc_type, machine);
                    if width == 0 {
                        return ERR_INVALID_RELOCATION;
                    } else {
                        if offset >= section_size {
                            return ERR_INVALID_RELOCATION;
                        } else {
                            if offset + width > section_size {
                                return ERR_INVALID_RELOCATION;
                            } else {
                                return ERR_OK;
                            }
                        }
                    }
                }
            }
        }
    }

    proc K::calculate_pcrel_offset(reloc: UInt64, sym_addr: UInt64, offset: UInt64) -> UInt64 {
        let site = reloc + offset;
        if sym_addr >= site {
            return sym_addr - site;
        } else {
            let backwards = site - sym_addr;
            return 0 - backwards;
        }
    }

    proc K::calc_relocation_value(
        reloc_type: UInt32,
        machine: UInt16,
        symbol_addr: UInt64,
        addend: UInt64,
        place_addr: UInt64
    ) -> UInt64 {
        if machine == EM_AARCH64 {
            let arm_sum = symbol_addr + addend;
            if reloc_type == R_AARCH64_NONE { return 0; }
            if reloc_type == R_AARCH64_ABS64 { return arm_sum; }
            if reloc_type == R_AARCH64_ABS32 { return arm_sum; }
            if reloc_type == R_AARCH64_PREL64 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_PREL32 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_LD_PREL_LO19 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_TLSLD_LD_PREL19 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_TLSDESC_LD_PREL19 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_ADR_PREL_LO21 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_TLSGD_ADR_PREL21 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_TLSLD_ADR_PREL21 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_TLSDESC_ADR_PREL21 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_TSTBR14 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_CONDBR19 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_JUMP26 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_CALL26 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_MOVW_UABS_G0 { return arm_sum; }
            if reloc_type == R_AARCH64_MOVW_UABS_G0_NC { return arm_sum; }
            if reloc_type == R_AARCH64_MOVW_UABS_G1 { return arm_sum; }
            if reloc_type == R_AARCH64_MOVW_UABS_G1_NC { return arm_sum; }
            if reloc_type == R_AARCH64_MOVW_UABS_G2 { return arm_sum; }
            if reloc_type == R_AARCH64_MOVW_UABS_G2_NC { return arm_sum; }
            if reloc_type == R_AARCH64_MOVW_UABS_G3 { return arm_sum; }
            if reloc_type == R_AARCH64_MOVW_SABS_G0 { return arm_sum; }
            if reloc_type == R_AARCH64_MOVW_SABS_G1 { return arm_sum; }
            if reloc_type == R_AARCH64_MOVW_SABS_G2 { return arm_sum; }
            if reloc_type == R_AARCH64_MOVW_PREL_G0 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_MOVW_PREL_G0_NC { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_MOVW_PREL_G1 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_MOVW_PREL_G1_NC { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_MOVW_PREL_G2 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_MOVW_PREL_G2_NC { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_MOVW_PREL_G3 { return calculate_pcrel_offset(place_addr, arm_sum, 0); }
            if reloc_type == R_AARCH64_TLSGD_MOVW_G1 { return arm_sum; }
            if reloc_type == R_AARCH64_TLSGD_MOVW_G0_NC { return arm_sum; }
            if reloc_type == R_AARCH64_TLSLD_MOVW_G1 { return arm_sum; }
            if reloc_type == R_AARCH64_TLSLD_MOVW_G0_NC { return arm_sum; }
            if reloc_type == R_AARCH64_ADR_PREL_PG_HI21 { return aarch64_page_delta_bytes(arm_sum, place_addr); }
            if reloc_type == R_AARCH64_ADR_PREL_PG_HI21_NC { return aarch64_page_delta_bytes(arm_sum, place_addr); }
            if reloc_type == R_AARCH64_TLSGD_ADR_PAGE21 { return aarch64_page_delta_bytes(arm_sum, place_addr); }
            if reloc_type == R_AARCH64_TLSLD_ADR_PAGE21 { return aarch64_page_delta_bytes(arm_sum, place_addr); }
            if reloc_type == R_AARCH64_TLSDESC_ADR_PAGE21 { return aarch64_page_delta_bytes(arm_sum, place_addr); }
            if reloc_type == R_AARCH64_ADD_ABS_LO12_NC { return arm_sum; }
            if reloc_type == R_AARCH64_TLSGD_ADD_LO12_NC { return arm_sum; }
            if reloc_type == R_AARCH64_TLSLD_ADD_LO12_NC { return arm_sum; }
            if reloc_type == R_AARCH64_TLSLD_ADD_DTPREL_LO12_NC { return arm_sum; }
            if reloc_type == R_AARCH64_TLSLE_ADD_TPREL_LO12_NC { return arm_sum; }
            if reloc_type == R_AARCH64_TLSDESC_ADD_LO12 { return arm_sum; }
            if reloc_type == R_AARCH64_LDST8_ABS_LO12_NC { return arm_sum; }
            if reloc_type == R_AARCH64_LDST16_ABS_LO12_NC { return arm_sum; }
            if reloc_type == R_AARCH64_LDST32_ABS_LO12_NC { return arm_sum; }
            if reloc_type == R_AARCH64_LDST64_ABS_LO12_NC { return arm_sum; }
            if reloc_type == R_AARCH64_LDST128_ABS_LO12_NC { return arm_sum; }
            if reloc_type == R_AARCH64_TLSLD_LDST64_DTPREL_LO12_NC { return arm_sum; }
            if reloc_type == R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC { return arm_sum; }
            if reloc_type == R_AARCH64_TLSDESC_LD64_LO12 { return arm_sum; }
            if reloc_type == R_AARCH64_TLSLE_LDST128_TPREL_LO12_NC { return arm_sum; }
            if reloc_type == R_AARCH64_TLSLD_LDST128_DTPREL_LO12_NC { return arm_sum; }
            if reloc_type == R_AARCH64_TLSDESC_CALL { return 0; }
            if reloc_type == R_AARCH64_TLS_DTPMOD { return 1; }
            if reloc_type == R_AARCH64_TLS_DTPREL { return arm_sum; }
            if reloc_type == R_AARCH64_TLS_TPREL { return arm_sum; }
            return 0;
        }

        if reloc_type == R_X86_64_NONE {
            return 0;
        } else {
            let sum = symbol_addr + addend;
            if reloc_type == R_X86_64_64 { return sum; }
            if reloc_type == R_X86_64_PC32 { return calculate_pcrel_offset(place_addr, sum, 0); }
            if reloc_type == R_X86_64_32 { return sum; }
            if reloc_type == R_X86_64_32S { return sum; }
            if reloc_type == R_X86_64_PC64 { return calculate_pcrel_offset(place_addr, sum, 0); }
            if reloc_type == R_X86_64_PLT32 { return calculate_pcrel_offset(place_addr, sum, 0); }
            if reloc_type == R_X86_64_GLOB_DAT { return sum; }
            if reloc_type == R_X86_64_JUMP_SLOT { return sum; }
            if reloc_type == R_X86_64_RELATIVE { return host_linker_get_image_base() + addend; }
            if reloc_type == R_X86_64_GOTPCREL { return calculate_pcrel_offset(place_addr, sum, 0); }
            if reloc_type == R_X86_64_GOTPCRELX { return calculate_pcrel_offset(place_addr, sum, 0); }
            if reloc_type == R_X86_64_REX_GOTPCRELX { return calculate_pcrel_offset(place_addr, sum, 0); }
            return 0;
        }
    }

    proc K::apply_relocation_value(
        section_index: UInt32,
        offset: UInt64,
        reloc_type: UInt32,
        machine: UInt16,
        value: UInt64
    ) -> UInt32 {
        let value_status = validate_relocation_value(reloc_type, machine, value);
        if value_status ! ERR_OK {
            return value_status;
        } else {
            if machine == EM_AARCH64 {
                if aarch64_is_instr_reloc(reloc_type) == 1 {
                    return apply_aarch64_instruction_relocation(section_index, offset, reloc_type, value);
                }
                if reloc_type == R_AARCH64_ABS64 { return host_linker_patch_u64(section_index, offset, value); }
                if reloc_type == R_AARCH64_PREL64 { return host_linker_patch_u64(section_index, offset, value); }
                return host_linker_patch_u32(section_index, offset, value);
            }
            if reloc_type == R_X86_64_64 { return host_linker_patch_u64(section_index, offset, value); }
            if reloc_type == R_X86_64_PC64 { return host_linker_patch_u64(section_index, offset, value); }
            if reloc_type == R_X86_64_GLOB_DAT { return host_linker_patch_u64(section_index, offset, value); }
            if reloc_type == R_X86_64_JUMP_SLOT { return host_linker_patch_u64(section_index, offset, value); }
            if reloc_type == R_X86_64_RELATIVE { return host_linker_patch_u64(section_index, offset, value); }
            return host_linker_patch_u32(section_index, offset, value);
        }
    }

    proc K::apply_relocation_slot(
        object_index: UInt32,
        reloc_index: UInt32
    ) -> UInt32 {
        let machine = host_linker_object_machine(object_index);
        let target_section = host_linker_object_relocation_section(object_index, reloc_index);
        let offset = host_linker_object_relocation_offset(object_index, reloc_index);
        let reloc_type = host_linker_object_relocation_type(object_index, reloc_index);
        let sym_index = host_linker_object_relocation_symbol(object_index, reloc_index);
        let addend = host_linker_object_relocation_addend(object_index, reloc_index);

        let section_size = host_linker_object_section_size(object_index, target_section);
        let symbol_count = host_linker_object_symbol_count(object_index);
        let validate_status = validate_relocation_record(
            target_section,
            offset,
            sym_index,
            reloc_type,
            machine,
            section_size,
            symbol_count
        );
        if validate_status ! ERR_OK {
            return validate_status;
        } else {
            let symbol_defined = host_linker_object_symbol_defined(object_index, sym_index);
            let symbol_addr = host_linker_resolved_symbol_address(object_index, sym_index);
            if machine == EM_AARCH64 {
                if aarch64_is_tls_family_reloc(reloc_type) == 1 {
                    // AArch64 TLS relocations require TLS block/layout/module metadata not yet surfaced
                    // through the current Dust host linker runtime ABI.
                    return ERR_NOT_IMPLEMENTED_YET;
                }
            }
            if symbol_defined == 0 {
                if symbol_addr == 0 {
                    if is_dynamic_placeholder_reloc(reloc_type, machine) == 1 {
                        if host_linker_allow_dynamic_unresolved() == 1 {
                            return apply_relocation_value(target_section, offset, reloc_type, machine, 0);
                        }
                    }
                    return ERR_UNDEFINED_SYMBOL;
                }
            }
            let place = host_linker_section_runtime_address(object_index, target_section) + offset;
            let value = calc_relocation_value(reloc_type, machine, symbol_addr, addend, place);
            return apply_relocation_value(target_section, offset, reloc_type, machine, value);
        }
    }

    proc K::apply_object_relocations(
        object_index: UInt32,
        reloc_index: UInt32,
        reloc_count: UInt32
    ) -> UInt32 {
        if reloc_index >= reloc_count {
            return ERR_OK;
        } else {
            let slot_status = apply_relocation_slot(object_index, reloc_index);
            if slot_status ! ERR_OK {
                return slot_status;
            } else {
                return apply_object_relocations(object_index, reloc_index + 1, reloc_count);
            }
        }
    }

    proc K::apply_all_relocations(
        object_index: UInt32,
        object_count: UInt32
    ) -> UInt32 {
        if object_index >= object_count {
            return ERR_OK;
        } else {
            let reloc_count = host_linker_object_relocation_count(object_index);
            let object_status = apply_object_relocations(object_index, 0, reloc_count);
            if object_status ! ERR_OK {
                return object_status;
            } else {
                return apply_all_relocations(object_index + 1, object_count);
            }
        }
    }

    proc K::process_relocations(section: UInt64, relocs: UInt64, symbols: UInt64, data: UInt64) -> UInt32 {
        if section == 0 {
            return ERR_INVALID_SECTION;
        } else {
            if relocs == 0 {
                return ERR_OK;
            } else {
                if symbols == 0 {
                    return ERR_UNDEFINED_SYMBOL;
                } else {
                    if data == 0 {
                        return ERR_INVALID_RELOCATION;
                    } else {
                        let object_count = host_linker_object_count();
                        return apply_all_relocations(0, object_count);
                    }
                }
            }
        }
    }

    proc K::resolve_reloc_address(reloc: UInt64, sym_addr: UInt64, base_addr: UInt64) -> UInt64 {
        if sym_addr < base_addr {
            return reloc;
        } else {
            return reloc + (sym_addr - base_addr);
        }
    }
}
