    proc K::is_supported_reloc_x86_64(reloc_type: UInt32) -> UInt32 {
        if reloc_type == R_X86_64_NONE { return 1; }
        if reloc_type == R_X86_64_64 { return 1; }
        if reloc_type == R_X86_64_PC32 { return 1; }
        if reloc_type == R_X86_64_32 { return 1; }
        if reloc_type == R_X86_64_32S { return 1; }
        if reloc_type == R_X86_64_PLT32 { return 1; }
        if reloc_type == R_X86_64_GLOB_DAT { return 1; }
        if reloc_type == R_X86_64_JUMP_SLOT { return 1; }
        if reloc_type == R_X86_64_RELATIVE { return 1; }
        if reloc_type == R_X86_64_GOTPCREL { return 1; }
        if reloc_type == R_X86_64_PC64 { return 1; }
        if reloc_type == R_X86_64_GOTPCRELX { return 1; }
        if reloc_type == R_X86_64_REX_GOTPCRELX { return 1; }
        return 0;
    }

    proc K::is_supported_reloc_aarch64(reloc_type: UInt32) -> UInt32 {
