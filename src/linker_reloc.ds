        if reloc_type == R_AARCH64_TLSLD_LDST64_DTPREL_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_TLSLE_ADD_TPREL_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_TLSDESC_LD_PREL19 { return 1; }
        if reloc_type == R_AARCH64_TLSDESC_ADR_PREL21 { return 1; }
        if reloc_type == R_AARCH64_TLSDESC_ADR_PAGE21 { return 1; }
        if reloc_type == R_AARCH64_TLSDESC_LD64_LO12 { return 1; }
        if reloc_type == R_AARCH64_TLSDESC_ADD_LO12 { return 1; }
        if reloc_type == R_AARCH64_TLSDESC_CALL { return 1; }
        if reloc_type == R_AARCH64_TLSLE_LDST128_TPREL_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_TLSLD_LDST128_DTPREL_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_TLS_DTPMOD { return 1; }
        if reloc_type == R_AARCH64_TLS_DTPREL { return 1; }
        if reloc_type == R_AARCH64_TLS_TPREL { return 1; }
        if reloc_type == R_AARCH64_TSTBR14 { return 1; }
        if reloc_type == R_AARCH64_CONDBR19 { return 1; }
        if reloc_type == R_AARCH64_JUMP26 { return 1; }
        if reloc_type == R_AARCH64_CALL26 { return 1; }
        return 0;
    }

    proc K::is_supported_reloc(reloc_type: UInt32, machine: UInt16) -> UInt32 {
        if machine == EM_X86_64 {
            return is_supported_reloc_x86_64(reloc_type);
        } else {
            if machine == EM_AARCH64 {
                return is_supported_reloc_aarch64(reloc_type);
            } else {
                return 0;
            }
        }
    }

    proc K::reloc_write_width_x86_64(reloc_type: UInt32) -> UInt32 {
        if reloc_type == R_X86_64_64 { return 8; }
        if reloc_type == R_X86_64_GLOB_DAT { return 8; }
        if reloc_type == R_X86_64_JUMP_SLOT { return 8; }
        if reloc_type == R_X86_64_RELATIVE { return 8; }
        if reloc_type == R_X86_64_PC64 { return 8; }
        if reloc_type == R_X86_64_PC32 { return 4; }
        if reloc_type == R_X86_64_32 { return 4; }
        if reloc_type == R_X86_64_32S { return 4; }
        if reloc_type == R_X86_64_PLT32 { return 4; }
        if reloc_type == R_X86_64_GOTPCREL { return 4; }
        if reloc_type == R_X86_64_GOTPCRELX { return 4; }
        if reloc_type == R_X86_64_REX_GOTPCRELX { return 4; }
        return 0;
    }

    proc K::reloc_write_width_aarch64(reloc_type: UInt32) -> UInt32 {
        if reloc_type == R_AARCH64_ABS64 { return 8; }
        if reloc_type == R_AARCH64_PREL64 { return 8; }
        if reloc_type == R_AARCH64_TLS_DTPMOD { return 8; }
        if reloc_type == R_AARCH64_TLS_DTPREL { return 8; }
        if reloc_type == R_AARCH64_TLS_TPREL { return 8; }
        if reloc_type == R_AARCH64_ABS32 { return 4; }
        if reloc_type == R_AARCH64_PREL32 { return 4; }
        if reloc_type == R_AARCH64_MOVW_UABS_G0 { return 4; }
        if reloc_type == R_AARCH64_MOVW_UABS_G0_NC { return 4; }
        if reloc_type == R_AARCH64_MOVW_UABS_G1 { return 4; }
        if reloc_type == R_AARCH64_MOVW_UABS_G1_NC { return 4; }
        if reloc_type == R_AARCH64_MOVW_UABS_G2 { return 4; }
        if reloc_type == R_AARCH64_MOVW_UABS_G2_NC { return 4; }
        if reloc_type == R_AARCH64_MOVW_UABS_G3 { return 4; }
        if reloc_type == R_AARCH64_MOVW_SABS_G0 { return 4; }
        if reloc_type == R_AARCH64_MOVW_SABS_G1 { return 4; }
        if reloc_type == R_AARCH64_MOVW_SABS_G2 { return 4; }
        if reloc_type == R_AARCH64_LD_PREL_LO19 { return 4; }
        if reloc_type == R_AARCH64_ADR_PREL_LO21 { return 4; }
        if reloc_type == R_AARCH64_ADR_PREL_PG_HI21 { return 4; }
        if reloc_type == R_AARCH64_ADR_PREL_PG_HI21_NC { return 4; }
        if reloc_type == R_AARCH64_ADD_ABS_LO12_NC { return 4; }
        if reloc_type == R_AARCH64_LDST8_ABS_LO12_NC { return 4; }
        if reloc_type == R_AARCH64_LDST16_ABS_LO12_NC { return 4; }
        if reloc_type == R_AARCH64_LDST32_ABS_LO12_NC { return 4; }
        if reloc_type == R_AARCH64_LDST64_ABS_LO12_NC { return 4; }
        if reloc_type == R_AARCH64_MOVW_PREL_G0 { return 4; }
        if reloc_type == R_AARCH64_MOVW_PREL_G0_NC { return 4; }
        if reloc_type == R_AARCH64_MOVW_PREL_G1 { return 4; }
        if reloc_type == R_AARCH64_MOVW_PREL_G1_NC { return 4; }
        if reloc_type == R_AARCH64_MOVW_PREL_G2 { return 4; }
        if reloc_type == R_AARCH64_MOVW_PREL_G2_NC { return 4; }
        if reloc_type == R_AARCH64_MOVW_PREL_G3 { return 4; }
        if reloc_type == R_AARCH64_LDST128_ABS_LO12_NC { return 4; }
        if reloc_type == R_AARCH64_TLSGD_ADR_PREL21 { return 4; }
        if reloc_type == R_AARCH64_TLSGD_ADR_PAGE21 { return 4; }
        if reloc_type == R_AARCH64_TLSGD_ADD_LO12_NC { return 4; }
        if reloc_type == R_AARCH64_TLSGD_MOVW_G1 { return 4; }
        if reloc_type == R_AARCH64_TLSGD_MOVW_G0_NC { return 4; }
        if reloc_type == R_AARCH64_TLSLD_ADR_PREL21 { return 4; }
        if reloc_type == R_AARCH64_TLSLD_ADR_PAGE21 { return 4; }
        if reloc_type == R_AARCH64_TLSLD_ADD_LO12_NC { return 4; }
        if reloc_type == R_AARCH64_TLSLD_MOVW_G1 { return 4; }
        if reloc_type == R_AARCH64_TLSLD_MOVW_G0_NC { return 4; }
        if reloc_type == R_AARCH64_TLSLD_LD_PREL19 { return 4; }
        if reloc_type == R_AARCH64_TLSLD_ADD_DTPREL_LO12_NC { return 4; }
        if reloc_type == R_AARCH64_TLSLD_LDST64_DTPREL_LO12_NC { return 4; }
        if reloc_type == R_AARCH64_TLSLE_ADD_TPREL_LO12_NC { return 4; }
        if reloc_type == R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC { return 4; }
        if reloc_type == R_AARCH64_TLSDESC_LD_PREL19 { return 4; }
        if reloc_type == R_AARCH64_TLSDESC_ADR_PREL21 { return 4; }
        if reloc_type == R_AARCH64_TLSDESC_ADR_PAGE21 { return 4; }
        if reloc_type == R_AARCH64_TLSDESC_LD64_LO12 { return 4; }
        if reloc_type == R_AARCH64_TLSDESC_ADD_LO12 { return 4; }
        if reloc_type == R_AARCH64_TLSDESC_CALL { return 4; }
        if reloc_type == R_AARCH64_TLSLE_LDST128_TPREL_LO12_NC { return 4; }
        if reloc_type == R_AARCH64_TLSLD_LDST128_DTPREL_LO12_NC { return 4; }
        if reloc_type == R_AARCH64_TSTBR14 { return 4; }
        if reloc_type == R_AARCH64_CONDBR19 { return 4; }
        if reloc_type == R_AARCH64_JUMP26 { return 4; }
        if reloc_type == R_AARCH64_CALL26 { return 4; }
        if reloc_type == R_AARCH64_NONE { return 4; }
        return 0;
    }

    proc K::reloc_write_width(reloc_type: UInt32, machine: UInt16) -> UInt32 {
        if machine == EM_X86_64 {
            return reloc_write_width_x86_64(reloc_type);
        } else {
            if machine == EM_AARCH64 {
                return reloc_write_width_aarch64(reloc_type);
            } else {
                return 0;
            }
        }
    }

    proc K::is_dynamic_placeholder_reloc(reloc_type: UInt32, machine: UInt16) -> UInt32 {
        if machine == EM_AARCH64 {
            if reloc_type == R_AARCH64_TLS_DTPMOD { return 1; }
            if reloc_type == R_AARCH64_TLS_DTPREL { return 1; }
            if reloc_type == R_AARCH64_TLS_TPREL { return 1; }
            return 0;
        }
        if reloc_type == R_X86_64_PLT32 {
            return 1;
        } else {
            if reloc_type == R_X86_64_GLOB_DAT {
                return 1;
            } else {
                if reloc_type == R_X86_64_JUMP_SLOT {
                    return 1;
                } else {
                    if reloc_type == R_X86_64_GOTPCREL {
                        return 1;
                    } else {
                        if reloc_type == R_X86_64_GOTPCRELX {
                            return 1;
                        } else {
                            if reloc_type == R_X86_64_REX_GOTPCRELX {
                                return 1;
                            } else {
                                return 0;
                            }
                        }
                    }
                }
            }
        }
    }

    proc K::fits_u32(value: UInt64) -> UInt32 {
        if value > 4294967295 {
            return 0;
        } else {
            return 1;
        }
    }

    proc K::fits_u16(value: UInt64) -> UInt32 {
        if value > 65535 {
            return 0;
        } else {
            return 1;
        }
    }

    proc K::fits_u48(value: UInt64) -> UInt32 {
        if value > 281474976710655 {
            return 0;
        } else {
            return 1;
        }
    }

    proc K::fits_s32(value: UInt64) -> UInt32 {
        if value <= 2147483647 {
            return 1;
        } else {
            if value >= (0 - 2147483648) {
                return 1;
            } else {
                return 0;
            }
        }
    }

    proc K::fits_s28(value: UInt64) -> UInt32 {
        if value <= 134217727 {
            return 1;
        } else {
            if value >= (0 - 134217728) {
                return 1;
            } else {
                return 0;
            }
        }
    }

    proc K::fits_s33(value: UInt64) -> UInt32 {
        if value <= 4294967295 {
            return 1;
        } else {
            if value >= (0 - 4294967296) {
                return 1;
            } else {
                return 0;
            }
        }
    }

    proc K::fits_s48(value: UInt64) -> UInt32 {
        if value <= 140737488355327 {
            return 1;
        } else {
            if value >= (0 - 140737488355328) {
                return 1;
            } else {
                return 0;
            }
        }
    }

    proc K::fits_s21(value: UInt64) -> UInt32 {
        if value <= 1048575 {
            return 1;
        } else {
            if value >= (0 - 1048576) {
                return 1;
            } else {
                return 0;
            }
        }
    }

    proc K::fits_s16(value: UInt64) -> UInt32 {
        if value <= 32767 {
            return 1;
        } else {
            if value >= (0 - 32768) {
                return 1;
            } else {
                return 0;
            }
        }
    }

    proc K::aarch64_is_instr_reloc(reloc_type: UInt32) -> UInt32 {
        if reloc_type == R_AARCH64_MOVW_UABS_G0 { return 1; }
        if reloc_type == R_AARCH64_MOVW_UABS_G0_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_UABS_G1 { return 1; }
        if reloc_type == R_AARCH64_MOVW_UABS_G1_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_UABS_G2 { return 1; }
        if reloc_type == R_AARCH64_MOVW_UABS_G2_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_UABS_G3 { return 1; }
        if reloc_type == R_AARCH64_MOVW_SABS_G0 { return 1; }
        if reloc_type == R_AARCH64_MOVW_SABS_G1 { return 1; }
        if reloc_type == R_AARCH64_MOVW_SABS_G2 { return 1; }
        if reloc_type == R_AARCH64_ADR_PREL_PG_HI21 { return 1; }
        if reloc_type == R_AARCH64_ADR_PREL_PG_HI21_NC { return 1; }
        if reloc_type == R_AARCH64_ADR_PREL_LO21 { return 1; }
        if reloc_type == R_AARCH64_ADD_ABS_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_PREL_G0 { return 1; }
        if reloc_type == R_AARCH64_MOVW_PREL_G0_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_PREL_G1 { return 1; }
        if reloc_type == R_AARCH64_MOVW_PREL_G1_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_PREL_G2 { return 1; }
        if reloc_type == R_AARCH64_MOVW_PREL_G2_NC { return 1; }
        if reloc_type == R_AARCH64_MOVW_PREL_G3 { return 1; }
        if reloc_type == R_AARCH64_LDST8_ABS_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_LDST16_ABS_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_LDST32_ABS_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_LDST64_ABS_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_LDST128_ABS_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_TLSGD_ADR_PREL21 { return 1; }
        if reloc_type == R_AARCH64_TLSGD_ADR_PAGE21 { return 1; }
        if reloc_type == R_AARCH64_TLSGD_ADD_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_TLSGD_MOVW_G1 { return 1; }
        if reloc_type == R_AARCH64_TLSGD_MOVW_G0_NC { return 1; }
        if reloc_type == R_AARCH64_TLSLD_ADR_PREL21 { return 1; }
        if reloc_type == R_AARCH64_TLSLD_ADR_PAGE21 { return 1; }
        if reloc_type == R_AARCH64_TLSLD_ADD_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_TLSLD_MOVW_G1 { return 1; }
        if reloc_type == R_AARCH64_TLSLD_MOVW_G0_NC { return 1; }
        if reloc_type == R_AARCH64_TLSLD_LD_PREL19 { return 1; }
        if reloc_type == R_AARCH64_TLSLD_ADD_DTPREL_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_TLSLD_LDST64_DTPREL_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_TLSLE_ADD_TPREL_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_TLSDESC_LD_PREL19 { return 1; }
        if reloc_type == R_AARCH64_TLSDESC_ADR_PREL21 { return 1; }
        if reloc_type == R_AARCH64_TLSDESC_ADR_PAGE21 { return 1; }
        if reloc_type == R_AARCH64_TLSDESC_LD64_LO12 { return 1; }
        if reloc_type == R_AARCH64_TLSDESC_ADD_LO12 { return 1; }
        if reloc_type == R_AARCH64_TLSDESC_CALL { return 1; }
        if reloc_type == R_AARCH64_TLSLE_LDST128_TPREL_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_TLSLD_LDST128_DTPREL_LO12_NC { return 1; }
        if reloc_type == R_AARCH64_TSTBR14 { return 1; }
        if reloc_type == R_AARCH64_CONDBR19 { return 1; }
        if reloc_type == R_AARCH64_JUMP26 { return 1; }
        if reloc_type == R_AARCH64_CALL26 { return 1; }
        return 0;
    }

    proc K::aarch64_is_tls_family_reloc(reloc_type: UInt32) -> UInt32 {
        if reloc_type == R_AARCH64_TLSGD_ADR_PREL21 { return 1; }
        if reloc_type == R_AARCH64_TLSGD_ADR_PAGE21 { return 1; }
        if reloc_type == R_AARCH64_TLSGD_ADD_LO12_NC { return 1; }
