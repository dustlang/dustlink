// Relocation parsing and deterministic patch planning helpers.

forge LinkerReloc {
    const MAX_RELOCATIONS: UInt32 = 131072;
    const MAX_SECTION_INDEX: UInt32 = 4096;

    const R_X86_64_NONE: UInt32 = 0;
    const R_X86_64_64: UInt32 = 1;
    const R_X86_64_PC32: UInt32 = 2;
    const R_X86_64_32: UInt32 = 10;
    const R_X86_64_32S: UInt32 = 11;

    const ERR_OK: UInt32 = 0;
    const ERR_INVALID_SECTION: UInt32 = 3;
    const ERR_UNDEFINED_SYMBOL: UInt32 = 4;
    const ERR_INVALID_RELOCATION: UInt32 = 6;

    proc K::is_supported_reloc(reloc_type: UInt32) -> UInt32 {
        if reloc_type == R_X86_64_NONE {
            return 1;
        } else {
            if reloc_type == R_X86_64_64 {
                return 1;
            } else {
                if reloc_type == R_X86_64_PC32 {
                    return 1;
                } else {
                    if reloc_type == R_X86_64_32 {
                        return 1;
                    } else {
                        if reloc_type == R_X86_64_32S {
                            return 1;
                        } else {
                            return 0;
                        }
                    }
                }
            }
        }
    }

    proc K::reloc_write_width(reloc_type: UInt32) -> UInt32 {
        if reloc_type == R_X86_64_64 {
            return 8;
        } else {
            if reloc_type == R_X86_64_PC32 {
                return 4;
            } else {
                if reloc_type == R_X86_64_32 {
                    return 4;
                } else {
                    if reloc_type == R_X86_64_32S {
                        return 4;
                    } else {
                        return 0;
                    }
                }
            }
        }
    }

    proc K::fits_u32(value: UInt64) -> UInt32 {
        if value > 4294967295 {
            return 0;
        } else {
            return 1;
        }
    }

    proc K::validate_relocation_value(reloc_type: UInt32, value: UInt64) -> UInt32 {
        if reloc_type == R_X86_64_64 {
            return ERR_OK;
        } else {
            if fits_u32(value) == 1 {
                return ERR_OK;
            } else {
                return ERR_INVALID_RELOCATION;
            }
        }
    }

    proc K::validate_relocation_record(
        section: UInt32,
        offset: UInt64,
        sym_idx: UInt32,
        reloc_type: UInt32,
        section_size: UInt64,
        symbol_count: UInt32
    ) -> UInt32 {
        if section >= MAX_SECTION_INDEX {
            return ERR_INVALID_SECTION;
        } else {
            if sym_idx >= symbol_count {
                return ERR_UNDEFINED_SYMBOL;
            } else {
                if is_supported_reloc(reloc_type) == 0 {
                    return ERR_INVALID_RELOCATION;
                } else {
                    let width = reloc_write_width(reloc_type);
                    if width == 0 {
                        return ERR_INVALID_RELOCATION;
                    } else {
                        if offset >= section_size {
                            return ERR_INVALID_RELOCATION;
                        } else {
                            if offset + width > section_size {
                                return ERR_INVALID_RELOCATION;
                            } else {
                                return ERR_OK;
                            }
                        }
                    }
                }
            }
        }
    }

    proc K::calculate_pcrel_offset(reloc: UInt64, sym_addr: UInt64, offset: UInt64) -> UInt64 {
        let site = reloc + offset;
        if sym_addr >= site {
            return sym_addr - site;
        } else {
            let backwards = site - sym_addr;
            return 0 - backwards;
        }
    }

    proc K::calc_relocation_value(
        reloc_type: UInt32,
        symbol_addr: UInt64,
        addend: UInt64,
        place_addr: UInt64
    ) -> UInt64 {
        if reloc_type == R_X86_64_NONE {
            return 0;
        } else {
            let sum = symbol_addr + addend;
            if reloc_type == R_X86_64_64 {
                return sum;
            } else {
                if reloc_type == R_X86_64_PC32 {
                    return calculate_pcrel_offset(place_addr, sum, 0);
                } else {
                    if reloc_type == R_X86_64_32 {
                        return sum;
                    } else {
                        if reloc_type == R_X86_64_32S {
                            return sum;
                        } else {
                            return 0;
                        }
                    }
                }
            }
        }
    }

    proc K::apply_relocation_value(
        section_index: UInt32,
        offset: UInt64,
        reloc_type: UInt32,
        value: UInt64
    ) -> UInt32 {
        let value_status = validate_relocation_value(reloc_type, value);
        if value_status ! ERR_OK {
            return value_status;
        } else {
            if reloc_type == R_X86_64_64 {
                return host_linker_patch_u64(section_index, offset, value);
            } else {
                return host_linker_patch_u32(section_index, offset, value);
            }
        }
    }

    proc K::apply_relocation_slot(
        object_index: UInt32,
        reloc_index: UInt32
    ) -> UInt32 {
        let target_section = host_linker_object_relocation_section(object_index, reloc_index);
        let offset = host_linker_object_relocation_offset(object_index, reloc_index);
        let reloc_type = host_linker_object_relocation_type(object_index, reloc_index);
        let sym_index = host_linker_object_relocation_symbol(object_index, reloc_index);
        let addend = host_linker_object_relocation_addend(object_index, reloc_index);

        let section_size = host_linker_object_section_size(object_index, target_section);
        let symbol_count = host_linker_object_symbol_count(object_index);
        let validate_status = validate_relocation_record(
            target_section,
            offset,
            sym_index,
            reloc_type,
            section_size,
            symbol_count
        );
        if validate_status ! ERR_OK {
            return validate_status;
        } else {
            let symbol_addr = host_linker_resolved_symbol_address(object_index, sym_index);
            let place = host_linker_section_runtime_address(object_index, target_section) + offset;
            let value = calc_relocation_value(reloc_type, symbol_addr, addend, place);
            return apply_relocation_value(target_section, offset, reloc_type, value);
        }
    }

    proc K::apply_object_relocations(
        object_index: UInt32,
        reloc_index: UInt32,
        reloc_count: UInt32
    ) -> UInt32 {
        if reloc_index >= reloc_count {
            return ERR_OK;
        } else {
            let slot_status = apply_relocation_slot(object_index, reloc_index);
            if slot_status ! ERR_OK {
                return slot_status;
            } else {
                return apply_object_relocations(object_index, reloc_index + 1, reloc_count);
            }
        }
    }

    proc K::apply_all_relocations(
        object_index: UInt32,
        object_count: UInt32
    ) -> UInt32 {
        if object_index >= object_count {
            return ERR_OK;
        } else {
            let reloc_count = host_linker_object_relocation_count(object_index);
            let object_status = apply_object_relocations(object_index, 0, reloc_count);
            if object_status ! ERR_OK {
                return object_status;
            } else {
                return apply_all_relocations(object_index + 1, object_count);
            }
        }
    }

    proc K::process_relocations(section: UInt64, relocs: UInt64, symbols: UInt64, data: UInt64) -> UInt32 {
        if section == 0 {
            return ERR_INVALID_SECTION;
        } else {
            if relocs == 0 {
                return ERR_OK;
            } else {
                if symbols == 0 {
                    return ERR_UNDEFINED_SYMBOL;
                } else {
                    if data == 0 {
                        return ERR_INVALID_RELOCATION;
                    } else {
                        let object_count = host_linker_object_count();
                        return apply_all_relocations(0, object_count);
                    }
                }
            }
        }
    }

    proc K::resolve_reloc_address(reloc: UInt64, sym_addr: UInt64, base_addr: UInt64) -> UInt64 {
        if sym_addr < base_addr {
            return reloc;
        } else {
            return reloc + (sym_addr - base_addr);
        }
    }
}
