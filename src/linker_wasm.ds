// Copyright (c) 2026 Dust LLC, and Contributors
// Description:
//   WebAssembly output format support for DustLink.
//   Provides:
//     - WASM binary format constants
//     - WASM section types and structures
//     - WASM linking semantics
//     - Import/export function handling
//     - Memory/table globals support

forge LinkerWasm {
    const WASM_MAGIC: UInt32 = 1658768351;
    const WASM_VERSION: UInt32 = 1;

    const SECTION_CUSTOM: UInt8 = 0;
    const SECTION_TYPE: UInt8 = 1;
    const SECTION_IMPORT: UInt8 = 2;
    const SECTION_FUNCTION: UInt8 = 3;
    const SECTION_TABLE: UInt8 = 4;
    const SECTION_MEMORY: UInt8 = 5;
    const SECTION_GLOBAL: UInt8 = 6;
    const SECTION_EXPORT: UInt8 = 7;
    const SECTION_START: UInt8 = 8;
    const SECTION_ELEMENT: UInt8 = 9;
    const SECTION_CODE: UInt8 = 10;
    const SECTION_DATA: UInt8 = 11;
    const SECTION_DATA_COUNT: UInt8 = 12;

    const TYPE_FUNC: UInt8 = -96;
    const TYPE_TABLE: UInt8 = -95;
    const TYPE_MEMORY: UInt8 = -94;
    const TYPE_GLOBAL: UInt8 = -93;

    const FUNC_EXTERN_FUNC: UInt8 = 0;
    const FUNC_EXTERN_TABLE: UInt8 = 1;
    const FUNC_EXTERN_MEMORY: UInt8 = 2;
    const FUNC_EXTERN_GLOBAL: UInt8 = 3;

    const VAL_TYPE_I32: UInt8 = 127;
    const VAL_TYPE_I64: UInt8 = 126;
    const VAL_TYPE_F32: UInt8 = 125;
    const VAL_TYPE_F64: UInt8 = 124;
    const VAL_TYPE_V128: UInt8 = 123;
    const VAL_TYPE_FUNCREF: UInt8 = 112;
    const VAL_TYPE_EXTERNREF: UInt8 = 111;

    const LIMITS_FLAG_HAS_MAX: UInt8 = 1;
    const LIMITS_FLAG_SHARED: UInt8 = 2;

    const MEMORY_FLAG_NONE: UInt8 = 0;
    const MEMORY_FLAG_ALLOW_GROWTH: UInt8 = 1;
    const MEMORY_FLAG_IS_64: UInt8 = 2;

    const TABLE_TYPE_FUNCREF: UInt8 = 112;
    const TABLE_TYPE_EXTERNREF: UInt8 = 111;

    const ERR_OK: UInt32 = 0;
    const ERR_INVALID_WASM: UInt32 = 1;
    const ERR_INVALID_SECTION: UInt32 = 2;
    const ERR_INVALID_FUNCTION: UInt32 = 3;
    const ERR_INVALID_MEMORY: UInt32 = 4;
    const ERR_INVALID_TABLE: UInt32 = 5;
    const ERR_UNDEFINED_FUNCTION: UInt32 = 6;
    const ERR_INVALID_LINK: UInt32 = 7;
    const ERR_TOO_MANY_SECTIONS: UInt32 = 8;

    const MAX_FUNCTIONS: UInt32 = 65536;
    const MAX_IMPORTS: UInt32 = 16384;
    const MAX_EXPORTS: UInt32 = 16384;
    const MAX_MEMORIES: UInt32 = 256;
    const MAX_TABLES: UInt32 = 256;
    const MAX_DATA_SEGMENTS: UInt32 = 65536;

    const LINKING_VERSION: UInt32 = 2;

    const SECTION_DYLINK: UInt8 = 5;
    const SECTION_DYLINK_INFO: UInt8 = 6;

    const DYLINK_NEEDED: UInt8 = 1;
    const DYLINK_EXPORT_INFO: UInt8 = 2;
    const DYLINK_IMPORT_INFO: UInt8 = 3;
    const DYLINK_COMDAT_INFO: UInt8 = 4;
    const DYLINK_SYMBOL_TABLE: UInt8 = 5;
    const DYLINK_INFO: UInt8 = 6;

    const SYM_BINDING_WEAK: UInt8 = 1;
    const SYM_BINDING_LOCAL: UInt8 = 2;
    const SYM_VISIBILITY_HIDDEN: UInt8 = 3;
    const SYM_DEFINED: UInt8 = 4;
    const SYM_UNDEFINED: UInt8 = 5;
    const SYM_TLS: UInt8 = 6;

    proc K::validate_magic(data: UInt64) -> UInt32 {
        let magic = host_read_u32(data);
        if magic == WASM_MAGIC {
            let version = host_read_u32(data + 4);
            if version == WASM_VERSION {
                return 1;
            } else {
                return 0;
            }
        } else {
            return 0;
        }
    }

    proc K::section_name_hash(name: UInt64) -> UInt32 {
        let hash: UInt32 = 0;
        let i: UInt32 = 0;
        let byte = host_read_u8(name + i);
        while byte != 0 {
            hash = hash * 31 + byte;
            i = i + 1;
            byte = host_read_u8(name + i);
        }
        return hash;
    }

    proc K::get_section_type(data: UInt64, offset: UInt64) -> UInt8 {
        return host_read_u8(data + offset);
    }

    proc K::get_section_size(data: UInt64, offset: UInt64) -> UInt32 {
        return host_read_u32(data + offset + 1);
    }

    proc K::parse_type_section(data: UInt64, offset: UInt64, count: UInt32) -> UInt64 {
        return offset + 5 + count;
    }

    proc K::parse_import_section(data: UInt64, offset: UInt64, count: UInt32) -> UInt64 {
        let pos = offset + 1;
        let i: UInt32 = 0;
        while i < count {
            let module_len = host_read_u32(pos);
            pos = pos + 1 + module_len;
            let field_len = host_read_u32(pos);
            pos = pos + 1 + field_len;
            let kind = host_read_u8(pos);
            pos = pos + 1;
            if kind == FUNC_EXTERN_FUNC {
                pos = pos + 1;
            } else {
                if kind == FUNC_EXTERN_TABLE {
                    pos = pos + 2;
                } else {
                    if kind == FUNC_EXTERN_MEMORY {
                        pos = pos + 3;
                    } else {
                        if kind == FUNC_EXTERN_GLOBAL {
                            pos = pos + 2;
                        }
                    }
                }
            }
            i = i + 1;
        }
        return pos;
    }

    proc K::create_custom_section(name: UInt64, name_len: UInt32, content: UInt64, content_len: UInt64) -> UInt32 {
        if name == 0 {
            return ERR_INVALID_SECTION;
        }
        if content == 0 {
            return ERR_INVALID_SECTION;
        }
        return ERR_OK;
    }

    proc K::create_function_section(func_count: UInt32, type_indices: UInt64) -> UInt32 {
        if func_count == 0 {
            return ERR_OK;
        }
        if func_count > MAX_FUNCTIONS {
            return ERR_INVALID_FUNCTION;
        }
        return ERR_OK;
    }

    proc K::create_memory_section(initial_pages: UInt32, maximum_pages: UInt32, shared: UInt32) -> UInt32 {
        if initial_pages == 0 {
            return ERR_INVALID_MEMORY;
        }
        if maximum_pages > 0 {
            if maximum_pages < initial_pages {
                return ERR_INVALID_MEMORY;
            }
        }
        return ERR_OK;
    }

    proc K::create_table_section(table_type: UInt8, initial_size: UInt32, maximum_size: UInt32) -> UInt32 {
        if initial_size == 0 {
            return ERR_INVALID_TABLE;
        }
        if table_type != TABLE_TYPE_FUNCREF {
            if table_type != TABLE_TYPE_EXTERNREF {
                return ERR_INVALID_TABLE;
            }
        }
        return ERR_OK;
    }

    proc K::create_export_section(exports: UInt64, count: UInt32) -> UInt32 {
        if count == 0 {
            return ERR_OK;
        }
        if count > MAX_EXPORTS {
            return ERR_INVALID_LINK;
        }
        return ERR_OK;
    }

    proc K::create_import_section(imports: UInt64, count: UInt32) -> UInt32 {
        if count == 0 {
            return ERR_OK;
        }
        if count > MAX_IMPORTS {
            return ERR_INVALID_LINK;
        }
        return ERR_OK;
    }

    proc K::resolve_function_index(func_index: UInt32, imports: UInt32) -> UInt32 {
        if func_index < imports {
            return 0;
        }
        return func_index - imports;
    }

    proc K::apply_wasm_relocation(reloc_type: UInt32, offset: UInt64, addend: UInt64, sym_value: UInt64) -> UInt32 {
        if reloc_type == 0 {
            return ERR_OK;
        }
        return ERR_NOT_IMPLEMENTED_YET;
    }

    proc K::link_wasm_modules(main_module: UInt64, dep_count: UInt32, deps: UInt64) -> UInt32 {
        if main_module == 0 {
            return ERR_INVALID_WASM;
        }
        if dep_count == 0 {
            return ERR_OK;
        }
        return ERR_OK;
    }
}
