    const ERR_NOT_IMPLEMENTED: UInt32 = 17;

    proc K::wasm_available() -> UInt32 {
        return 0;
    }

    proc K::parse_wasm_object(data: UInt64, size: UInt32) -> UInt32 {
        return ERR_NOT_IMPLEMENTED;
    }

    proc K::ingest_wasm_symbols(data: UInt64, size: UInt32) -> UInt32 {
        return ERR_NOT_IMPLEMENTED;
    }
}
