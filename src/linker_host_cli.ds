    proc K::resolve_link_machine(machine: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(machine, "X64") == 1 { return TARGET_X86_64_WINDOWS; }
        if LinkerHost::K::str_eq(machine, "x64") == 1 { return TARGET_X86_64_WINDOWS; }
        if LinkerHost::K::str_eq(machine, "AMD64") == 1 { return TARGET_X86_64_WINDOWS; }
        if LinkerHost::K::str_eq(machine, "amd64") == 1 { return TARGET_X86_64_WINDOWS; }
        if LinkerHost::K::str_eq(machine, "ARM64") == 1 { return TARGET_AARCH64_WINDOWS; }
        if LinkerHost::K::str_eq(machine, "arm64") == 1 { return TARGET_AARCH64_WINDOWS; }
        return 0;
    }

    proc K::parse_thread_count_or_invalid(raw: UInt64) -> UInt32 {
        let parsed = LinkerHost::K::parse_u64(raw, 10);
        if parsed == 0 {
            if LinkerHost::K::str_eq(raw, "0") == 1 {
                return 0;
            } else {
                return 4294967295;
            }
        }
        if parsed > 4294967295 {
            return 4294967295;
        }
        return parsed;
    }

    proc K::parse_address_or_zero(raw: UInt64, is_base: UInt32) -> UInt64 {
        let parsed = LinkerHost::K::parse_u64(raw, 0);
        if parsed == 0 { return 0; }
        if is_base == 1 {
            if parsed < 4096 { return 0; }
        }
        return parsed;
    }

    proc K::default_map_file_for_output(output_file: UInt64) -> UInt64 {
        if output_file == DEFAULT_OUTPUT {
            return "a.out.map";
        } else {
            return LinkerFs::K::str_concat(output_file, ".map");
        }
    }

    proc K::requires_value(arg: UInt64) -> UInt32 {
        if is_output_flag(arg) == 1 { return 1; }
        if is_oformat_flag(arg) == 1 { return 1; }
        if is_entry_flag(arg) == 1 { return 1; }
        if is_image_base_flag(arg) == 1 { return 1; }
        if is_text_address_flag(arg) == 1 { return 1; }
        if is_map_flag(arg) == 1 { return 1; }
        if is_library_path_flag(arg) == 1 { return 1; }
        if is_library_flag(arg) == 1 { return 1; }
        if is_sysroot_flag(arg) == 1 { return 1; }
        if is_rpath_flag(arg) == 1 { return 1; }
        if is_rpath_link_flag(arg) == 1 { return 1; }
        if is_dynamic_linker_flag(arg) == 1 { return 1; }
        if is_soname_flag(arg) == 1 { return 1; }
        if is_script_flag(arg) == 1 { return 1; }
        if is_defsym_flag(arg) == 1 { return 1; }
        if is_target_flag(arg) == 1 { return 1; }
        if is_undefined_flag(arg) == 1 { return 1; }
        if is_unresolved_symbols_flag(arg) == 1 { return 1; }
        if is_trace_symbol_flag(arg) == 1 { return 1; }
        if is_z_flag(arg) == 1 { return 1; }
        if is_compat_value_flag(arg) == 1 { return 1; }
        if is_extended_compat_value_flag(arg) == 1 { return 1; }
        return 0;
    }

    proc K::run_default_link(arg_count: UInt32) -> UInt32 {
        if arg_count <= 1 { return ERR_EMPTY_INPUT; }
        return DustLink::K::link_with_options(arg_count - 1, DEFAULT_OUTPUT, FORMAT_ELF64, DEFAULT_ENTRY, DEFAULT_BASE);
    }

    proc K::run_with_output_flag(arg_count: UInt32) -> UInt32 {
        if arg_count <= 2 { return ERR_MISSING_FLAG_VALUE; }
        let output_file = LinkerHost::K::arg_at(2);
        return DustLink::K::link_with_options(1, output_file, FORMAT_ELF64, DEFAULT_ENTRY, DEFAULT_BASE);
    }

    proc K::run_with_oformat_flag(arg_count: UInt32) -> UInt32 {
        if arg_count <= 2 { return ERR_MISSING_FLAG_VALUE; }
        let format_text = LinkerHost::K::arg_at(2);
        let format = resolve_oformat(format_text);
        if format == 0 { return ERR_INVALID_FORMAT; }
        return DustLink::K::link_with_options(1, DEFAULT_OUTPUT, format, DEFAULT_ENTRY, DEFAULT_BASE);
    }

    proc K::run_with_entry_flag(arg_count: UInt32) -> UInt32 {
        if arg_count <= 2 { return ERR_MISSING_FLAG_VALUE; }
        let entry_text = LinkerHost::K::arg_at(2);
        let entry_addr = parse_address_or_zero(entry_text, 0);
        if entry_addr == 0 { return ERR_INVALID_ENTRY; }
        return DustLink::K::link_with_options(1, DEFAULT_OUTPUT, FORMAT_ELF64, entry_addr, DEFAULT_BASE);
    }

    proc K::run_with_image_base_flag(arg_count: UInt32) -> UInt32 {
        if arg_count <= 2 { return ERR_MISSING_FLAG_VALUE; }
        let base_text = LinkerHost::K::arg_at(2);
        let base_addr = parse_address_or_zero(base_text, 1);
        if base_addr == 0 { return ERR_INVALID_ADDRESS; }
        return DustLink::K::link_with_options(1, DEFAULT_OUTPUT, FORMAT_ELF64, DEFAULT_ENTRY, base_addr);
    }

    proc K::effective_output_format(cli_format: UInt32) -> UInt32 {
        let scripted = host_linker_get_output_format();
        if scripted == 0 {
            return cli_format;
        }
        if cli_format == FORMAT_ELF64 {
            return scripted;
        }
        return cli_format;
    }

    proc K::effective_entry(cli_entry: UInt64, saw_cli_entry: UInt32) -> UInt64 {
        if saw_cli_entry == 1 {
            return cli_entry;
        }
        let scripted = host_linker_get_entry();
        if scripted == 0 {
            return cli_entry;
        }
        return scripted;
    }

    proc K::effective_base(cli_base: UInt64, saw_cli_text: UInt32) -> UInt64 {
        if saw_cli_text == 1 {
            return cli_base;
        }
        let scripted = host_linker_get_image_base();
        if scripted == 0 {
            return cli_base;
        }
        return scripted;
    }

    proc K::effective_target_format(cli_format: UInt32, saw_oformat: UInt32) -> UInt32 {
        let merged = effective_output_format(cli_format);
        if saw_oformat == 1 {
            return merged;
        }
        if cli_format ! FORMAT_ELF64 {
            return merged;
        }
        if host_linker_get_output_format() ! 0 {
            return merged;
        }
        let target = host_linker_get_target();
        return default_format_for_target(target);
    }

    proc K::finalize_invocation(
        input_count: UInt32,
        output_file: UInt64,
        output_format: UInt32,
        entry_addr: UInt64,
        base_addr: UInt64,
        map_file: UInt64,
        saw_entry: UInt32,
        saw_text_base: UInt32,
        saw_oformat: UInt32
    ) -> UInt32 {
        if saw_entry == 1 {
            if saw_text_base == 1 {
                if entry_addr < base_addr { return ERR_CONFLICTING_OPTIONS; }
            }
        }
        let group_status = DustLink::K::validate_no_open_groups();
        if group_status ! ERR_OK {
            return group_status;
        }
        if input_count == 0 { return ERR_EMPTY_INPUT; }
        let final_format = effective_target_format(output_format, saw_oformat);
        let final_entry = effective_entry(entry_addr, saw_entry);
        let final_base = effective_base(base_addr, saw_text_base);
        let link_status = DustLink::K::link_with_options(input_count, output_file, final_format, final_entry, final_base);
        if link_status ! ERR_OK { return link_status; }
        let dep_status = DustLink::K::write_dependency_file();
        if dep_status ! ERR_OK { return dep_status; }
        if map_file == 0 { return ERR_OK; }
        return DustLink::K::create_map_file(map_file);
    }

    proc K::scan_args(
        arg_count: UInt32,
        idx: UInt32,
        input_count: UInt32,
        output_file: UInt64,
        output_format: UInt32,
        entry_addr: UInt64,
        base_addr: UInt64,
        map_file: UInt64,
        saw_entry: UInt32,
        saw_text_base: UInt32,
        saw_oformat: UInt32
    ) -> UInt32 {
        if idx >= arg_count {
            return finalize_invocation(
                input_count,
                output_file,
                output_format,
                entry_addr,
                base_addr,
                map_file,
                saw_entry,
                saw_text_base,
                saw_oformat
            );
        }

        let arg = LinkerHost::K::arg_at(idx);
        if is_help(arg) == 1 { return emit_usage(); }
        if is_version(arg) == 1 { return emit_version(); }

        let v_output = inline_output_value(arg);
        if v_output ! 0 {
            return scan_args(arg_count, idx + 1, input_count, v_output, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_oformat = inline_oformat_value(arg);
        if v_oformat ! 0 {
            let f = resolve_oformat(v_oformat);
            if f == 0 { return ERR_INVALID_FORMAT; }
            return scan_args(arg_count, idx + 1, input_count, output_file, f, entry_addr, base_addr, map_file, saw_entry, saw_text_base, 1);
        }
        let v_entry = inline_entry_value(arg);
        if v_entry ! 0 {
            let e = parse_address_or_zero(v_entry, 0);
            if e == 0 { return ERR_INVALID_ENTRY; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, e, base_addr, map_file, 1, saw_text_base, saw_oformat);
        }
        let v_base = inline_image_base_value(arg);
        if v_base ! 0 {
            let b = parse_address_or_zero(v_base, 1);
            if b == 0 { return ERR_INVALID_ADDRESS; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, b, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_text = inline_text_value(arg);
        if v_text ! 0 {
            let t = parse_address_or_zero(v_text, 1);
            if t == 0 { return ERR_INVALID_ADDRESS; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, t, map_file, saw_entry, 1, saw_oformat);
        }
        let v_map = inline_map_value(arg);
        if v_map ! 0 {
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, v_map, saw_entry, saw_text_base, saw_oformat);
        }
        let v_script = inline_script_value(arg);
        if v_script ! 0 {
            let s = DustLink::K::apply_script(v_script);
            if s ! ERR_OK { return s; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_defsym = inline_defsym_value(arg);
        if v_defsym ! 0 {
            let ds = DustLink::K::apply_defsym(v_defsym);
            if ds ! ERR_OK { return ds; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_target = inline_target_value(arg);
        if v_target ! 0 {
            let target = resolve_target(v_target);
            if target == 0 {
                emit_unsupported_target(v_target);
                return ERR_UNSUPPORTED_TARGET;
            } else {
                let ts = DustLink::K::set_target(target);
                if ts ! ERR_OK { return ts; }
                return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
        }
        let v_undefined = inline_undefined_value(arg);
        if v_undefined ! 0 {
            let rs = DustLink::K::require_symbol(v_undefined);
            if rs ! ERR_OK { return rs; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_unresolved_policy = inline_unresolved_symbols_value(arg);
        if v_unresolved_policy ! 0 {
            let up = resolve_unresolved_policy(v_unresolved_policy);
            if up == 4294967295 { return ERR_INVALID_FORMAT; }
            let us = DustLink::K::set_unresolved_policy(up);
            if us ! ERR_OK { return us; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_build_id = inline_build_id_value(arg);
        if v_build_id ! 0 {
            let bi = DustLink::K::set_build_id(v_build_id);
            if bi ! ERR_OK { return bi; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_z = inline_z_value(arg);
        if v_z ! 0 {
            let zs = DustLink::K::set_z_option(v_z);
            if zs ! ERR_OK { return zs; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_build_id_flag(arg) == 1 {
            let next_idx_build = idx + 1;
            if next_idx_build < arg_count {
                let next_arg_build = LinkerHost::K::arg_at(next_idx_build);
                if LinkerHost::K::str_starts_with(next_arg_build, "-") == 0 {
                    let bi2 = DustLink::K::set_build_id(next_arg_build);
                    if bi2 ! ERR_OK { return bi2; }
                    return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
                }
            }
            let bi_default = DustLink::K::enable_build_id_default();
            if bi_default ! ERR_OK { return bi_default; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_path = inline_library_path_value(arg);
        if v_path ! 0 {
            let p = DustLink::K::add_search_path(v_path);
            if p ! ERR_OK { return p; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_lib = inline_library_value(arg);
        if v_lib ! 0 {
            let l = DustLink::K::add_library(v_lib);
            if l ! ERR_OK { return l; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_sysroot = inline_sysroot_value(arg);
        if v_sysroot ! 0 {
            let sr = DustLink::K::set_sysroot(v_sysroot);
            if sr ! ERR_OK { return sr; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_rpath_link = inline_rpath_link_value(arg);
        if v_rpath_link ! 0 {
            let rl = DustLink::K::add_rpath_link(v_rpath_link);
            if rl ! ERR_OK { return rl; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_rpath = inline_rpath_value(arg);
        if v_rpath ! 0 {
            let rp = DustLink::K::add_rpath(v_rpath);
            if rp ! ERR_OK { return rp; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_dynamic_linker = inline_dynamic_linker_value(arg);
        if v_dynamic_linker ! 0 {
            let dl = DustLink::K::set_dynamic_linker(v_dynamic_linker);
            if dl ! ERR_OK { return dl; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_soname = inline_soname_value(arg);
        if v_soname ! 0 {
            let sn = DustLink::K::set_soname(v_soname);
            if sn ! ERR_OK { return sn; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_hash_style = inline_hash_style_value(arg);
        if v_hash_style ! 0 {
            let hs = DustLink::K::set_hash_style(v_hash_style);
            if hs ! ERR_OK { return hs; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_thread_count = inline_thread_count_value(arg);
        if v_thread_count ! 0 {
            let tc = parse_thread_count_or_invalid(v_thread_count);
            if tc == 4294967295 { return ERR_INVALID_FORMAT; }
            let ts = DustLink::K::set_thread_count(tc);
            if ts ! ERR_OK { return ts; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_version_script = inline_version_script_value(arg);
        if v_version_script ! 0 {
            let vs = DustLink::K::apply_script(v_version_script);
            if vs ! ERR_OK { return vs; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_dynamic_list = inline_dynamic_list_value(arg);
        if v_dynamic_list ! 0 {
            let dlv = DustLink::K::apply_script(v_dynamic_list);
            if dlv ! ERR_OK { return dlv; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_trace_symbol = inline_trace_symbol_value(arg);
        if v_trace_symbol ! 0 {
            let tr = DustLink::K::add_trace_symbol(v_trace_symbol);
            if tr ! ERR_OK { return tr; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_trace_flag(arg) == 1 {
