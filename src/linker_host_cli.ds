    }

    proc K::is_soft_compat_link_slash_flag(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "/CETCOMPAT") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "/cetcompat") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "/BREPRO") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "/brepro") == 1 { return 1; }
        if LinkerHost::K::str_starts_with(arg, "/GUARD:") == 1 { return 1; }
        if LinkerHost::K::str_starts_with(arg, "/guard:") == 1 { return 1; }
        if LinkerHost::K::str_starts_with(arg, "/TIMESTAMP:") == 1 { return 1; }
        if LinkerHost::K::str_starts_with(arg, "/timestamp:") == 1 { return 1; }
        if LinkerHost::K::str_starts_with(arg, "/DEPENDENTLOADFLAG:") == 1 { return 1; }
        if LinkerHost::K::str_starts_with(arg, "/dependentloadflag:") == 1 { return 1; }
        if LinkerHost::K::str_starts_with(arg, "/FUNCTIONPADMIN:") == 1 { return 1; }
        if LinkerHost::K::str_starts_with(arg, "/functionpadmin:") == 1 { return 1; }
        if LinkerHost::K::str_starts_with(arg, "/ORDER:") == 1 { return 1; }
        if LinkerHost::K::str_starts_with(arg, "/order:") == 1 { return 1; }
        if LinkerHost::K::str_starts_with(arg, "/MERGE:") == 1 { return 1; }
        if LinkerHost::K::str_starts_with(arg, "/merge:") == 1 { return 1; }
        if LinkerHost::K::str_starts_with(arg, "/SECTION:") == 1 { return 1; }
        if LinkerHost::K::str_starts_with(arg, "/section:") == 1 { return 1; }
        if LinkerHost::K::str_starts_with(arg, "/ALIGN:") == 1 { return 1; }
        if LinkerHost::K::str_starts_with(arg, "/align:") == 1 { return 1; }
        return 0;
    }

    proc K::inline_link_out_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "/OUT:") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "/OUT:");
        }
        if LinkerHost::K::str_starts_with(arg, "/out:") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "/out:");
        }
        return 0;
    }

