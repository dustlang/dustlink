        if LinkerHost::K::str_eq(arg, "-h") == 1 {
            return 1;
        } else {
            if LinkerHost::K::str_eq(arg, "--help") == 1 {
                return 1;
            } else {
                return 0;
            }
        }
    }

    proc K::is_version(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "-V") == 1 {
            return 1;
        } else {
            if LinkerHost::K::str_eq(arg, "--version") == 1 {
                return 1;
            } else {
                return 0;
            }
        }
    }

    proc K::is_compat_no_value_flag(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "--eh-frame-hdr") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--as-needed") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--no-as-needed") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "-shared") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--shared") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "-pie") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--pie") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--no-pie") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "-static") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "-Bstatic") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "-Bdynamic") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--fatal-warnings") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--no-fatal-warnings") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--color-diagnostics") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--no-color-diagnostics") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--stats") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--print-gc-sections") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--no-print-gc-sections") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--icf=none") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--icf=safe") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--icf=all") == 1 { return 1; }
        return 0;
    }

    proc K::is_compat_value_flag(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "--dynamic-linker") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--soname") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "-soname") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--hash-style") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--threads") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--thread-count") == 1 { return 1; }
        return 0;
    }

    proc K::resolve_oformat(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "elf64") == 1 { return FORMAT_ELF64; }
        if LinkerHost::K::str_eq(arg, "elf64-x86-64") == 1 { return FORMAT_ELF64; }
        if LinkerHost::K::str_eq(arg, "binary") == 1 { return FORMAT_BINARY; }
        if LinkerHost::K::str_eq(arg, "bin") == 1 { return FORMAT_BINARY; }
        if LinkerHost::K::str_eq(arg, "mbr") == 1 { return FORMAT_MBR; }
        if LinkerHost::K::str_eq(arg, "pe") == 1 { return FORMAT_PE64; }
        if LinkerHost::K::str_eq(arg, "pei-x86-64") == 1 { return FORMAT_PE64; }
        if LinkerHost::K::str_eq(arg, "pe-x86-64") == 1 { return FORMAT_PE64; }
        if LinkerHost::K::str_eq(arg, "macho64") == 1 { return FORMAT_MACHO64; }
        if LinkerHost::K::str_eq(arg, "mach-o") == 1 { return FORMAT_MACHO64; }
        if LinkerHost::K::str_eq(arg, "macho-x86-64") == 1 { return FORMAT_MACHO64; }
        return 0;
    }

    proc K::resolve_target(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "x86_64-linux") == 1 { return TARGET_X86_64_LINUX; }
        if LinkerHost::K::str_eq(arg, "x86_64-linux-gnu") == 1 { return TARGET_X86_64_LINUX; }
        if LinkerHost::K::str_eq(arg, "x86_64-unknown-linux-gnu") == 1 { return TARGET_X86_64_LINUX; }
        if LinkerHost::K::str_eq(arg, "elf_x86_64") == 1 { return TARGET_X86_64_LINUX; }
        if LinkerHost::K::str_eq(arg, "elf64-x86-64") == 1 { return TARGET_X86_64_LINUX; }

        if LinkerHost::K::str_eq(arg, "x86_64-windows-msvc") == 1 { return TARGET_X86_64_WINDOWS; }
        if LinkerHost::K::str_eq(arg, "x86_64-pc-windows-msvc") == 1 { return TARGET_X86_64_WINDOWS; }
        if LinkerHost::K::str_eq(arg, "x86_64-windows-gnu") == 1 { return TARGET_X86_64_WINDOWS; }
        if LinkerHost::K::str_eq(arg, "i386pep") == 1 { return TARGET_X86_64_WINDOWS; }
        if LinkerHost::K::str_eq(arg, "pep") == 1 { return TARGET_X86_64_WINDOWS; }
        if LinkerHost::K::str_eq(arg, "pe-x86-64") == 1 { return TARGET_X86_64_WINDOWS; }

        if LinkerHost::K::str_eq(arg, "x86_64-apple-darwin") == 1 { return TARGET_X86_64_MACOS; }
        if LinkerHost::K::str_eq(arg, "x86_64-macos") == 1 { return TARGET_X86_64_MACOS; }
        if LinkerHost::K::str_eq(arg, "mach_o_x86_64") == 1 { return TARGET_X86_64_MACOS; }
        if LinkerHost::K::str_eq(arg, "macho-x86-64") == 1 { return TARGET_X86_64_MACOS; }
        return 0;
    }

    proc K::default_format_for_target(target: UInt32) -> UInt32 {
        if target == TARGET_X86_64_WINDOWS {
            return FORMAT_PE64;
        } else {
            if target == TARGET_X86_64_MACOS {
                return FORMAT_MACHO64;
            } else {
                return FORMAT_ELF64;
            }
        }
    }

    proc K::emit_usage() -> UInt32 {
        LinkerHost::K::print_line("dustlink (Dust internal linker)");
        LinkerHost::K::print_line("usage: dustlink [options] <inputs>");
        LinkerHost::K::print_line("  -o, --output <path>");
        LinkerHost::K::print_line("  -e, --entry <addr>");
        LinkerHost::K::print_line("  --image-base <addr>");
        LinkerHost::K::print_line("  -Ttext <addr>");
        LinkerHost::K::print_line("  -T <script>, --script <script>");
        LinkerHost::K::print_line("  --oformat <elf64|binary|mbr|pe|macho64>");
        LinkerHost::K::print_line("  -L/-l and --library-path/--library");
        LinkerHost::K::print_line("  --sysroot <path>  -rpath <path>  -rpath-link <path>");
        LinkerHost::K::print_line("  -Map/--map-file");
        LinkerHost::K::print_line("  --target=<triple> | -m<emulation>");
        LinkerHost::K::print_line("  --defsym=name=value");
        LinkerHost::K::print_line("  -u/--undefined/--require-defined <symbol>");
        LinkerHost::K::print_line("  --start-group ... --end-group");
        LinkerHost::K::print_line("  -shared/-pie/--no-pie/-static/-Bstatic/-Bdynamic");
        LinkerHost::K::print_line("  --dynamic-linker <path>  --soname <name>");
        LinkerHost::K::print_line("  --enable-new-dtags/--disable-new-dtags");
        LinkerHost::K::print_line("  --copy-dt-needed-entries/--no-copy-dt-needed-entries");
        LinkerHost::K::print_line("  --build-id[=<none|fast|md5|sha1|uuid|0x...>]");
        LinkerHost::K::print_line("  -z <relro|norelro|now|lazy|execstack|noexecstack>");
        return ERR_OK;
    }

    proc K::emit_version() -> UInt32 {
        LinkerHost::K::print_line("dustlink version 0.5");
        return ERR_OK;
    }

    proc K::inline_output_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "--output=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--output=");
        }
        if LinkerHost::K::str_starts_with(arg, "-o") == 1 {
            if is_output_flag(arg) == 1 { return 0; }
            return LinkerHost::K::str_after_prefix(arg, "-o");
        }
        return 0;
    }

    proc K::inline_oformat_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "--oformat=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--oformat=");
        }
        return 0;
    }

    proc K::inline_entry_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "--entry=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--entry=");
        }
        if LinkerHost::K::str_starts_with(arg, "--entry-point=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--entry-point=");
        }
        if LinkerHost::K::str_starts_with(arg, "-e") == 1 {
            if is_entry_flag(arg) == 1 { return 0; }
            return LinkerHost::K::str_after_prefix(arg, "-e");
        }
        return 0;
    }

    proc K::inline_image_base_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "--image-base=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--image-base=");
        }
        return 0;
    }

    proc K::inline_text_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "-Ttext=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "-Ttext=");
        }
        if LinkerHost::K::str_starts_with(arg, "-Ttext") == 1 {
            if is_text_address_flag(arg) == 1 { return 0; }
            return LinkerHost::K::str_after_prefix(arg, "-Ttext");
        }
        return 0;
    }

    proc K::inline_map_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "-Map=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "-Map=");
        }
        if LinkerHost::K::str_starts_with(arg, "--Map=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--Map=");
        }
        if LinkerHost::K::str_starts_with(arg, "--map-file=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--map-file=");
        }
        return 0;
    }

    proc K::inline_script_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "--script=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--script=");
        }
        if LinkerHost::K::str_starts_with(arg, "-T") == 1 {
            if is_text_address_flag(arg) == 1 { return 0; }
            if is_script_flag(arg) == 1 { return 0; }
            return LinkerHost::K::str_after_prefix(arg, "-T");
        }
        return 0;
    }

    proc K::inline_defsym_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "--defsym=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--defsym=");
        }
        return 0;
    }

    proc K::inline_target_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "--target=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--target=");
        }
        if LinkerHost::K::str_starts_with(arg, "-m") == 1 {
            if LinkerHost::K::str_eq(arg, "-m") == 1 {
                return 0;
            } else {
                return LinkerHost::K::str_after_prefix(arg, "-m");
            }
        }
        return 0;
    }

    proc K::inline_undefined_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "--undefined=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--undefined=");
        }
        if LinkerHost::K::str_starts_with(arg, "--require-defined=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--require-defined=");
        }
        if LinkerHost::K::str_starts_with(arg, "-u") == 1 {
            if LinkerHost::K::str_eq(arg, "-u") == 1 {
                return 0;
            } else {
                return LinkerHost::K::str_after_prefix(arg, "-u");
            }
        }
        return 0;
    }

    proc K::inline_build_id_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "--build-id=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--build-id=");
        }
        return 0;
    }

    proc K::inline_z_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "-z") == 1 {
            if is_z_flag(arg) == 1 {
                return 0;
            } else {
                return LinkerHost::K::str_after_prefix(arg, "-z");
            }
        }
        return 0;
    }

    proc K::inline_library_path_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "--library-path=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--library-path=");
        }
        if LinkerHost::K::str_starts_with(arg, "-L") == 1 {
            if is_library_path_flag(arg) == 1 { return 0; }
            return LinkerHost::K::str_after_prefix(arg, "-L");
        }
        return 0;
    }

    proc K::inline_library_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "--library=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--library=");
        }
        if LinkerHost::K::str_starts_with(arg, "-l") == 1 {
            if is_library_flag(arg) == 1 { return 0; }
            return LinkerHost::K::str_after_prefix(arg, "-l");
        }
        return 0;
    }

    proc K::inline_sysroot_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "--sysroot=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--sysroot=");
        }
        return 0;
    }

    proc K::inline_rpath_link_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "--rpath-link=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--rpath-link=");
        }
        if LinkerHost::K::str_starts_with(arg, "-rpath-link=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "-rpath-link=");
        }
        if LinkerHost::K::str_starts_with(arg, "-rpath-link") == 1 {
            if is_rpath_link_flag(arg) == 1 { return 0; }
            return LinkerHost::K::str_after_prefix(arg, "-rpath-link");
        }
        return 0;
    }

    proc K::inline_rpath_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "--rpath=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--rpath=");
        }
        if LinkerHost::K::str_starts_with(arg, "-rpath=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "-rpath=");
        }
        if LinkerHost::K::str_starts_with(arg, "-rpath-link") == 1 {
            return 0;
        }
        if LinkerHost::K::str_starts_with(arg, "-rpath") == 1 {
            if is_rpath_flag(arg) == 1 { return 0; }
            return LinkerHost::K::str_after_prefix(arg, "-rpath");
        }
        return 0;
    }

    proc K::inline_dynamic_linker_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "--dynamic-linker=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--dynamic-linker=");
        }
        return 0;
    }

    proc K::inline_soname_value(arg: UInt64) -> UInt64 {
        if LinkerHost::K::str_starts_with(arg, "--soname=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "--soname=");
        }
        if LinkerHost::K::str_starts_with(arg, "-soname=") == 1 {
            return LinkerHost::K::str_after_prefix(arg, "-soname=");
        }
        return 0;
    }

    proc K::parse_address_or_zero(raw: UInt64, is_base: UInt32) -> UInt64 {
        let parsed = LinkerHost::K::parse_u64(raw, 0);
        if parsed == 0 { return 0; }
        if is_base == 1 {
            if parsed < 4096 { return 0; }
        }
        return parsed;
    }

    proc K::requires_value(arg: UInt64) -> UInt32 {
        if is_output_flag(arg) == 1 { return 1; }
        if is_oformat_flag(arg) == 1 { return 1; }
        if is_entry_flag(arg) == 1 { return 1; }
        if is_image_base_flag(arg) == 1 { return 1; }
        if is_text_address_flag(arg) == 1 { return 1; }
        if is_map_flag(arg) == 1 { return 1; }
        if is_library_path_flag(arg) == 1 { return 1; }
        if is_library_flag(arg) == 1 { return 1; }
        if is_sysroot_flag(arg) == 1 { return 1; }
        if is_rpath_flag(arg) == 1 { return 1; }
        if is_rpath_link_flag(arg) == 1 { return 1; }
        if is_script_flag(arg) == 1 { return 1; }
        if is_defsym_flag(arg) == 1 { return 1; }
        if is_target_flag(arg) == 1 { return 1; }
        if is_undefined_flag(arg) == 1 { return 1; }
        if is_z_flag(arg) == 1 { return 1; }
        if is_compat_value_flag(arg) == 1 { return 1; }
        return 0;
    }

    proc K::run_default_link(arg_count: UInt32) -> UInt32 {
        if arg_count <= 1 { return ERR_EMPTY_INPUT; }
        return DustLink::K::link_with_options(arg_count - 1, DEFAULT_OUTPUT, FORMAT_ELF64, DEFAULT_ENTRY, DEFAULT_BASE);
    }

    proc K::run_with_output_flag(arg_count: UInt32) -> UInt32 {
        if arg_count <= 2 { return ERR_MISSING_FLAG_VALUE; }
        let output_file = LinkerHost::K::arg_at(2);
        return DustLink::K::link_with_options(1, output_file, FORMAT_ELF64, DEFAULT_ENTRY, DEFAULT_BASE);
    }

    proc K::run_with_oformat_flag(arg_count: UInt32) -> UInt32 {
        if arg_count <= 2 { return ERR_MISSING_FLAG_VALUE; }
        let format_text = LinkerHost::K::arg_at(2);
        let format = resolve_oformat(format_text);
        if format == 0 { return ERR_INVALID_FORMAT; }
        return DustLink::K::link_with_options(1, DEFAULT_OUTPUT, format, DEFAULT_ENTRY, DEFAULT_BASE);
    }

    proc K::run_with_entry_flag(arg_count: UInt32) -> UInt32 {
        if arg_count <= 2 { return ERR_MISSING_FLAG_VALUE; }
        let entry_text = LinkerHost::K::arg_at(2);
        let entry_addr = parse_address_or_zero(entry_text, 0);
        if entry_addr == 0 { return ERR_INVALID_ENTRY; }
        return DustLink::K::link_with_options(1, DEFAULT_OUTPUT, FORMAT_ELF64, entry_addr, DEFAULT_BASE);
    }

    proc K::run_with_image_base_flag(arg_count: UInt32) -> UInt32 {
        if arg_count <= 2 { return ERR_MISSING_FLAG_VALUE; }
        let base_text = LinkerHost::K::arg_at(2);
        let base_addr = parse_address_or_zero(base_text, 1);
        if base_addr == 0 { return ERR_INVALID_ADDRESS; }
        return DustLink::K::link_with_options(1, DEFAULT_OUTPUT, FORMAT_ELF64, DEFAULT_ENTRY, base_addr);
    }

    proc K::effective_output_format(cli_format: UInt32) -> UInt32 {
        let scripted = host_linker_get_output_format();
        if scripted == 0 {
            return cli_format;
        }
        if cli_format == FORMAT_ELF64 {
            return scripted;
        }
        return cli_format;
    }

    proc K::effective_entry(cli_entry: UInt64, saw_cli_entry: UInt32) -> UInt64 {
        if saw_cli_entry == 1 {
            return cli_entry;
        }
        let scripted = host_linker_get_entry();
        if scripted == 0 {
            return cli_entry;
        }
        return scripted;
    }

    proc K::effective_base(cli_base: UInt64, saw_cli_text: UInt32) -> UInt64 {
        if saw_cli_text == 1 {
            return cli_base;
        }
        let scripted = host_linker_get_image_base();
        if scripted == 0 {
            return cli_base;
        }
        return scripted;
    }

    proc K::effective_target_format(cli_format: UInt32, saw_oformat: UInt32) -> UInt32 {
        let merged = effective_output_format(cli_format);
        if saw_oformat == 1 {
            return merged;
        }
        if cli_format ! FORMAT_ELF64 {
            return merged;
        }
        if host_linker_get_output_format() ! 0 {
            return merged;
        }
        let target = host_linker_get_target();
        return default_format_for_target(target);
    }

    proc K::finalize_invocation(
        input_count: UInt32,
        output_file: UInt64,
        output_format: UInt32,
        entry_addr: UInt64,
        base_addr: UInt64,
        map_file: UInt64,
        saw_entry: UInt32,
        saw_text_base: UInt32,
        saw_oformat: UInt32
    ) -> UInt32 {
        if saw_entry == 1 {
            if saw_text_base == 1 {
                if entry_addr < base_addr { return ERR_CONFLICTING_OPTIONS; }
            }
        }
        let group_status = DustLink::K::validate_no_open_groups();
        if group_status ! ERR_OK {
            return group_status;
        }
        if input_count == 0 { return ERR_EMPTY_INPUT; }
        let final_format = effective_target_format(output_format, saw_oformat);
        let final_entry = effective_entry(entry_addr, saw_entry);
        let final_base = effective_base(base_addr, saw_text_base);
        let link_status = DustLink::K::link_with_options(input_count, output_file, final_format, final_entry, final_base);
        if link_status ! ERR_OK { return link_status; }
        if map_file == 0 { return ERR_OK; }
        return DustLink::K::create_map_file(map_file);
    }

    proc K::scan_args(
        arg_count: UInt32,
        idx: UInt32,
        input_count: UInt32,
        output_file: UInt64,
        output_format: UInt32,
        entry_addr: UInt64,
        base_addr: UInt64,
        map_file: UInt64,
        saw_entry: UInt32,
        saw_text_base: UInt32,
        saw_oformat: UInt32
    ) -> UInt32 {
        if idx >= arg_count {
            return finalize_invocation(
                input_count,
                output_file,
                output_format,
                entry_addr,
                base_addr,
                map_file,
                saw_entry,
                saw_text_base,
                saw_oformat
            );
        }

        let arg = LinkerHost::K::arg_at(idx);
        if is_help(arg) == 1 { return emit_usage(); }
        if is_version(arg) == 1 { return emit_version(); }

        let v_output = inline_output_value(arg);
        if v_output ! 0 {
            return scan_args(arg_count, idx + 1, input_count, v_output, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_oformat = inline_oformat_value(arg);
        if v_oformat ! 0 {
            let f = resolve_oformat(v_oformat);
            if f == 0 { return ERR_INVALID_FORMAT; }
            return scan_args(arg_count, idx + 1, input_count, output_file, f, entry_addr, base_addr, map_file, saw_entry, saw_text_base, 1);
        }
        let v_entry = inline_entry_value(arg);
        if v_entry ! 0 {
            let e = parse_address_or_zero(v_entry, 0);
            if e == 0 { return ERR_INVALID_ENTRY; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, e, base_addr, map_file, 1, saw_text_base, saw_oformat);
        }
        let v_base = inline_image_base_value(arg);
        if v_base ! 0 {
            let b = parse_address_or_zero(v_base, 1);
            if b == 0 { return ERR_INVALID_ADDRESS; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, b, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_text = inline_text_value(arg);
        if v_text ! 0 {
            let t = parse_address_or_zero(v_text, 1);
            if t == 0 { return ERR_INVALID_ADDRESS; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, t, map_file, saw_entry, 1, saw_oformat);
        }
        let v_map = inline_map_value(arg);
        if v_map ! 0 {
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, v_map, saw_entry, saw_text_base, saw_oformat);
        }
        let v_script = inline_script_value(arg);
        if v_script ! 0 {
            let s = DustLink::K::apply_script(v_script);
            if s ! ERR_OK { return s; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_defsym = inline_defsym_value(arg);
        if v_defsym ! 0 {
            let ds = DustLink::K::apply_defsym(v_defsym);
            if ds ! ERR_OK { return ds; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_target = inline_target_value(arg);
        if v_target ! 0 {
            let target = resolve_target(v_target);
            if target == 0 {
                return ERR_UNSUPPORTED_TARGET;
            } else {
                let ts = DustLink::K::set_target(target);
                if ts ! ERR_OK { return ts; }
                return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
        }
        let v_undefined = inline_undefined_value(arg);
        if v_undefined ! 0 {
            let rs = DustLink::K::require_symbol(v_undefined);
            if rs ! ERR_OK { return rs; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_build_id = inline_build_id_value(arg);
        if v_build_id ! 0 {
            let bi = DustLink::K::set_build_id(v_build_id);
            if bi ! ERR_OK { return bi; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_z = inline_z_value(arg);
        if v_z ! 0 {
            let zs = DustLink::K::set_z_option(v_z);
            if zs ! ERR_OK { return zs; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_build_id_flag(arg) == 1 {
            let next_idx_build = idx + 1;
            if next_idx_build < arg_count {
                let next_arg_build = LinkerHost::K::arg_at(next_idx_build);
                if LinkerHost::K::str_starts_with(next_arg_build, "-") == 0 {
                    let bi2 = DustLink::K::set_build_id(next_arg_build);
                    if bi2 ! ERR_OK { return bi2; }
                    return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
                }
            }
            let bi_default = DustLink::K::enable_build_id_default();
            if bi_default ! ERR_OK { return bi_default; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_path = inline_library_path_value(arg);
        if v_path ! 0 {
            let p = DustLink::K::add_search_path(v_path);
            if p ! ERR_OK { return p; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_lib = inline_library_value(arg);
        if v_lib ! 0 {
            let l = DustLink::K::add_library(v_lib);
            if l ! ERR_OK { return l; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_sysroot = inline_sysroot_value(arg);
        if v_sysroot ! 0 {
            let sr = DustLink::K::set_sysroot(v_sysroot);
            if sr ! ERR_OK { return sr; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_rpath_link = inline_rpath_link_value(arg);
        if v_rpath_link ! 0 {
            let rl = DustLink::K::add_rpath_link(v_rpath_link);
            if rl ! ERR_OK { return rl; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_rpath = inline_rpath_value(arg);
        if v_rpath ! 0 {
            let rp = DustLink::K::add_rpath(v_rpath);
            if rp ! ERR_OK { return rp; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_dynamic_linker = inline_dynamic_linker_value(arg);
        if v_dynamic_linker ! 0 {
            let dl = DustLink::K::set_dynamic_linker(v_dynamic_linker);
            if dl ! ERR_OK { return dl; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        let v_soname = inline_soname_value(arg);
        if v_soname ! 0 {
            let sn = DustLink::K::set_soname(v_soname);
            if sn ! ERR_OK { return sn; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }

        if requires_value(arg) == 1 {
            let next_idx = idx + 1;
            if next_idx >= arg_count { return ERR_MISSING_FLAG_VALUE; }
            let value = LinkerHost::K::arg_at(next_idx);
            if is_output_flag(arg) == 1 {
                return scan_args(arg_count, idx + 2, input_count, value, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
            if is_oformat_flag(arg) == 1 {
                let f2 = resolve_oformat(value);
                if f2 == 0 { return ERR_INVALID_FORMAT; }
                return scan_args(arg_count, idx + 2, input_count, output_file, f2, entry_addr, base_addr, map_file, saw_entry, saw_text_base, 1);
            }
            if is_entry_flag(arg) == 1 {
                let e2 = parse_address_or_zero(value, 0);
                if e2 == 0 { return ERR_INVALID_ENTRY; }
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, e2, base_addr, map_file, 1, saw_text_base, saw_oformat);
            }
            if is_image_base_flag(arg) == 1 {
                let b2 = parse_address_or_zero(value, 1);
                if b2 == 0 { return ERR_INVALID_ADDRESS; }
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, b2, map_file, saw_entry, saw_text_base, saw_oformat);
            }
            if is_text_address_flag(arg) == 1 {
                let t2 = parse_address_or_zero(value, 1);
                if t2 == 0 { return ERR_INVALID_ADDRESS; }
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, t2, map_file, saw_entry, 1, saw_oformat);
            }
            if is_map_flag(arg) == 1 {
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, value, saw_entry, saw_text_base, saw_oformat);
            }
            if is_library_path_flag(arg) == 1 {
                let p2 = DustLink::K::add_search_path(value);
                if p2 ! ERR_OK { return p2; }
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
            if is_library_flag(arg) == 1 {
                let l2 = DustLink::K::add_library(value);
                if l2 ! ERR_OK { return l2; }
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
            if is_sysroot_flag(arg) == 1 {
                let sr2 = DustLink::K::set_sysroot(value);
                if sr2 ! ERR_OK { return sr2; }
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
            if is_rpath_link_flag(arg) == 1 {
                let rl2 = DustLink::K::add_rpath_link(value);
                if rl2 ! ERR_OK { return rl2; }
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
            if is_rpath_flag(arg) == 1 {
                let rp2 = DustLink::K::add_rpath(value);
                if rp2 ! ERR_OK { return rp2; }
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
            if is_script_flag(arg) == 1 {
                let s2 = DustLink::K::apply_script(value);
                if s2 ! ERR_OK { return s2; }
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
            if is_defsym_flag(arg) == 1 {
                let ds2 = DustLink::K::apply_defsym(value);
                if ds2 ! ERR_OK { return ds2; }
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
            if is_target_flag(arg) == 1 {
                let t2 = resolve_target(value);
                if t2 == 0 { return ERR_UNSUPPORTED_TARGET; }
                let ts2 = DustLink::K::set_target(t2);
                if ts2 ! ERR_OK { return ts2; }
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
            if is_undefined_flag(arg) == 1 {
                let rs2 = DustLink::K::require_symbol(value);
                if rs2 ! ERR_OK { return rs2; }
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
            if is_z_flag(arg) == 1 {
                if LinkerHost::K::str_starts_with(value, "-") == 1 { return ERR_MISSING_FLAG_VALUE; }
                let zs2 = DustLink::K::set_z_option(value);
                if zs2 ! ERR_OK { return zs2; }
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
            if LinkerHost::K::str_eq(arg, "--dynamic-linker") == 1 {
                let dl2 = DustLink::K::set_dynamic_linker(value);
                if dl2 ! ERR_OK { return dl2; }
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
            if LinkerHost::K::str_eq(arg, "--soname") == 1 {
                let sn2 = DustLink::K::set_soname(value);
                if sn2 ! ERR_OK { return sn2; }
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
            if LinkerHost::K::str_eq(arg, "-soname") == 1 {
                let sn3 = DustLink::K::set_soname(value);
                if sn3 ! ERR_OK { return sn3; }
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
            if is_compat_value_flag(arg) == 1 {
                return scan_args(arg_count, idx + 2, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
            }
            return ERR_UNSUPPORTED_FLAG;
        }

        if is_strip_debug_flag(arg) == 1 {
            let s3 = DustLink::K::strip_debug();
            if s3 ! ERR_OK { return s3; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_gc_sections_flag(arg) == 1 {
            let g1 = DustLink::K::set_gc_sections(1);
            if g1 ! ERR_OK { return g1; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_no_gc_sections_flag(arg) == 1 {
            let g0 = DustLink::K::set_gc_sections(0);
            if g0 ! ERR_OK { return g0; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_allow_multiple_definition_flag(arg) == 1 {
            let am = DustLink::K::set_allow_multiple_definition(1);
            if am ! ERR_OK { return am; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_no_undefined_flag(arg) == 1 {
            let nu1 = DustLink::K::set_no_undefined(1);
            if nu1 ! ERR_OK { return nu1; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_allow_shlib_undefined_flag(arg) == 1 {
            let nu0 = DustLink::K::set_no_undefined(0);
            if nu0 ! ERR_OK { return nu0; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_start_group_flag(arg) == 1 {
            let gs = DustLink::K::start_group();
            if gs ! ERR_OK { return gs; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_end_group_flag(arg) == 1 {
            let ge = DustLink::K::end_group_and_resolve();
            if ge ! ERR_OK { return ge; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if LinkerHost::K::str_eq(arg, "--as-needed") == 1 {
            let an1 = DustLink::K::set_as_needed(1);
            if an1 ! ERR_OK { return an1; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if LinkerHost::K::str_eq(arg, "--no-as-needed") == 1 {
            let an0 = DustLink::K::set_as_needed(0);
            if an0 ! ERR_OK { return an0; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_enable_new_dtags_flag(arg) == 1 {
            let nd1 = DustLink::K::set_new_dtags(1);
            if nd1 ! ERR_OK { return nd1; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_disable_new_dtags_flag(arg) == 1 {
            let nd0 = DustLink::K::set_new_dtags(0);
            if nd0 ! ERR_OK { return nd0; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_copy_dt_needed_entries_flag(arg) == 1 {
            let cp1 = DustLink::K::set_copy_dt_needed_entries(1);
            if cp1 ! ERR_OK { return cp1; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_no_copy_dt_needed_entries_flag(arg) == 1 {
            let cp0 = DustLink::K::set_copy_dt_needed_entries(0);
            if cp0 ! ERR_OK { return cp0; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if LinkerHost::K::str_eq(arg, "-shared") == 1 {
            let sh1 = DustLink::K::set_shared(1);
            if sh1 ! ERR_OK { return sh1; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if LinkerHost::K::str_eq(arg, "--shared") == 1 {
            let sh2 = DustLink::K::set_shared(1);
            if sh2 ! ERR_OK { return sh2; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if LinkerHost::K::str_eq(arg, "-pie") == 1 {
            let pie1 = DustLink::K::set_pie(1);
            if pie1 ! ERR_OK { return pie1; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if LinkerHost::K::str_eq(arg, "--pie") == 1 {
            let pie2 = DustLink::K::set_pie(1);
            if pie2 ! ERR_OK { return pie2; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if LinkerHost::K::str_eq(arg, "--no-pie") == 1 {
            let pie0 = DustLink::K::set_pie(0);
            if pie0 ! ERR_OK { return pie0; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if LinkerHost::K::str_eq(arg, "-static") == 1 {
            let st1 = DustLink::K::set_static(1);
            if st1 ! ERR_OK { return st1; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if LinkerHost::K::str_eq(arg, "-Bstatic") == 1 {
            let bst1 = DustLink::K::set_static(1);
            if bst1 ! ERR_OK { return bst1; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if LinkerHost::K::str_eq(arg, "-Bdynamic") == 1 {
            let bst0 = DustLink::K::set_static(0);
            if bst0 ! ERR_OK { return bst0; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_whole_archive_flag(arg) == 1 {
            let wa1 = DustLink::K::set_whole_archive(1);
            if wa1 ! ERR_OK { return wa1; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_no_whole_archive_flag(arg) == 1 {
            let wa0 = DustLink::K::set_whole_archive(0);
            if wa0 ! ERR_OK { return wa0; }
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if is_compat_no_value_flag(arg) == 1 {
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }

        if LinkerHost::K::str_starts_with(arg, "--threads=") == 1 {
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if LinkerHost::K::str_starts_with(arg, "--thread-count=") == 1 {
            return scan_args(arg_count, idx + 1, input_count, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
        }
        if LinkerHost::K::str_starts_with(arg, "-m") == 1 {
            if LinkerHost::K::str_eq(arg, "-m") == 1 { return ERR_MISSING_FLAG_VALUE; }
            return ERR_UNSUPPORTED_TARGET;
        }

        if LinkerHost::K::str_starts_with(arg, "-") == 1 { return ERR_UNSUPPORTED_FLAG; }
        let add_input_status = DustLink::K::add_input_file(arg);
        if add_input_status ! ERR_OK { return add_input_status; }
        return scan_args(arg_count, idx + 1, input_count + 1, output_file, output_format, entry_addr, base_addr, map_file, saw_entry, saw_text_base, saw_oformat);
    }

    proc K::run_with_host_args() -> UInt32 {
        let arg_count = LinkerHost::K::args_count();
        if arg_count <= 1 {
            return emit_usage();
        }
        return scan_args(arg_count, 1, 0, DEFAULT_OUTPUT, FORMAT_ELF64, DEFAULT_ENTRY, DEFAULT_BASE, 0, 0, 0, 0);
    }
}
