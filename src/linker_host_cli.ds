                return 1;
            } else {
                return 0;
            }
        }
    }

    proc K::is_version(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "-V") == 1 {
            return 1;
        } else {
            if LinkerHost::K::str_eq(arg, "--version") == 1 {
                return 1;
            } else {
                return 0;
            }
        }
    }

    proc K::is_compat_no_value_flag(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "--eh-frame-hdr") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--fatal-warnings") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--no-fatal-warnings") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--color-diagnostics") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--no-color-diagnostics") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--stats") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--print-gc-sections") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--no-print-gc-sections") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--icf=none") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--icf=safe") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--icf=all") == 1 { return 1; }
        return 0;
    }

    proc K::is_extended_compat_no_value_flag(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "--print-map") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--emit-relocs") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--export-dynamic") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "-E") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--start-lib") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--end-lib") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--gdb-index") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--warn-common") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--no-undefined-version") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--strip-all") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--warn-unresolved-symbols") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--no-warn-unresolved-symbols") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--nmagic") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--omagic") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--discard-all") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--discard-locals") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--undefined-version") == 1 { return 1; }
        return 0;
    }

    proc K::is_compat_value_flag(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "--hash-style") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--threads") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--thread-count") == 1 { return 1; }
        return 0;
    }

    proc K::is_extended_compat_value_flag(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "--version-script") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--dynamic-list") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--trace-symbol") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--dependency-file") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--compress-debug-sections") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--pack-dyn-relocs") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--plugin-opt") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--mllvm") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--thinlto-cache-dir") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--thinlto-jobs") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--thinlto-cache-policy") == 1 { return 1; }
        return 0;
    }

    proc K::resolve_oformat(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "elf64") == 1 { return FORMAT_ELF64; }
        if LinkerHost::K::str_eq(arg, "elf64-x86-64") == 1 { return FORMAT_ELF64; }
        if LinkerHost::K::str_eq(arg, "binary") == 1 { return FORMAT_BINARY; }
        if LinkerHost::K::str_eq(arg, "bin") == 1 { return FORMAT_BINARY; }
        if LinkerHost::K::str_eq(arg, "mbr") == 1 { return FORMAT_MBR; }
        if LinkerHost::K::str_eq(arg, "pe") == 1 { return FORMAT_PE64; }
        if LinkerHost::K::str_eq(arg, "pei-x86-64") == 1 { return FORMAT_PE64; }
        if LinkerHost::K::str_eq(arg, "pe-x86-64") == 1 { return FORMAT_PE64; }
        if LinkerHost::K::str_eq(arg, "macho64") == 1 { return FORMAT_MACHO64; }
        if LinkerHost::K::str_eq(arg, "mach-o") == 1 { return FORMAT_MACHO64; }
        if LinkerHost::K::str_eq(arg, "macho-x86-64") == 1 { return FORMAT_MACHO64; }
        return 0;
    }

    proc K::resolve_target(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "x86_64-linux") == 1 { return TARGET_X86_64_LINUX; }
        if LinkerHost::K::str_eq(arg, "x86_64-linux-gnu") == 1 { return TARGET_X86_64_LINUX; }
        if LinkerHost::K::str_eq(arg, "x86_64-unknown-linux-gnu") == 1 { return TARGET_X86_64_LINUX; }
        if LinkerHost::K::str_eq(arg, "x86_64-linux-musl") == 1 { return TARGET_X86_64_LINUX; }
        if LinkerHost::K::str_eq(arg, "x86_64-unknown-linux-musl") == 1 { return TARGET_X86_64_LINUX; }
        if LinkerHost::K::str_eq(arg, "x86_64-alpine-linux-musl") == 1 { return TARGET_X86_64_LINUX; }
        if LinkerHost::K::str_eq(arg, "aarch64-linux") == 1 { return TARGET_AARCH64_LINUX; }
        if LinkerHost::K::str_eq(arg, "aarch64-linux-gnu") == 1 { return TARGET_AARCH64_LINUX; }
        if LinkerHost::K::str_eq(arg, "aarch64-unknown-linux-gnu") == 1 { return TARGET_AARCH64_LINUX; }
        if LinkerHost::K::str_eq(arg, "aarch64-linux-musl") == 1 { return TARGET_AARCH64_LINUX; }
        if LinkerHost::K::str_eq(arg, "aarch64-unknown-linux-musl") == 1 { return TARGET_AARCH64_LINUX; }
        if LinkerHost::K::str_eq(arg, "elf_x86_64") == 1 { return TARGET_X86_64_LINUX; }
        if LinkerHost::K::str_eq(arg, "elf64-x86-64") == 1 { return TARGET_X86_64_LINUX; }
        if LinkerHost::K::str_eq(arg, "elf64-littleaarch64") == 1 { return TARGET_AARCH64_LINUX; }
        if LinkerHost::K::str_eq(arg, "aarch64elf") == 1 { return TARGET_AARCH64_LINUX; }

        if LinkerHost::K::str_eq(arg, "x86_64-windows-msvc") == 1 { return TARGET_X86_64_WINDOWS; }
        if LinkerHost::K::str_eq(arg, "x86_64-pc-windows-msvc") == 1 { return TARGET_X86_64_WINDOWS; }
        if LinkerHost::K::str_eq(arg, "x86_64-windows-gnu") == 1 { return TARGET_X86_64_WINDOWS; }
        if LinkerHost::K::str_eq(arg, "x86_64-pc-windows-gnu") == 1 { return TARGET_X86_64_WINDOWS; }
        if LinkerHost::K::str_eq(arg, "aarch64-windows-msvc") == 1 { return TARGET_AARCH64_WINDOWS; }
        if LinkerHost::K::str_eq(arg, "aarch64-pc-windows-msvc") == 1 { return TARGET_AARCH64_WINDOWS; }
        if LinkerHost::K::str_eq(arg, "aarch64-windows-gnu") == 1 { return TARGET_AARCH64_WINDOWS; }
        if LinkerHost::K::str_eq(arg, "aarch64-pc-windows-gnu") == 1 { return TARGET_AARCH64_WINDOWS; }
        if LinkerHost::K::str_eq(arg, "i386pep") == 1 { return TARGET_X86_64_WINDOWS; }
        if LinkerHost::K::str_eq(arg, "pep") == 1 { return TARGET_X86_64_WINDOWS; }
        if LinkerHost::K::str_eq(arg, "pe-x86-64") == 1 { return TARGET_X86_64_WINDOWS; }
        if LinkerHost::K::str_eq(arg, "arm64pe") == 1 { return TARGET_AARCH64_WINDOWS; }

        if LinkerHost::K::str_eq(arg, "x86_64-apple-darwin") == 1 { return TARGET_X86_64_MACOS; }
        if LinkerHost::K::str_eq(arg, "x86_64-macos") == 1 { return TARGET_X86_64_MACOS; }
        if LinkerHost::K::str_eq(arg, "mach_o_x86_64") == 1 { return TARGET_X86_64_MACOS; }
        if LinkerHost::K::str_eq(arg, "macho-x86-64") == 1 { return TARGET_X86_64_MACOS; }
        if LinkerHost::K::str_eq(arg, "aarch64-apple-darwin") == 1 { return TARGET_AARCH64_MACOS; }
        if LinkerHost::K::str_eq(arg, "arm64-apple-darwin") == 1 { return TARGET_AARCH64_MACOS; }
        if LinkerHost::K::str_eq(arg, "arm64-macos") == 1 { return TARGET_AARCH64_MACOS; }
        if LinkerHost::K::str_eq(arg, "macho-arm64") == 1 { return TARGET_AARCH64_MACOS; }

        if LinkerHost::K::str_eq(arg, "x86_64-none") == 1 { return TARGET_NONE; }
        if LinkerHost::K::str_eq(arg, "x86_64-unknown-none-elf") == 1 { return TARGET_NONE; }
        if LinkerHost::K::str_eq(arg, "x86_64-pc-none-elf") == 1 { return TARGET_NONE; }
        if LinkerHost::K::str_eq(arg, "aarch64-none") == 1 { return TARGET_AARCH64_LINUX; }
        if LinkerHost::K::str_eq(arg, "aarch64-unknown-none-elf") == 1 { return TARGET_AARCH64_LINUX; }
        if LinkerHost::K::str_eq(arg, "aarch64-pc-none-elf") == 1 { return TARGET_AARCH64_LINUX; }
        return 0;
    }

    proc K::resolve_unresolved_policy(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "report-all") == 1 { return UNRESOLVED_POLICY_REPORT_ALL; }
        if LinkerHost::K::str_eq(arg, "ignore-all") == 1 { return UNRESOLVED_POLICY_IGNORE_ALL; }
        if LinkerHost::K::str_eq(arg, "ignore-in-object-files") == 1 { return UNRESOLVED_POLICY_IGNORE_IN_OBJECT_FILES; }
        if LinkerHost::K::str_eq(arg, "ignore-in-shared-libs") == 1 { return UNRESOLVED_POLICY_IGNORE_IN_SHARED_LIBS; }
        return 4294967295;
    }

    proc K::default_format_for_target(target: UInt32) -> UInt32 {
        if target == TARGET_X86_64_WINDOWS {
            return FORMAT_PE64;
        } else {
            if target == TARGET_AARCH64_WINDOWS {
                return FORMAT_PE64;
            } else {
                if target == TARGET_X86_64_MACOS {
                    return FORMAT_MACHO64;
                } else {
                    if target == TARGET_AARCH64_MACOS {
                        return FORMAT_MACHO64;
                    } else {
                        return FORMAT_ELF64;
                    }
                }
            }
        }
    }

    proc K::emit_usage() -> UInt32 {
        LinkerHost::K::print_line("dustlink (Dust internal linker)");
        LinkerHost::K::print_line("usage: dustlink [options] <inputs>");
        LinkerHost::K::print_line("  -o, --output <path>");
        LinkerHost::K::print_line("  -e, --entry <addr>");
        LinkerHost::K::print_line("  --image-base <addr>");
        LinkerHost::K::print_line("  -Ttext <addr>");
        LinkerHost::K::print_line("  -T <script>, --script <script>");
        LinkerHost::K::print_line("  --oformat <elf64|binary|mbr|pe|macho64>");
        LinkerHost::K::print_line("  -L/-l and --library-path/--library");
        LinkerHost::K::print_line("  --sysroot <path>  -rpath <path>  -rpath-link <path>");
        LinkerHost::K::print_line("  -Map/--map-file");
        LinkerHost::K::print_line("  --target=<triple> | -m<emulation>");
        LinkerHost::K::print_line("  --defsym=name=value");
        LinkerHost::K::print_line("  -u/--undefined/--require-defined <symbol>");
        LinkerHost::K::print_line("  --unresolved-symbols <report-all|ignore-all|ignore-in-object-files|ignore-in-shared-libs>");
        LinkerHost::K::print_line("  --warn-unresolved-symbols/--no-warn-unresolved-symbols");
        LinkerHost::K::print_line("  --start-group ... --end-group");
        LinkerHost::K::print_line("  --push-state ... --pop-state");
        LinkerHost::K::print_line("  -shared/-pie/--no-pie/-static/-Bstatic/-Bdynamic");
        LinkerHost::K::print_line("  --dynamic-linker <path>  --soname <name>");
        LinkerHost::K::print_line("  --enable-new-dtags/--disable-new-dtags");
        LinkerHost::K::print_line("  --copy-dt-needed-entries/--no-copy-dt-needed-entries");
        LinkerHost::K::print_line("  --build-id[=<none|fast|md5|sha1|uuid|0x...>]");
        LinkerHost::K::print_line("  -z <relro|norelro|now|lazy|execstack|noexecstack>");
        LinkerHost::K::print_line("  --version-script <file>  --dynamic-list <file>");
        LinkerHost::K::print_line("  --trace/-t  --no-trace  --trace-symbol <name>  --print-map");
        LinkerHost::K::print_line("  --start-lib/--end-lib  --emit-relocs  --strip-all");
        LinkerHost::K::print_line("  lld-link forms: /OUT:<path> /ENTRY:<sym|addr> /MACHINE:<arch>");
        LinkerHost::K::print_line("  lld-link forms: /LIBPATH:<dir> /DEFAULTLIB:<name> /DLL /SUBSYSTEM:<kind>");
        return ERR_OK;
    }

    proc K::emit_version() -> UInt32 {
        LinkerHost::K::print_line("dustlink version 0.5");
        return ERR_OK;
    }

    proc K::error_prefix() -> UInt64 {
        if DustLink::K::get_color_diagnostics() == 1 {
            return "dustlink[color]: error: ";
        } else {
            return "dustlink: error: ";
        }
    }

    proc K::warning_prefix() -> UInt64 {
        if DustLink::K::get_color_diagnostics() == 1 {
            return "dustlink[color]: warning: ";
        } else {
            return "dustlink: warning: ";
        }
    }

    proc K::emit_error_with_arg(prefix: UInt64, arg: UInt64) -> UInt32 {
        let msg = LinkerFs::K::str_concat(prefix, arg);
        return LinkerHost::K::print_line(msg);
    }

    proc K::emit_unsupported_flag(arg: UInt64) -> UInt32 {
        let p1 = LinkerFs::K::str_concat(error_prefix(), "unsupported flag: ");
        return emit_error_with_arg(p1, arg);
    }

    proc K::emit_unsupported_target(arg: UInt64) -> UInt32 {
        let p1 = LinkerFs::K::str_concat(error_prefix(), "unsupported target: ");
        return emit_error_with_arg(p1, arg);
    }

    proc K::handle_compat_noop(arg: UInt64) -> UInt32 {
        if DustLink::K::get_fatal_warnings() == 1 {
            let p1 = LinkerFs::K::str_concat(error_prefix(), "compatibility flag rejected in fatal mode: ");
            emit_error_with_arg(p1, arg);
            return ERR_UNSUPPORTED_FLAG;
        }
        let p2 = LinkerFs::K::str_concat(warning_prefix(), "compatibility no-op accepted: ");
        emit_error_with_arg(p2, arg);
        return ERR_OK;
    }

    proc K::inline_output_value(arg: UInt64) -> UInt64 {
