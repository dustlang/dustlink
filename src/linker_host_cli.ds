        if LinkerHost::K::str_eq(arg, "-e") == 1 {
            return 1;
        } else {
            if LinkerHost::K::str_eq(arg, "--entry") == 1 {
                return 1;
            } else {
                if LinkerHost::K::str_eq(arg, "--entry-point") == 1 {
                    return 1;
                } else {
                    return 0;
