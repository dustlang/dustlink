    proc K::is_undefined_flag(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "-u") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--undefined") == 1 { return 1; }
        if LinkerHost::K::str_eq(arg, "--require-defined") == 1 { return 1; }
        return 0;
    }

    proc K::is_no_undefined_flag(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "--no-undefined") == 1 { return 1; }
