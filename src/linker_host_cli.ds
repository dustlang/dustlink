// Host CLI dispatch for dustlink.

forge LinkerHost {
    proc K::args_count() -> UInt32 {
        return host_args_count();
    }

    proc K::arg_at(index: UInt32) -> UInt64 {
        return host_arg_at(index);
    }

    proc K::str_eq(lhs: UInt64, rhs: UInt64) -> UInt32 {
        return host_str_eq(lhs, rhs);
    }

    proc K::str_starts_with(text: UInt64, prefix: UInt64) -> UInt32 {
        return host_str_starts_with(text, prefix);
    }

    proc K::str_after_prefix(text: UInt64, prefix: UInt64) -> UInt64 {
        return host_str_after_prefix(text, prefix);
    }

    proc K::parse_u64(text: UInt64, base: UInt32) -> UInt64 {
        return host_parse_u64(text, base);
    }

    proc K::print_line(text: UInt64) -> UInt32 {
        return host_print_line(text);
    }
}

forge LinkerHostCli {
    const ERR_OK: UInt32 = 0;
    const ERR_INVALID_FORMAT: UInt32 = 2;
    const ERR_INVALID_ADDRESS: UInt32 = 8;
    const ERR_INVALID_ENTRY: UInt32 = 9;
    const ERR_UNSUPPORTED_FLAG: UInt32 = 12;
    const ERR_UNSUPPORTED_TARGET: UInt32 = 14;
    const ERR_MISSING_FLAG_VALUE: UInt32 = 13;
    const ERR_EMPTY_INPUT: UInt32 = 15;
    const ERR_CONFLICTING_OPTIONS: UInt32 = 16;

    const FORMAT_ELF64: UInt32 = 1;
    const FORMAT_BINARY: UInt32 = 2;
    const FORMAT_MBR: UInt32 = 3;
    const FORMAT_PE64: UInt32 = 4;
    const FORMAT_MACHO64: UInt32 = 5;

    const TARGET_X86_64_NONE: UInt32 = 0;
    const TARGET_X86_64_LINUX: UInt32 = 1;
    const TARGET_X86_64_WINDOWS: UInt32 = 2;
    const TARGET_X86_64_MACOS: UInt32 = 3;

    const DEFAULT_OUTPUT: UInt64 = 1;
    const DEFAULT_ENTRY: UInt64 = 1048576;
    const DEFAULT_BASE: UInt64 = 65536;

    proc K::is_output_flag(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "-o") == 1 {
            return 1;
        } else {
            if LinkerHost::K::str_eq(arg, "--output") == 1 {
                return 1;
            } else {
                return 0;
            }
        }
    }

    proc K::is_oformat_flag(arg: UInt64) -> UInt32 {
        if LinkerHost::K::str_eq(arg, "--oformat") == 1 {
