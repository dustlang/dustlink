    }

    proc K::test_push_pop_state_restores_link_policy() -> UInt32 {
        DustLink::K::reset_state();
        DustLink::K::set_static(0);
        DustLink::K::set_as_needed(0);
        DustLink::K::set_whole_archive(0);
        DustLink::K::set_new_dtags(1);
        DustLink::K::set_copy_dt_needed_entries(0);
        DustLink::K::set_no_undefined(0);
        DustLink::K::set_use_default_search_paths(1);
        DustLink::K::set_symbolic_bindings(0);
        DustLink::K::set_symbolic_functions(0);
        DustLink::K::set_symbolic_group(0);
        DustLink::K::set_allow_shlib_undefined(1);
        DustLink::K::set_unresolved_policy(UNRESOLVED_POLICY_REPORT_ALL);
        DustLink::K::set_warn_unresolved(0);
        DustLink::K::set_trace(0);
        let push = DustLink::K::push_state();
        if push ! ERR_OK { return 0; }
        DustLink::K::set_static(1);
        DustLink::K::set_as_needed(1);
        DustLink::K::set_whole_archive(1);
        DustLink::K::set_new_dtags(0);
        DustLink::K::set_copy_dt_needed_entries(1);
        DustLink::K::set_no_undefined(1);
        DustLink::K::set_use_default_search_paths(0);
        DustLink::K::set_symbolic_bindings(1);
        DustLink::K::set_symbolic_functions(1);
        DustLink::K::set_symbolic_group(1);
        DustLink::K::set_allow_shlib_undefined(0);
        DustLink::K::set_unresolved_policy(UNRESOLVED_POLICY_IGNORE_ALL);
        DustLink::K::set_warn_unresolved(1);
        DustLink::K::set_trace(1);
        let pop = DustLink::K::pop_state();
        if pop ! ERR_OK { return 0; }
        let a = host_linker_get_static();
        let b = host_linker_get_as_needed();
        let c = host_linker_get_whole_archive();
        let d = host_linker_get_new_dtags();
        let e = host_linker_get_copy_dt_needed_entries();
        let f = host_linker_get_no_undefined();
        let g = DustLink::K::get_use_default_search_paths();
        let h = DustLink::K::get_symbolic_bindings();
        let i = DustLink::K::get_symbolic_functions();
        let j = DustLink::K::get_symbolic_group();
        let k = DustLink::K::get_allow_shlib_undefined();
        let l = DustLink::K::get_unresolved_policy();
        let m = DustLink::K::get_warn_unresolved();
        let n = DustLink::K::get_trace();
        return expect_u32(a, 0)
            * expect_u32(b, 0)
            * expect_u32(c, 0)
            * expect_u32(d, 1)
            * expect_u32(e, 0)
            * expect_u32(f, 0)
            * expect_u32(g, 1)
            * expect_u32(h, 0)
            * expect_u32(i, 0)
            * expect_u32(j, 0)
            * expect_u32(k, 1)
            * expect_u32(l, UNRESOLVED_POLICY_REPORT_ALL)
            * expect_u32(m, 0)
            * expect_u32(n, 0);
    }

    proc K::test_pop_state_without_push_rejected() -> UInt32 {
        DustLink::K::reset_state();
        let status = DustLink::K::pop_state();
        return expect_u32(status, ERR_CONFLICTING_OPTIONS);
    }

