// Build-id and -z semantic behavior tests.

forge LinkerBuildIdZTests {
    const ERR_OK: UInt32 = 0;
    const ERR_UNSUPPORTED_FLAG: UInt32 = 12;
    const ERR_CONFLICTING_OPTIONS: UInt32 = 16;

    const BUILD_ID_MODE_NONE: UInt32 = 0;
    const BUILD_ID_MODE_FAST: UInt32 = 1;
    const BUILD_ID_MODE_SHA1: UInt32 = 3;
    const BUILD_ID_MODE_HEX: UInt32 = 5;

    proc K::expect_u32(actual: UInt32, expected: UInt32) -> UInt32 {
        if actual == expected {
            return 1;
        } else {
            return 0;
        }
    }

    proc K::test_build_id_default_mode() -> UInt32 {
        DustLink::K::reset_state();
        let status = DustLink::K::enable_build_id_default();
        if status ! ERR_OK {
            return 0;
        } else {
            let mode = host_linker_get_build_id_mode();
            return expect_u32(mode, BUILD_ID_MODE_FAST);
        }
    }

    proc K::test_build_id_sha1_mode() -> UInt32 {
        DustLink::K::reset_state();
        let status = DustLink::K::set_build_id("sha1");
        if status ! ERR_OK {
            return 0;
        } else {
            let mode = host_linker_get_build_id_mode();
            return expect_u32(mode, BUILD_ID_MODE_SHA1);
        }
    }

    proc K::test_build_id_none_mode() -> UInt32 {
        DustLink::K::reset_state();
        let status = DustLink::K::set_build_id("none");
        if status ! ERR_OK {
            return 0;
        } else {
            let mode = host_linker_get_build_id_mode();
            return expect_u32(mode, BUILD_ID_MODE_NONE);
        }
    }

    proc K::test_build_id_hex_mode() -> UInt32 {
        DustLink::K::reset_state();
        let status = DustLink::K::set_build_id("0xA1B2C3D4");
        if status ! ERR_OK {
            return 0;
        } else {
            let mode = host_linker_get_build_id_mode();
            return expect_u32(mode, BUILD_ID_MODE_HEX);
        }
    }

    proc K::test_z_relro_now_flags() -> UInt32 {
        DustLink::K::reset_state();
        let s1 = DustLink::K::set_z_option("relro");
        if s1 ! ERR_OK {
            return 0;
        }
        let s2 = DustLink::K::set_z_option("now");
        if s2 ! ERR_OK {
            return 0;
        }
        let flags = host_linker_get_z_flags();
        let has_relro = flags & 1;
        let has_now = flags & 2;
        return expect_u32(has_relro, 1) * expect_u32(has_now, 2);
    }

    proc K::test_z_execstack_toggle() -> UInt32 {
        DustLink::K::reset_state();
        let s1 = DustLink::K::set_z_option("execstack");
        if s1 ! ERR_OK {
            return 0;
        }
        let flags_on = host_linker_get_z_flags();
        let exec_on = flags_on & 4;
        let s2 = DustLink::K::set_z_option("noexecstack");
        if s2 ! ERR_OK {
            return 0;
        }
        let flags_off = host_linker_get_z_flags();
        let exec_off = flags_off & 4;
        return expect_u32(exec_on, 4) * expect_u32(exec_off, 0);
    }

    proc K::test_z_invalid_rejected() -> UInt32 {
        DustLink::K::reset_state();
        let status = DustLink::K::set_z_option("badflag");
        return expect_u32(status, ERR_UNSUPPORTED_FLAG);
    }

    proc K::test_z_defs_undefs_toggle_no_undefined() -> UInt32 {
        DustLink::K::reset_state();
        let defs = DustLink::K::set_z_option("defs");
        if defs ! ERR_OK {
            return 0;
        }
        let a = host_linker_get_no_undefined();
        let undefs = DustLink::K::set_z_option("undefs");
        if undefs ! ERR_OK {
            return 0;
        }
        let b = host_linker_get_no_undefined();
        return expect_u32(a, 1) * expect_u32(b, 0);
    }

    proc K::test_z_text_family_accepted() -> UInt32 {
        DustLink::K::reset_state();
        let s1 = DustLink::K::set_z_option("text");
        if s1 ! ERR_OK {
            return 0;
        }
        let s2 = DustLink::K::set_z_option("notext");
        if s2 ! ERR_OK {
            return 0;
        }
        let s3 = DustLink::K::set_z_option("origin");
        return expect_u32(s3, ERR_OK);
    }

    proc K::test_z_extended_compat_tokens_accepted() -> UInt32 {
        DustLink::K::reset_state();
        let s1 = DustLink::K::set_z_option("separate-code");
        if s1 ! ERR_OK { return 0; }
        let s2 = DustLink::K::set_z_option("pack-relative-relocs");
        if s2 ! ERR_OK { return 0; }
        let s3 = DustLink::K::set_z_option("max-page-size=0x1000");
        if s3 ! ERR_OK { return 0; }
        let s4 = DustLink::K::set_z_option("common-page-size=0x1000");
        if s4 ! ERR_OK { return 0; }
        let s5 = DustLink::K::set_z_option("stack-size=0x400000");
        return expect_u32(s5, ERR_OK);
    }

    proc K::test_z_muldefs_nomuldefs_toggle() -> UInt32 {
        DustLink::K::reset_state();
        let s1 = DustLink::K::set_z_option("muldefs");
        if s1 ! ERR_OK { return 0; }
        let a = host_linker_get_allow_multiple_definition();
        let s2 = DustLink::K::set_z_option("nomuldefs");
        if s2 ! ERR_OK { return 0; }
        let b = host_linker_get_allow_multiple_definition();
        return expect_u32(a, 1) * expect_u32(b, 0);
    }

    proc K::test_dynamic_mode_toggles() -> UInt32 {
        DustLink::K::reset_state();
        let s1 = DustLink::K::set_shared(1);
        if s1 ! ERR_OK {
            return 0;
        }
        let p1 = DustLink::K::set_pie(1);
        if p1 ! ERR_OK {
            return 0;
        }
        let st1 = DustLink::K::set_static(1);
        if st1 ! ERR_OK {
            return 0;
        }
        let as1 = DustLink::K::set_as_needed(1);
        if as1 ! ERR_OK {
            return 0;
        }
        let shared = host_linker_get_shared();
        let pie = host_linker_get_pie();
        let static_mode = host_linker_get_static();
        let as_needed = host_linker_get_as_needed();
        return expect_u32(shared, 1) * expect_u32(pie, 1) * expect_u32(static_mode, 1) * expect_u32(as_needed, 1);
    }

    proc K::test_dynamic_linker_and_soname_set() -> UInt32 {
        DustLink::K::reset_state();
        let d = DustLink::K::set_dynamic_linker("/lib64/ld-linux-x86-64.so.2");
        if d ! ERR_OK {
            return 0;
        }
        let s = DustLink::K::set_soname("libxdv.so");
        if s ! ERR_OK {
            return 0;
        }
        let dyn = host_linker_get_dynamic_linker();
        let soname = host_linker_get_soname();
        return expect_u32(LinkerFs::K::str_eq(dyn, "/lib64/ld-linux-x86-64.so.2"), 1)
            * expect_u32(LinkerFs::K::str_eq(soname, "libxdv.so"), 1);
    }

    proc K::test_needed_library_note_normalization() -> UInt32 {
        DustLink::K::reset_state();
        DustLink::K::set_static(0);
        DustLink::K::set_as_needed(0);
        let status = host_linker_note_needed_library("m", "C:\\libs\\libm.a", 1);
        if status ! ERR_OK {
            return 0;
        } else {
            let count = host_linker_needed_library_count();
            if count ! 1 {
                return 0;
            } else {
                let needed = host_linker_get_needed_library(0);
                return expect_u32(LinkerFs::K::str_eq(needed, "libm.so"), 1);
            }
        }
    }

    proc K::test_as_needed_skips_unused_library() -> UInt32 {
        DustLink::K::reset_state();
        DustLink::K::set_static(0);
        DustLink::K::set_as_needed(1);
        let status = host_linker_note_needed_library("z", "C:\\libs\\libz.a", 0);
        if status ! ERR_OK {
            return 0;
        } else {
            let count = host_linker_needed_library_count();
            return expect_u32(count, 0);
        }
    }

    proc K::test_static_mode_skips_needed_library() -> UInt32 {
        DustLink::K::reset_state();
        DustLink::K::set_static(1);
        DustLink::K::set_as_needed(0);
        let status = host_linker_note_needed_library("c", "C:\\libs\\libc.a", 1);
        if status ! ERR_OK {
            return 0;
        } else {
            let count = host_linker_needed_library_count();
            return expect_u32(count, 0);
        }
    }

    proc K::test_no_undefined_toggle() -> UInt32 {
        DustLink::K::reset_state();
        let on = DustLink::K::set_no_undefined(1);
        if on ! ERR_OK {
            return 0;
        }
        let a = host_linker_get_no_undefined();
        let off = DustLink::K::set_no_undefined(0);
        if off ! ERR_OK {
            return 0;
        }
        let b = host_linker_get_no_undefined();
        return expect_u32(a, 1) * expect_u32(b, 0);
    }

    proc K::test_dynamic_unresolved_policy_gate() -> UInt32 {
        DustLink::K::reset_state();
        DustLink::K::set_static(0);
        DustLink::K::set_no_undefined(0);
        let before = host_linker_allow_dynamic_unresolved();
        let note = host_linker_note_needed_library("m", "libm.so", 1);
        if note ! ERR_OK {
            return 0;
        }
        let during = host_linker_allow_dynamic_unresolved();
        DustLink::K::set_no_undefined(1);
        let forced = host_linker_allow_dynamic_unresolved();
        return expect_u32(before, 0) * expect_u32(during, 1) * expect_u32(forced, 0);
    }

    proc K::test_whole_archive_toggle() -> UInt32 {
        DustLink::K::reset_state();
        let on = DustLink::K::set_whole_archive(1);
        if on ! ERR_OK {
            return 0;
        }
        let a = host_linker_get_whole_archive();
        let off = DustLink::K::set_whole_archive(0);
        if off ! ERR_OK {
            return 0;
        }
        let b = host_linker_get_whole_archive();
        return expect_u32(a, 1) * expect_u32(b, 0);
    }

    proc K::test_push_pop_state_restores_link_policy() -> UInt32 {
        DustLink::K::reset_state();
        DustLink::K::set_static(0);
        DustLink::K::set_as_needed(0);
        DustLink::K::set_whole_archive(0);
        DustLink::K::set_new_dtags(1);
        DustLink::K::set_copy_dt_needed_entries(0);
        DustLink::K::set_no_undefined(0);
        let push = DustLink::K::push_state();
        if push ! ERR_OK { return 0; }
        DustLink::K::set_static(1);
        DustLink::K::set_as_needed(1);
        DustLink::K::set_whole_archive(1);
        DustLink::K::set_new_dtags(0);
        DustLink::K::set_copy_dt_needed_entries(1);
        DustLink::K::set_no_undefined(1);
        let pop = DustLink::K::pop_state();
        if pop ! ERR_OK { return 0; }
        let a = host_linker_get_static();
        let b = host_linker_get_as_needed();
        let c = host_linker_get_whole_archive();
        let d = host_linker_get_new_dtags();
        let e = host_linker_get_copy_dt_needed_entries();
        let f = host_linker_get_no_undefined();
        return expect_u32(a, 0)
            * expect_u32(b, 0)
            * expect_u32(c, 0)
            * expect_u32(d, 1)
            * expect_u32(e, 0)
            * expect_u32(f, 0);
    }

    proc K::test_pop_state_without_push_rejected() -> UInt32 {
        DustLink::K::reset_state();
        let status = DustLink::K::pop_state();
        return expect_u32(status, ERR_CONFLICTING_OPTIONS);
    }

    proc K::test_sysroot_roundtrip() -> UInt32 {
        DustLink::K::reset_state();
        let status = DustLink::K::set_sysroot("/opt/xdv-sysroot");
        if status ! ERR_OK {
            return 0;
        } else {
            let sysroot = host_linker_get_sysroot();
            return expect_u32(LinkerFs::K::str_eq(sysroot, "/opt/xdv-sysroot"), 1);
        }
    }

    proc K::test_rpath_roundtrip() -> UInt32 {
        DustLink::K::reset_state();
        let status = DustLink::K::add_rpath("/opt/runtime/lib");
        if status ! ERR_OK {
            return 0;
        } else {
            let count = host_linker_rpath_count();
            if count ! 1 {
                return 0;
            } else {
                let path = host_linker_get_rpath(0);
                return expect_u32(LinkerFs::K::str_eq(path, "/opt/runtime/lib"), 1);
            }
        }
    }

    proc K::test_rpath_link_roundtrip() -> UInt32 {
        DustLink::K::reset_state();
        let status = DustLink::K::add_rpath_link("/opt/link/lib");
        if status ! ERR_OK {
            return 0;
        } else {
            let count = host_linker_rpath_link_count();
            if count ! 1 {
                return 0;
            } else {
                let path = host_linker_get_rpath_link(0);
                return expect_u32(LinkerFs::K::str_eq(path, "/opt/link/lib"), 1);
            }
        }
    }

    proc K::test_new_dtags_toggle() -> UInt32 {
        DustLink::K::reset_state();
        let off = DustLink::K::set_new_dtags(0);
        if off ! ERR_OK {
            return 0;
        }
        let a = host_linker_get_new_dtags();
        let on = DustLink::K::set_new_dtags(1);
        if on ! ERR_OK {
            return 0;
        }
        let b = host_linker_get_new_dtags();
        return expect_u32(a, 0) * expect_u32(b, 1);
    }

    proc K::test_copy_dt_needed_entries_toggle() -> UInt32 {
        DustLink::K::reset_state();
        let on = DustLink::K::set_copy_dt_needed_entries(1);
        if on ! ERR_OK {
            return 0;
        }
        let a = host_linker_get_copy_dt_needed_entries();
        let off = DustLink::K::set_copy_dt_needed_entries(0);
        if off ! ERR_OK {
            return 0;
        }
        let b = host_linker_get_copy_dt_needed_entries();
        return expect_u32(a, 1) * expect_u32(b, 0);
    }

    proc K::test_pe_compat_toggle_state() -> UInt32 {
        DustLink::K::reset_state();
        let a = DustLink::K::set_pe_no_entry(1);
        if a ! ERR_OK { return 0; }
        let b = DustLink::K::set_pe_dynamic_base(1);
        if b ! ERR_OK { return 0; }
        let c = DustLink::K::set_pe_nx_compat(1);
        if c ! ERR_OK { return 0; }
        let d = DustLink::K::set_pe_large_address_aware(1);
        if d ! ERR_OK { return 0; }
        let no_entry = host_linker_get_pe_no_entry();
        let dynamic_base = host_linker_get_pe_dynamic_base();
        let nx = host_linker_get_pe_nx_compat();
        let laa = host_linker_get_pe_large_address_aware();
        return expect_u32(no_entry, 1)
            * expect_u32(dynamic_base, 1)
            * expect_u32(nx, 1)
            * expect_u32(laa, 1);
    }

    proc K::run_all_tests() -> UInt32 {
        let passed =
            test_build_id_default_mode()
            + test_build_id_sha1_mode()
            + test_build_id_none_mode()
            + test_build_id_hex_mode()
            + test_z_relro_now_flags()
            + test_z_execstack_toggle()
            + test_z_invalid_rejected()
            + test_z_defs_undefs_toggle_no_undefined()
            + test_z_text_family_accepted()
            + test_z_extended_compat_tokens_accepted()
            + test_z_muldefs_nomuldefs_toggle()
            + test_dynamic_mode_toggles()
            + test_dynamic_linker_and_soname_set()
            + test_needed_library_note_normalization()
            + test_as_needed_skips_unused_library()
            + test_static_mode_skips_needed_library()
            + test_no_undefined_toggle()
            + test_dynamic_unresolved_policy_gate()
            + test_whole_archive_toggle()
            + test_push_pop_state_restores_link_policy()
            + test_pop_state_without_push_rejected()
            + test_sysroot_roundtrip()
            + test_rpath_roundtrip()
            + test_rpath_link_roundtrip()
            + test_new_dtags_toggle()
            + test_copy_dt_needed_entries_toggle()
            + test_pe_compat_toggle_state();
        return passed;
    }
}
