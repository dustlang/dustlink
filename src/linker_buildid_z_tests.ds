        DustLink::K::reset_state();
        let s1 = DustLink::K::set_z_option("separate-code");
        if s1 ! ERR_OK { return 0; }
        let s2 = DustLink::K::set_z_option("pack-relative-relocs");
        if s2 ! ERR_OK { return 0; }
        let s3 = DustLink::K::set_z_option("max-page-size=0x1000");
        if s3 ! ERR_OK { return 0; }
        let s4 = DustLink::K::set_z_option("common-page-size=0x1000");
        if s4 ! ERR_OK { return 0; }
        let s5 = DustLink::K::set_z_option("stack-size=0x400000");
        return expect_u32(s5, ERR_OK);
    }

    proc K::test_z_muldefs_nomuldefs_toggle() -> UInt32 {
        DustLink::K::reset_state();
        let s1 = DustLink::K::set_z_option("muldefs");
        if s1 ! ERR_OK { return 0; }
        let a = host_linker_get_allow_multiple_definition();
        let s2 = DustLink::K::set_z_option("nomuldefs");
        if s2 ! ERR_OK { return 0; }
        let b = host_linker_get_allow_multiple_definition();
        return expect_u32(a, 1) * expect_u32(b, 0);
    }

    proc K::test_dynamic_mode_toggles() -> UInt32 {
        DustLink::K::reset_state();
        let s1 = DustLink::K::set_shared(1);
        if s1 ! ERR_OK {
            return 0;
        }
        let p1 = DustLink::K::set_pie(1);
        if p1 ! ERR_OK {
            return 0;
        }
        let st1 = DustLink::K::set_static(1);
        if st1 ! ERR_OK {
            return 0;
        }
        let as1 = DustLink::K::set_as_needed(1);
        if as1 ! ERR_OK {
            return 0;
        }
        let shared = host_linker_get_shared();
        let pie = host_linker_get_pie();
        let static_mode = host_linker_get_static();
        let as_needed = host_linker_get_as_needed();
        return expect_u32(shared, 1) * expect_u32(pie, 1) * expect_u32(static_mode, 1) * expect_u32(as_needed, 1);
    }

    proc K::test_symbolic_mode_toggles() -> UInt32 {
        DustLink::K::reset_state();
        let sb1 = DustLink::K::set_symbolic_bindings(1);
        if sb1 ! ERR_OK {
            return 0;
        }
        let sf1 = DustLink::K::set_symbolic_functions(1);
        if sf1 ! ERR_OK {
            return 0;
        }
        let a = DustLink::K::get_symbolic_bindings();
        let b = DustLink::K::get_symbolic_functions();
        let sb0 = DustLink::K::set_symbolic_bindings(0);
        if sb0 ! ERR_OK {
            return 0;
        }
        let sf0 = DustLink::K::set_symbolic_functions(0);
        if sf0 ! ERR_OK {
            return 0;
        }
        let c = DustLink::K::get_symbolic_bindings();
        let d = DustLink::K::get_symbolic_functions();
        return expect_u32(a, 1) * expect_u32(b, 1) * expect_u32(c, 0) * expect_u32(d, 0);
    }

    proc K::test_symbolic_group_toggle() -> UInt32 {
        DustLink::K::reset_state();
        let on = DustLink::K::set_symbolic_group(1);
        if on ! ERR_OK {
            return 0;
        }
        let a = DustLink::K::get_symbolic_group();
        let off = DustLink::K::set_symbolic_group(0);
        if off ! ERR_OK {
            return 0;
        }
        let b = DustLink::K::get_symbolic_group();
        return expect_u32(a, 1) * expect_u32(b, 0);
    }

    proc K::test_dynamic_flags_words_reflect_symbolic_and_z_semantics() -> UInt32 {
        DustLink::K::reset_state();
        let now = DustLink::K::set_z_option("now");
        if now ! ERR_OK { return 0; }
        let sb = DustLink::K::set_symbolic_bindings(1);
        if sb ! ERR_OK { return 0; }
        let sbf = DustLink::K::set_symbolic_functions(1);
        if sbf ! ERR_OK { return 0; }
        let bg = DustLink::K::set_symbolic_group(1);
        if bg ! ERR_OK { return 0; }
        let zo = DustLink::K::set_z_option("origin");
        if zo ! ERR_OK { return 0; }
        let zi = DustLink::K::set_z_option("interpose");
        if zi ! ERR_OK { return 0; }
        let zif = DustLink::K::set_z_option("initfirst");
        if zif ! ERR_OK { return 0; }
        let znd = DustLink::K::set_z_option("nodelete");
        if znd ! ERR_OK { return 0; }
        let znl = DustLink::K::set_z_option("nodlopen");
        if znl ! ERR_OK { return 0; }

        let flags = DustLink::K::get_dynamic_dt_flags();
        let flags1 = DustLink::K::get_dynamic_dt_flags_1();
        return expect_u64(flags & DF_BIND_NOW, DF_BIND_NOW)
            * expect_u64(flags & DF_SYMBOLIC, DF_SYMBOLIC)
            * expect_u64(flags1 & DF_1_NOW, DF_1_NOW)
            * expect_u64(flags1 & DF_1_GROUP, DF_1_GROUP)
            * expect_u64(flags1 & DF_1_ORIGIN, DF_1_ORIGIN)
            * expect_u64(flags1 & DF_1_INTERPOSE, DF_1_INTERPOSE)
            * expect_u64(flags1 & DF_1_INITFIRST, DF_1_INITFIRST)
            * expect_u64(flags1 & DF_1_NODELETE, DF_1_NODELETE)
            * expect_u64(flags1 & DF_1_NOOPEN, DF_1_NOOPEN);
    }

    proc K::test_dynamic_flags1_no_variants_clear_semantics() -> UInt32 {
        DustLink::K::reset_state();
        let a = DustLink::K::set_z_option("origin");
        if a ! ERR_OK { return 0; }
        let b = DustLink::K::set_z_option("interpose");
        if b ! ERR_OK { return 0; }
        let c = DustLink::K::set_z_option("initfirst");
        if c ! ERR_OK { return 0; }
        let d = DustLink::K::set_z_option("nodelete");
        if d ! ERR_OK { return 0; }
        let e = DustLink::K::set_z_option("nodlopen");
        if e ! ERR_OK { return 0; }
        let f = DustLink::K::set_z_option("noorigin");
        if f ! ERR_OK { return 0; }
        let g = DustLink::K::set_z_option("nointerpose");
        if g ! ERR_OK { return 0; }
        let h = DustLink::K::set_z_option("noinitfirst");
        if h ! ERR_OK { return 0; }
        let i = DustLink::K::set_z_option("nonodelete");
        if i ! ERR_OK { return 0; }
        let j = DustLink::K::set_z_option("nonodlopen");
        if j ! ERR_OK { return 0; }
        let flags1 = DustLink::K::get_dynamic_dt_flags_1();
        return expect_u64(flags1 & DF_1_ORIGIN, 0)
            * expect_u64(flags1 & DF_1_INTERPOSE, 0)
            * expect_u64(flags1 & DF_1_INITFIRST, 0)
            * expect_u64(flags1 & DF_1_NODELETE, 0)
            * expect_u64(flags1 & DF_1_NOOPEN, 0);
    }

    proc K::test_dynamic_linker_and_soname_set() -> UInt32 {
        DustLink::K::reset_state();
        let d = DustLink::K::set_dynamic_linker("/lib64/ld-linux-x86-64.so.2");
        if d ! ERR_OK {
            return 0;
        }
        let s = DustLink::K::set_soname("libxdv.so");
        if s ! ERR_OK {
            return 0;
        }
        let dyn = host_linker_get_dynamic_linker();
        let soname = host_linker_get_soname();
        return expect_u32(LinkerFs::K::str_eq(dyn, "/lib64/ld-linux-x86-64.so.2"), 1)
            * expect_u32(LinkerFs::K::str_eq(soname, "libxdv.so"), 1);
    }

    proc K::test_default_search_path_toggle() -> UInt32 {
        DustLink::K::reset_state();
        let a = DustLink::K::get_use_default_search_paths();
        let off = DustLink::K::set_use_default_search_paths(0);
        if off ! ERR_OK {
            return 0;
        }
        let b = DustLink::K::get_use_default_search_paths();
        let on = DustLink::K::set_use_default_search_paths(1);
        if on ! ERR_OK {
            return 0;
        }
        let c = DustLink::K::get_use_default_search_paths();
        return expect_u32(a, 1) * expect_u32(b, 0) * expect_u32(c, 1);
    }

    proc K::test_default_library_blocklist_roundtrip() -> UInt32 {
        DustLink::K::reset_state();
        let block = DustLink::K::block_default_library("kernel32.lib");
        if block ! ERR_OK {
            return 0;
        }
        let a = DustLink::K::is_default_library_blocked("kernel32.lib");
        let b = DustLink::K::is_default_library_blocked("kernel32");
        let c = DustLink::K::is_default_library_blocked("libkernel32.a");
        let d = DustLink::K::is_default_library_blocked("user32");
        return expect_u32(a, 1) * expect_u32(b, 1) * expect_u32(c, 1) * expect_u32(d, 0);
    }

    proc K::test_needed_library_note_normalization() -> UInt32 {
        DustLink::K::reset_state();
        DustLink::K::set_static(0);
        DustLink::K::set_as_needed(0);
        let status = host_linker_note_needed_library("m", "C:\\libs\\libm.a", 1);
        if status ! ERR_OK {
            return 0;
        } else {
            let count = host_linker_needed_library_count();
            if count ! 1 {
                return 0;
            } else {
                let needed = host_linker_get_needed_library(0);
                return expect_u32(LinkerFs::K::str_eq(needed, "libm.so"), 1);
            }
        }
    }

