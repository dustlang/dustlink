// File: linker_buildid_z_tests.ds - This file is part of the DPL Toolchain
// Copyright (c) 2026 Dust LLC, and Contributors
// Description:
//   Build-id and -z semantic behavior tests.
//   Provides test cases for:
//     - BUILD_ID_MODE_NONE, BUILD_ID_MODE_SHA1, BUILD_ID_MODE_SHA256
//     - z_relro, z_now, z_execstack options
//     - Build ID generation and embedding

forge LinkerBuildIdZTests {
    const ERR_OK: UInt32 = 0;
    const ERR_UNSUPPORTED_FLAG: UInt32 = 12;
    const ERR_CONFLICTING_OPTIONS: UInt32 = 16;

    const BUILD_ID_MODE_NONE: UInt32 = 0;
    const BUILD_ID_MODE_FAST: UInt32 = 1;
    const BUILD_ID_MODE_SHA1: UInt32 = 3;
    const BUILD_ID_MODE_HEX: UInt32 = 5;
    const DF_BIND_NOW: UInt64 = 8;
    const DF_SYMBOLIC: UInt64 = 2;
    const DF_1_NOW: UInt64 = 1;
    const DF_1_GROUP: UInt64 = 4;
    const DF_1_NODELETE: UInt64 = 8;
    const DF_1_INITFIRST: UInt64 = 32;
    const DF_1_NOOPEN: UInt64 = 64;
    const DF_1_ORIGIN: UInt64 = 128;
    const DF_1_INTERPOSE: UInt64 = 1024;
    const UNRESOLVED_POLICY_REPORT_ALL: UInt32 = 0;
    const UNRESOLVED_POLICY_IGNORE_ALL: UInt32 = 1;

    proc K::expect_u32(actual: UInt32, expected: UInt32) -> UInt32 {
        if actual == expected {
            return 1;
        } else {
            return 0;
        }
    }

    proc K::expect_u64(actual: UInt64, expected: UInt64) -> UInt32 {
        if actual == expected {
            return 1;
        } else {
            return 0;
        }
    }

    proc K::test_build_id_default_mode() -> UInt32 {
        DustLink::K::reset_state();
        let status = DustLink::K::enable_build_id_default();
        if status ! ERR_OK {
            return 0;
        } else {
            let mode = host_linker_get_build_id_mode();
            return expect_u32(mode, BUILD_ID_MODE_FAST);
        }
    }

    proc K::test_build_id_sha1_mode() -> UInt32 {
        DustLink::K::reset_state();
        let status = DustLink::K::set_build_id("sha1");
        if status ! ERR_OK {
            return 0;
        } else {
            let mode = host_linker_get_build_id_mode();
            return expect_u32(mode, BUILD_ID_MODE_SHA1);
        }
    }

    proc K::test_build_id_none_mode() -> UInt32 {
        DustLink::K::reset_state();
        let status = DustLink::K::set_build_id("none");
        if status ! ERR_OK {
            return 0;
        } else {
            let mode = host_linker_get_build_id_mode();
            return expect_u32(mode, BUILD_ID_MODE_NONE);
        }
    }

    proc K::test_build_id_hex_mode() -> UInt32 {
        DustLink::K::reset_state();
        let status = DustLink::K::set_build_id("0xA1B2C3D4");
        if status ! ERR_OK {
            return 0;
        } else {
            let mode = host_linker_get_build_id_mode();
            return expect_u32(mode, BUILD_ID_MODE_HEX);
        }
    }

    proc K::test_z_relro_now_flags() -> UInt32 {
        DustLink::K::reset_state();
        let s1 = DustLink::K::set_z_option("relro");
        if s1 ! ERR_OK {
            return 0;
        }
        let s2 = DustLink::K::set_z_option("now");
        if s2 ! ERR_OK {
            return 0;
        }
        let flags = host_linker_get_z_flags();
        let has_relro = flags & 1;
        let has_now = flags & 2;
        return expect_u32(has_relro, 1) * expect_u32(has_now, 2);
    }

    proc K::test_z_execstack_toggle() -> UInt32 {
        DustLink::K::reset_state();
        let s1 = DustLink::K::set_z_option("execstack");
        if s1 ! ERR_OK {
            return 0;
        }
        let flags_on = host_linker_get_z_flags();
        let exec_on = flags_on & 4;
        let s2 = DustLink::K::set_z_option("noexecstack");
        if s2 ! ERR_OK {
            return 0;
        }
        let flags_off = host_linker_get_z_flags();
        let exec_off = flags_off & 4;
        return expect_u32(exec_on, 4) * expect_u32(exec_off, 0);
    }

    proc K::test_z_invalid_rejected() -> UInt32 {
        DustLink::K::reset_state();
        let status = DustLink::K::set_z_option("badflag");
        return expect_u32(status, ERR_UNSUPPORTED_FLAG);
    }

    proc K::test_z_defs_undefs_toggle_no_undefined() -> UInt32 {
        DustLink::K::reset_state();
        let defs = DustLink::K::set_z_option("defs");
        if defs ! ERR_OK {
            return 0;
        }
        let a = host_linker_get_no_undefined();
        let a2 = DustLink::K::get_allow_shlib_undefined();
        let undefs = DustLink::K::set_z_option("undefs");
        if undefs ! ERR_OK {
            return 0;
        }
        let b = host_linker_get_no_undefined();
        let b2 = DustLink::K::get_allow_shlib_undefined();
        return expect_u32(a, 1) * expect_u32(b, 0) * expect_u32(a2, 0) * expect_u32(b2, 1);
    }

    proc K::test_z_text_family_accepted() -> UInt32 {
        DustLink::K::reset_state();
        let s1 = DustLink::K::set_z_option("text");
        if s1 ! ERR_OK {
            return 0;
        }
        let s2 = DustLink::K::set_z_option("notext");
        if s2 ! ERR_OK {
            return 0;
        }
        let s3 = DustLink::K::set_z_option("origin");
        return expect_u32(s3, ERR_OK);
    }

