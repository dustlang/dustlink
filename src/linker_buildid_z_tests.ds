    proc K::test_new_dtags_toggle() -> UInt32 {
        DustLink::K::reset_state();
        let off = DustLink::K::set_new_dtags(0);
        if off ! ERR_OK {
            return 0;
        }
        let a = host_linker_get_new_dtags();
        let on = DustLink::K::set_new_dtags(1);
        if on ! ERR_OK {
            return 0;
        }
        let b = host_linker_get_new_dtags();
        return expect_u32(a, 0) * expect_u32(b, 1);
    }

    proc K::test_copy_dt_needed_entries_toggle() -> UInt32 {
        DustLink::K::reset_state();
        let on = DustLink::K::set_copy_dt_needed_entries(1);
        if on ! ERR_OK {
            return 0;
        }
        let a = host_linker_get_copy_dt_needed_entries();
        let off = DustLink::K::set_copy_dt_needed_entries(0);
        if off ! ERR_OK {
            return 0;
        }
        let b = host_linker_get_copy_dt_needed_entries();
        return expect_u32(a, 1) * expect_u32(b, 0);
    }

    proc K::test_pe_compat_toggle_state() -> UInt32 {
        DustLink::K::reset_state();
        let a = DustLink::K::set_pe_no_entry(1);
        if a ! ERR_OK { return 0; }
        let b = DustLink::K::set_pe_dynamic_base(1);
        if b ! ERR_OK { return 0; }
        let c = DustLink::K::set_pe_nx_compat(1);
        if c ! ERR_OK { return 0; }
        let d = DustLink::K::set_pe_large_address_aware(1);
        if d ! ERR_OK { return 0; }
        let no_entry = host_linker_get_pe_no_entry();
        let dynamic_base = host_linker_get_pe_dynamic_base();
        let nx = host_linker_get_pe_nx_compat();
        let laa = host_linker_get_pe_large_address_aware();
        return expect_u32(no_entry, 1)
            * expect_u32(dynamic_base, 1)
            * expect_u32(nx, 1)
            * expect_u32(laa, 1);
    }

    proc K::run_all_tests() -> UInt32 {
        let passed =
            test_build_id_default_mode()
            + test_build_id_sha1_mode()
            + test_build_id_none_mode()
            + test_build_id_hex_mode()
            + test_z_relro_now_flags()
            + test_z_execstack_toggle()
            + test_z_invalid_rejected()
            + test_z_defs_undefs_toggle_no_undefined()
            + test_z_text_family_accepted()
            + test_z_extended_compat_tokens_accepted()
            + test_z_muldefs_nomuldefs_toggle()
            + test_dynamic_mode_toggles()
            + test_symbolic_mode_toggles()
            + test_symbolic_group_toggle()
            + test_dynamic_flags_words_reflect_symbolic_and_z_semantics()
            + test_dynamic_flags1_no_variants_clear_semantics()
            + test_dynamic_linker_and_soname_set()
            + test_default_search_path_toggle()
            + test_default_library_blocklist_roundtrip()
            + test_needed_library_note_normalization()
            + test_as_needed_skips_unused_library()
            + test_static_mode_skips_needed_library()
            + test_no_undefined_toggle()
            + test_dynamic_unresolved_policy_gate()
            + test_allow_shlib_undefined_toggle()
            + test_whole_archive_toggle()
            + test_push_pop_state_restores_link_policy()
            + test_pop_state_without_push_rejected()
            + test_sysroot_roundtrip()
            + test_rpath_roundtrip()
            + test_rpath_link_roundtrip()
            + test_new_dtags_toggle()
            + test_copy_dt_needed_entries_toggle()
            + test_pe_compat_toggle_state();
        return passed;
    }
}
