// Linker script behavior tests for parser semantics and state effects.

forge LinkerScriptSemanticsTests {
    const ERR_OK: UInt32 = 0;

    const FORMAT_PE64: UInt32 = 4;
    const FORMAT_MACHO64: UInt32 = 5;
    const TARGET_X86_64_WINDOWS: UInt32 = 2;

    proc K::expect_u32(actual: UInt32, expected: UInt32) -> UInt32 {
        if actual == expected {
            return 1;
        } else {
            return 0;
        }
    }

    proc K::expect_u64(actual: UInt64, expected: UInt64) -> UInt32 {
        if actual == expected {
            return 1;
        } else {
            return 0;
        }
    }

    proc K::test_script_output_format_directive() -> UInt32 {
        let path = "dustlink_script_test_format.ld";
        DustLink::K::reset_state();
        LinkerFs::K::clear_file(path);
        LinkerFs::K::append_line(path, "OUTPUT_FORMAT(pei-x86-64);");
        let status = DustLink::K::apply_script(path);
        if status ! ERR_OK {
            return 0;
        } else {
            let format = host_linker_get_output_format();
            return expect_u32(format, FORMAT_PE64);
        }
    }

    proc K::test_script_provide_symbol_definition() -> UInt32 {
        let path = "dustlink_script_test_provide.ld";
        DustLink::K::reset_state();
        LinkerFs::K::clear_file(path);
        LinkerFs::K::append_line(path, "PROVIDE(test_symbol=0x2000);");
        let status = DustLink::K::apply_script(path);
        if status ! ERR_OK {
            return 0;
        } else {
            let hash = LinkerFs::K::hash_name("test_symbol");
            let defined = host_linker_global_symbol_defined(hash);
            let address = host_linker_global_symbol_address(hash);
            return expect_u32(defined, 1) * expect_u64(address, 8192);
        }
    }

    proc K::test_script_extern_symbol_requirement() -> UInt32 {
        let path = "dustlink_script_test_extern.ld";
        DustLink::K::reset_state();
        LinkerFs::K::clear_file(path);
        LinkerFs::K::append_line(path, "EXTERN(missing_symbol);");
        let status = DustLink::K::apply_script(path);
        if status ! ERR_OK {
            return 0;
        } else {
            let required = host_linker_required_symbol_count();
            return expect_u32(required, 1);
        }
    }

    proc K::test_script_include_directive() -> UInt32 {
        let child = "dustlink_script_test_include_child.ld";
        let parent = "dustlink_script_test_include_parent.ld";
        DustLink::K::reset_state();
        LinkerFs::K::clear_file(child);
        LinkerFs::K::append_line(child, "OUTPUT_FORMAT(macho64);");
        LinkerFs::K::clear_file(parent);
        LinkerFs::K::append_line(parent, "INCLUDE(dustlink_script_test_include_child.ld);");
        let status = DustLink::K::apply_script(parent);
        if status ! ERR_OK {
            return 0;
        } else {
            let format = host_linker_get_output_format();
            return expect_u32(format, FORMAT_MACHO64);
        }
    }

    proc K::test_script_memory_origin_sets_image_base() -> UInt32 {
        let path = "dustlink_script_test_memory.ld";
        DustLink::K::reset_state();
        LinkerFs::K::clear_file(path);
        LinkerFs::K::append_line(path, "MEMORY { RAM (rwx) : ORIGIN = 0x200000, LENGTH = 64M }");
        let status = DustLink::K::apply_script(path);
        if status ! ERR_OK {
            return 0;
        } else {
            let image_base = host_linker_get_image_base();
            return expect_u64(image_base, 2097152);
        }
    }

    proc K::test_script_sections_location_counter_sets_image_base() -> UInt32 {
        let path = "dustlink_script_test_sections.ld";
        DustLink::K::reset_state();
        LinkerFs::K::clear_file(path);
        LinkerFs::K::append_line(path, "SECTIONS { . = 0x300000; .text : { *(.text) } }");
        let status = DustLink::K::apply_script(path);
        if status ! ERR_OK {
            return 0;
        } else {
            let image_base = host_linker_get_image_base();
            return expect_u64(image_base, 3145728);
        }
    }

    proc K::test_script_sections_named_output_address_sets_image_base() -> UInt32 {
        let path = "dustlink_script_test_sections_named.ld";
        DustLink::K::reset_state();
        LinkerFs::K::clear_file(path);
        LinkerFs::K::append_line(path, "SECTIONS { .text 0x400000 : { *(.text) } }");
        let status = DustLink::K::apply_script(path);
        if status ! ERR_OK {
            return 0;
        } else {
            let image_base = host_linker_get_image_base();
            return expect_u64(image_base, 4194304);
        }
    }

    proc K::test_script_entry_symbol_marks_required() -> UInt32 {
        let path = "dustlink_script_test_entry_symbol.ld";
        DustLink::K::reset_state();
        LinkerFs::K::clear_file(path);
        LinkerFs::K::append_line(path, "ENTRY(kernel_entry);");
        let status = DustLink::K::apply_script(path);
        if status ! ERR_OK {
            return 0;
        } else {
            let required = host_linker_required_symbol_count();
            return expect_u32(required, 1);
        }
    }

    proc K::test_script_multiline_memory_sections_blocks() -> UInt32 {
        let path = "dustlink_script_test_multiline.ld";
        DustLink::K::reset_state();
        LinkerFs::K::clear_file(path);
        LinkerFs::K::append_line(path, "MEMORY {");
        LinkerFs::K::append_line(path, "  RAM (rwx) : ORIGIN = 0x500000, LENGTH = 64M");
        LinkerFs::K::append_line(path, "}");
        LinkerFs::K::append_line(path, "SECTIONS {");
        LinkerFs::K::append_line(path, "  .text 0x500000 : { *(.text) }");
        LinkerFs::K::append_line(path, "}");
        let status = DustLink::K::apply_script(path);
        if status ! ERR_OK {
            return 0;
        } else {
            let image_base = host_linker_get_image_base();
            return expect_u64(image_base, 5242880);
        }
    }

    proc K::test_script_output_arch_sets_target() -> UInt32 {
        let path = "dustlink_script_test_output_arch.ld";
        DustLink::K::reset_state();
        LinkerFs::K::clear_file(path);
        LinkerFs::K::append_line(path, "OUTPUT_ARCH(x86_64-windows-msvc);");
        let status = DustLink::K::apply_script(path);
        if status ! ERR_OK {
            return 0;
        } else {
            let target = host_linker_get_target();
            return expect_u32(target, TARGET_X86_64_WINDOWS);
        }
    }

    proc K::test_script_as_needed_scope_restores_state() -> UInt32 {
        let path = "dustlink_script_test_as_needed.ld";
        DustLink::K::reset_state();
        DustLink::K::set_as_needed(0);
        LinkerFs::K::clear_file(path);
        LinkerFs::K::append_line(path, "AS_NEEDED(libdemo.so);");
        let status = DustLink::K::apply_script(path);
        if status ! ERR_OK {
            return 0;
        } else {
            let as_needed = host_linker_get_as_needed();
            return expect_u32(as_needed, 0);
        }
    }

    proc K::run_all_tests() -> UInt32 {
        let passed =
            test_script_output_format_directive()
            + test_script_provide_symbol_definition()
            + test_script_extern_symbol_requirement()
            + test_script_include_directive()
            + test_script_memory_origin_sets_image_base()
            + test_script_sections_location_counter_sets_image_base()
            + test_script_sections_named_output_address_sets_image_base()
            + test_script_entry_symbol_marks_required()
            + test_script_multiline_memory_sections_blocks()
            + test_script_output_arch_sets_target()
            + test_script_as_needed_scope_restores_state();
        return passed;
    }
}
