// Output image composition and validation helpers.

forge LinkerImage {
    const FORMAT_ELF: UInt32 = 1;
    const FORMAT_FLAT: UInt32 = 2;
    const FORMAT_MBR: UInt32 = 3;
    const FORMAT_PE: UInt32 = 4;
    const FORMAT_MACHO: UInt32 = 5;

    const ARCH_X86_64: UInt32 = 1;

    const OS_NONE: UInt32 = 0;
    const OS_LINUX: UInt32 = 1;
    const OS_WINDOWS: UInt32 = 2;
    const OS_MACOS: UInt32 = 3;

    const IMAGE_MAX_SIZE: UInt32 = 33554432;

    const DEFAULT_TEXT_ADDR: UInt64 = 65536;
    const DEFAULT_DATA_ADDR: UInt64 = 1073741824;
    const DEFAULT_ENTRY_ADDR: UInt64 = 1048576;
    const DEFAULT_IMAGE_BUFFER: UInt64 = 4194304;

    const ERR_OK: UInt32 = 0;
    const ERR_FILE_NOT_FOUND: UInt32 = 1;
    const ERR_INVALID_FORMAT: UInt32 = 2;
    const ERR_INVALID_SECTION: UInt32 = 3;
    const ERR_INVALID_ADDRESS: UInt32 = 8;
    const ERR_INVALID_ENTRY: UInt32 = 9;
    const ERR_WRITE_FAILED: UInt32 = 10;
    const ERR_INVALID_IMAGE: UInt32 = 11;
    const ERR_UNSUPPORTED_TARGET: UInt32 = 14;
    const ERR_NOT_IMPLEMENTED_YET: UInt32 = 17;

    proc K::format_supported(format: UInt32) -> UInt32 {
        if format == FORMAT_FLAT {
            return 1;
        } else {
            if format == FORMAT_ELF {
                return 1;
            } else {
                if format == FORMAT_MBR {
                    return 1;
                } else {
                    if format == FORMAT_PE {
                        return 1;
                    } else {
                        if format == FORMAT_MACHO {
                            return 1;
                        } else {
                            return 0;
                        }
                    }
                }
            }
        }
    }

    proc K::create_image(format: UInt32) -> UInt64 {
        if format_supported(format) == 0 {
            return 0;
        } else {
            return host_linker_create_image_buffer(format);
        }
    }

    proc K::set_image_format(format: UInt32) -> UInt32 {
        if format_supported(format) == 0 {
            return ERR_INVALID_FORMAT;
        } else {
            return host_linker_set_output_format(format);
        }
    }

    proc K::set_image_entry(entry: UInt64) -> UInt32 {
        if entry == 0 {
            return ERR_INVALID_ENTRY;
        } else {
            return host_linker_set_entry(entry);
        }
    }

    proc K::set_image_base(base: UInt64) -> UInt32 {
        if base == 0 {
            return ERR_INVALID_ADDRESS;
        } else {
            if base < 4096 {
                return ERR_INVALID_ADDRESS;
            } else {
                return host_linker_set_image_base(base);
            }
        }
    }

    proc K::validate_image_plan(
        format: UInt32,
        image_base: UInt64,
        entry: UInt64,
        text_size: UInt32,
        rodata_size: UInt32,
        data_size: UInt32,
        bss_size: UInt32
    ) -> UInt32 {
        let format_status = set_image_format(format);
        if format_status ! ERR_OK {
            return format_status;
        } else {
            let base_status = set_image_base(image_base);
            if base_status ! ERR_OK {
                return base_status;
            } else {
                let entry_status = set_image_entry(entry);
                if entry_status ! ERR_OK {
                    return entry_status;
                } else {
                    if text_size == 0 {
                        return ERR_INVALID_SECTION;
                    } else {
                        let total_a = text_size + rodata_size;
                        if total_a < text_size {
                            return ERR_INVALID_IMAGE;
                        } else {
                            let total_b = total_a + data_size;
                            if total_b < total_a {
                                return ERR_INVALID_IMAGE;
                            } else {
                                let total = total_b + bss_size;
                                if total < total_b {
                                    return ERR_INVALID_IMAGE;
                                } else {
                                    if total > IMAGE_MAX_SIZE {
                                        return ERR_INVALID_IMAGE;
                                    } else {
                                        return ERR_OK;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    proc K::add_section(section: UInt64) -> UInt32 {
        if section == 0 {
            return ERR_INVALID_SECTION;
        } else {
            return host_linker_add_output_section(section);
        }
    }

    proc K::calculate_image_size() -> UInt32 {
        return host_linker_calculate_image_size();
    }

    proc K::allocate_image(size: UInt32) -> UInt64 {
        if size == 0 {
            return 0;
        } else {
            if size > IMAGE_MAX_SIZE {
                return 0;
            } else {
                return host_linker_allocate_image(size);
            }
        }
    }

    proc K::compose_flat_image_plan(
        image_base: UInt64,
        entry: UInt64,
        text_size: UInt32,
        rodata_size: UInt32,
        data_size: UInt32,
        bss_size: UInt32
    ) -> UInt32 {
        return validate_image_plan(
            FORMAT_FLAT,
            image_base,
            entry,
            text_size,
            rodata_size,
            data_size,
            bss_size
        );
    }

    proc K::compose_elf_image_plan(
        image_base: UInt64,
        entry: UInt64,
        text_size: UInt32,
        rodata_size: UInt32,
        data_size: UInt32,
        bss_size: UInt32
    ) -> UInt32 {
        return validate_image_plan(
            FORMAT_ELF,
            image_base,
            entry,
            text_size,
            rodata_size,
            data_size,
            bss_size
        );
    }

    proc K::emit_output_sections(output: UInt64, section_index: UInt32, section_count: UInt32) -> UInt32 {
        if section_index >= section_count {
            return ERR_OK;
        } else {
            let emit_status = host_linker_emit_output_section(output, section_index);
            if emit_status ! ERR_OK {
                return emit_status;
            } else {
                return emit_output_sections(output, section_index + 1, section_count);
            }
        }
    }

    proc K::write_flat_output(output: UInt64) -> UInt32 {
        let output_status = LinkerFs::K::validate_output_file(output);
        if output_status ! ERR_OK {
            return output_status;
        } else {
            let section_count = host_linker_output_section_count();
            let section_status = emit_output_sections(output, 0, section_count);
            if section_status ! ERR_OK {
                return section_status;
            } else {
                return host_linker_write_flat_binary(output);
            }
        }
    }

    proc K::write_elf_output(output: UInt64, entry: UInt64, image_base: UInt64) -> UInt32 {
        let output_status = LinkerFs::K::validate_output_file(output);
        if output_status ! ERR_OK {
            return output_status;
        } else {
            let header_status = host_linker_write_elf_headers(output, entry, image_base);
            if header_status ! ERR_OK {
                return header_status;
            } else {
                let section_count = host_linker_output_section_count();
                let section_status = emit_output_sections(output, 0, section_count);
                if section_status ! ERR_OK {
                    return section_status;
                } else {
                    return host_linker_finalize_elf(output);
                }
            }
        }
    }

    proc K::write_image(output: UInt64) -> UInt32 {
        if output == 0 {
            return ERR_WRITE_FAILED;
        } else {
            let format = host_linker_get_output_format();
            if format == FORMAT_FLAT {
                return write_flat_output(output);
            } else {
                if format == FORMAT_ELF {
                    let entry = host_linker_get_entry();
                    let image_base = host_linker_get_image_base();
                    return write_elf_output(output, entry, image_base);
                } else {
                    if format == FORMAT_MBR {
                        return host_linker_write_mbr_image(output);
                    } else {
                        if format == FORMAT_PE {
                            return host_linker_write_pe_image(output);
                        } else {
                            if format == FORMAT_MACHO {
                                return host_linker_write_macho_image(output);
                            } else {
                                return ERR_INVALID_FORMAT;
                            }
                        }
                    }
                }
            }
        }
    }

    proc K::finalize_image() -> UInt32 {
        return host_linker_finalize_image();
    }

    proc K::set_image_arch(arch: UInt32) -> UInt32 {
        if arch == ARCH_X86_64 {
            return host_linker_set_arch(arch);
        } else {
            return ERR_UNSUPPORTED_TARGET;
        }
    }

    proc K::set_image_os(os: UInt32) -> UInt32 {
        if os == OS_NONE {
            return host_linker_set_os(os);
        } else {
            if os == OS_LINUX {
                return host_linker_set_os(os);
            } else {
                if os == OS_WINDOWS {
                    return host_linker_set_os(os);
                } else {
                    if os == OS_MACOS {
                        return host_linker_set_os(os);
                    } else {
                        return ERR_UNSUPPORTED_TARGET;
                    }
                }
            }
        }
    }

    proc K::create_boot_image(kernel: UInt64, kernel_size: UInt32, output: UInt64) -> UInt32 {
        if kernel == 0 {
            return ERR_FILE_NOT_FOUND;
        } else {
            if kernel_size == 0 {
                return ERR_INVALID_IMAGE;
            } else {
                if kernel_size > IMAGE_MAX_SIZE {
                    return ERR_INVALID_IMAGE;
                } else {
                    if output == 0 {
                        return ERR_WRITE_FAILED;
                    } else {
                        return host_linker_write_mbr_boot_image(output, kernel, kernel_size);
                    }
                }
            }
        }
    }

    proc K::create_efi_image(output: UInt64) -> UInt32 {
        if output == 0 {
            return ERR_WRITE_FAILED;
        } else {
            return host_linker_write_efi_image(output);
        }
    }

    proc K::emit_map_rows(path: UInt64, row_index: UInt32, row_count: UInt32) -> UInt32 {
        if row_index >= row_count {
            return ERR_OK;
        } else {
            let row = host_linker_format_map_row(row_index);
            let write_status = LinkerFs::K::append_line(path, row);
            if write_status ! ERR_OK {
                return ERR_WRITE_FAILED;
            } else {
                return emit_map_rows(path, row_index + 1, row_count);
            }
        }
    }

    proc K::write_map_file(path: UInt64) -> UInt32 {
        let output_status = LinkerFs::K::validate_output_file(path);
        if output_status ! ERR_OK {
            return output_status;
        } else {
            let clear_status = LinkerFs::K::clear_file(path);
            if clear_status ! ERR_OK {
                return ERR_WRITE_FAILED;
            } else {
                let row_count = host_linker_map_row_count();
                return emit_map_rows(path, 0, row_count);
            }
        }
    }
}
