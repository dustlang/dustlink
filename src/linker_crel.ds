// Description:
//   Compatibility stub for CREL support while running under the current parser profile.

forge LinkerCrel {
    const ERR_OK: UInt32 = 0;
    const ERR_NOT_IMPLEMENTED: UInt32 = 17;

    proc K::crel_available() -> UInt32 {
        return 0;
    }

    proc K::create_crel_section(
        name: UInt64,
        relocs: UInt64,
        count: UInt32,
        output: UInt64,
        output_size: UInt32
    ) -> UInt32 {
        return ERR_NOT_IMPLEMENTED;
    }

    proc K::compress_relocations(relocs: UInt64, count: UInt32, output: UInt64, flags: UInt32) -> UInt32 {
        return ERR_NOT_IMPLEMENTED;
    }

    proc K::decompress_relocations(crel_data: UInt64, output: UInt64, max_count: UInt32) -> UInt32 {
        return ERR_NOT_IMPLEMENTED;
    }
}
