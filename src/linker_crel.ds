// File: linker_crel.ds - This file is part of the DPL Toolchain
// Copyright (c) 2026 Dust LLC, and Contributors
// Description:
//   CREL (Compact RELocation) format support for DustLink.
//   Provides:
//     - ULEB128/SLEB128 encoding/decoding
//     - CREL section parsing and generation
//     - Delta offset encoding
//     - Dictionary-based compression
//     - Integration with ELF writer

forge LinkerCrel {
    const CREL_MAGIC: UInt32 = 1397310396;
    const CREL_VERSION: UInt32 = 1;

    const SHT_CREL: UInt32 = 1879048285;

    const MAX_RELOC_ENTRIES: UInt32 = 262144;
    const MAX_DICTIONARY_SIZE: UInt32 = 4096;

    const ENCODING_RAW: UInt8 = 0;
    const ENCODING_ULEB128: UInt8 = 1;
    const ENCODING_SLEB128: UInt8 = 2;
    const ENCODING_DELTA: UInt8 = 3;
    const ENCODING_SHARED: UInt8 = 4;

    const FLAG_NONE: UInt8 = 0;
    const FLAG_COMPRESSED: UInt8 = 1;
    const FLAG_DICTIONARY: UInt8 = 2;
    const FLAG_DELTA_OFFSET: UInt8 = 4;

    const ERR_OK: UInt32 = 0;
    const ERR_INVALID_CREL: UInt32 = 1;
    const ERR_DECODE_FAILED: UInt32 = 2;
    const ERR_ENCODE_FAILED: UInt32 = 3;
    const ERR_BUFFER_OVERFLOW: UInt32 = 4;
    const ERR_INVALID_ENTRY: UInt32 = 5;
    const ERR_NOT_IMPLEMENTED: UInt32 = 17;

    const RELOC_COUNT_OFFSET: UInt32 = 0;
    const DICTIONARY_OFFSET: UInt32 = 4;
    const ENTRIES_OFFSET: UInt32 = 8;

    proc K::encode_uleb128(value: UInt64) -> UInt64 {
        let result: UInt64 = 0;
        let shift: UInt64 = 0;
        let v = value;
        while v != 0 {
            let byte = (v & 127) | ((shift > 0) * 128);
            result = result | (byte << (shift * 8));
            shift = shift + 1;
            v = v / 128;
        }
        if shift == 0 {
            result = 128;
            shift = 1;
        }
        return result;
    }

    proc K::decode_uleb128(data: UInt64, pos: UInt32, result: UInt64) -> UInt32 {
        let offset: UInt32 = 0;
        let value: UInt64 = 0;
        let shift: UInt64 = 0;
        let byte = host_read_u8(data + pos + offset);
        while (byte & 128) != 0 {
            value = value | (((byte & 127) as UInt64) << shift);
            offset = offset + 1;
            byte = host_read_u8(data + pos + offset);
            shift = shift + 7;
        }
        value = value | ((byte as UInt64) << shift);
        host_write_u64(result, value);
        return offset + 1;
    }

    proc K::encode_sleb128(value: Int64) -> UInt64 {
        let result: UInt64 = 0;
        let shift: UInt64 = 0;
        let v = value;
        if v >= 0 {
            while v != 0 {
                let byte = ((v & 127) as UInt8) | ((shift > 0) * 128);
                result = result | ((byte as UInt64) << (shift * 8));
                shift = shift + 1;
                v = v / 128;
            }
        } else {
            let i: UInt64 = 0;
            while i < 10 {
                let byte = ((v & 127) as UInt8) | 128;
                result = result | ((byte as UInt64) << (shift * 8));
                shift = shift + 1;
                v = v / 128;
                if v == -1 {
                    let last_byte = ((v & 127) as UInt8);
                    result = result | ((last_byte as UInt64) << (shift * 8));
                    shift = shift + 1;
                    i = 10;
                }
                i = i + 1;
            }
        }
        if shift == 0 {
            result = 128;
            shift = 1;
        }
        return result;
    }

    proc K::decode_sleb128(data: UInt64, pos: UInt32, result: UInt64) -> UInt32 {
        let offset: UInt32 = 0;
        let value: UInt64 = 0;
        let shift: UInt64 = 0;
        let byte = host_read_u8(data + pos + offset);
        while (byte & 128) != 0 {
            value = value | (((byte & 127) as UInt64) << shift);
            offset = offset + 1;
            byte = host_read_u8(data + pos + offset);
            shift = shift + 7;
        }
        value = value | (((byte & 127) as UInt64) << shift);
        if (byte & 64) != 0 {
            let extend: UInt64 = 0xFFFFFFFFFFFFFF80;
            value = value | extend;
        }
        host_write_u64(result, value);
        return offset + 1;
    }

    proc K::encode_delta(value: UInt64, previous: UInt64) -> UInt64 {
        if value >= previous {
            return value - previous;
        } else {
            return 0;
        }
    }

    proc K::decode_delta(value: UInt64, previous: UInt64) -> UInt64 {
        return value + previous;
    }

    proc K::get_uleb128_size(value: UInt64) -> UInt32 {
        let size: UInt32 = 0;
        let v = value;
        while v != 0 {
            size = size + 1;
            v = v / 128;
        }
        if size == 0 {
            size = 1;
        }
        return size;
    }

    proc K::get_sleb128_size(value: Int64) -> UInt32 {
        let size: UInt32 = 0;
        let v = value;
        let negative = 0;
        if v < 0 {
            negative = 1;
        }
        while v != 0 {
            size = size + 1;
            v = v / 128;
        }
        if size == 0 {
            size = 1;
        }
        return size + negative;
    }

    proc K::crel_header_size() -> UInt32 {
        return 16;
    }

    proc K::validate_crel_header(data: UInt64) -> UInt32 {
        let magic = host_read_u32(data);
        if magic != CREL_MAGIC {
            return ERR_INVALID_CREL;
        }
        let version = host_read_u32(data + 4);
        if version != CREL_VERSION {
            return ERR_INVALID_CREL;
        }
        return ERR_OK;
    }

    proc K::get_crel_reloc_count(data: UInt64) -> UInt32 {
        return host_read_u32(data + 8);
    }

    proc K::get_crel_flags(data: UInt64) -> UInt32 {
        return host_read_u32(data + 12);
    }

    proc K::is_crel_compressed(data: UInt32) -> UInt32 {
        if (data & FLAG_COMPRESSED) != 0 {
            return 1;
        }
        return 0;
    }

    proc K::is_crel_delta(data: UInt32) -> UInt32 {
        if (data & FLAG_DELTA_OFFSET) != 0 {
            return 1;
        }
        return 0;
    }

    proc K::is_crel_dictionary(data: UInt32) -> UInt32 {
        if (data & FLAG_DICTIONARY) != 0 {
            return 1;
        }
        return 0;
    }

    proc K::build_reloc_entry(
        offset: UInt64,
        reloc_type: UInt32,
        sym_index: UInt32,
        addend: Int64,
        output: UInt64
    ) -> UInt32 {
        let pos: UInt32 = 0;
        let encoded = encode_uleb128(offset);
        host_write_u64(output + pos, encoded);
        let offset_size = get_uleb128_size(offset);
        pos = offset_size;
        encoded = encode_uleb128(reloc_type);
        host_write_u64(output + pos, encoded);
        let type_size = get_uleb128_size(reloc_type as UInt64);
        pos = pos + type_size;
        encoded = encode_uleb128(sym_index as UInt64);
        host_write_u64(output + pos, encoded);
        let sym_size = get_uleb128_size(sym_index as UInt64);
        pos = pos + sym_size;
        encoded = encode_sleb128(addend);
        host_write_u64(output + pos, encoded);
        let addend_size = get_sleb128_size(addend);
        pos = pos + addend_size;
        return pos;
    }

    proc K::parse_reloc_entry(
        data: UInt64,
        pos: UInt32,
        offset_out: UInt64,
        type_out: UInt32,
        sym_out: UInt32,
        addend_out: UInt64
    ) -> UInt32 {
        let start_pos = pos;
        let bytes_read = decode_uleb128(data, pos, offset_out);
        pos = pos + bytes_read;
        let type_val: UInt64 = 0;
        bytes_read = decode_uleb128(data, pos, type_val);
        host_write_u32(type_out, type_val as UInt32);
        pos = pos + bytes_read;
        let sym_val: UInt64 = 0;
        bytes_read = decode_uleb128(data, pos, sym_val);
        host_write_u32(sym_out, sym_val as UInt32);
        pos = pos + bytes_read;
        let addend_val: UInt64 = 0;
        bytes_read = decode_sleb128(data, pos, addend_val);
        host_write_u64(addend_out, addend_val);
        pos = pos + bytes_read;
        return pos - start_pos;
    }

    proc K::encode_reloc_with_delta(
        offset: UInt64,
        prev_offset: UInt64,
        reloc_type: UInt32,
        sym_index: UInt32,
        addend: Int64,
        output: UInt64
    ) -> UInt32 {
        let delta = encode_delta(offset, prev_offset);
        return build_reloc_entry(delta, reloc_type, sym_index, addend, output);
    }

    proc K::compress_relocations(
        relocs: UInt64,
        count: UInt32,
        output: UInt64,
        flags: UInt32
    ) -> UInt64 {
        if relocs == 0 {
            return 0;
        }
        if count == 0 {
            return 0;
        }
        let header_size = crel_header_size();
        host_write_u32(output, CREL_MAGIC);
        host_write_u32(output + 4, CREL_VERSION);
        host_write_u32(output + 8, count);
        host_write_u32(output + 12, flags);
        let pos: UInt32 = header_size;
        let prev_offset: UInt64 = 0;
        let use_delta = is_crel_delta(flags);
        let i: UInt32 = 0;
        while i < count {
            let reloc_offset = host_read_u64(relocs + i * 32);
            let reloc_type = host_read_u32(relocs + i * 32 + 8);
            let sym_index = host_read_u32(relocs + i * 32 + 12);
            let addend = host_read_i64(relocs + i * 32 + 16);
            let entry_size: UInt32 = 0;
            if use_delta == 1 {
                entry_size = encode_reloc_with_delta(
                    reloc_offset,
                    prev_offset,
                    reloc_type,
                    sym_index,
                    addend,
                    output + pos
                );
            } else {
                entry_size = build_reloc_entry(
                    reloc_offset,
                    reloc_type,
                    sym_index,
                    addend,
                    output + pos
                );
            }
            pos = pos + entry_size;
            prev_offset = reloc_offset;
            i = i + 1;
        }
        return pos;
    }

    proc K::decompress_relocations(
        crel_data: UInt64,
        output: UInt64,
        max_count: UInt32
    ) -> UInt32 {
        let header_err = validate_crel_header(crel_data);
        if header_err != ERR_OK {
            return header_err;
        }
        let count = get_crel_reloc_count(crel_data);
        if count > max_count {
            return ERR_BUFFER_OVERFLOW;
        }
        let flags = get_crel_flags(crel_data);
        let header_size = crel_header_size();
        let pos: UInt32 = header_size;
        let prev_offset: UInt64 = 0;
        let use_delta = is_crel_delta(flags);
        let offset_val: UInt64 = 0;
        let type_val: UInt32 = 0;
        let sym_val: UInt32 = 0;
        let addend_val: UInt64 = 0;
        let i: UInt32 = 0;
        while i < count {
            let entry_size = parse_reloc_entry(
                crel_data,
                pos,
                offset_val,
                type_val,
                sym_val,
                addend_val
            );
            let final_offset: UInt64 = 0;
            if use_delta == 1 {
                final_offset = decode_delta(offset_val, prev_offset);
            } else {
                final_offset = offset_val;
            }
            host_write_u64(output + i * 32, final_offset);
            host_write_u32(output + i * 32 + 8, type_val);
            host_write_u32(output + i * 32 + 12, sym_val);
            host_write_i64(output + i * 32 + 16, addend_val as Int64);
            pos = pos + entry_size;
            prev_offset = final_offset;
            i = i + 1;
        }
        return count;
    }

    proc K::estimate_crel_size(
        relocs: UInt64,
        count: UInt32,
        flags: UInt32
    ) -> UInt64 {
        let header_size = crel_header_size() as UInt64;
        let estimated_entry: UInt64 = 16;
        if (flags & FLAG_DELTA_OFFSET) != 0 {
            estimated_entry = 8;
        }
        return header_size + (estimated_entry * count as UInt64);
    }

    proc K::should_use_crel(
        standard_size: UInt64,
        relocs: UInt64,
        count: UInt32,
        flags: UInt32
    ) -> UInt32 {
        let crel_size = estimate_crel_size(relocs, count, flags);
        if crel_size < standard_size {
            return 1;
        }
        return 0;
    }

    proc K::create_crel_section(
        name: UInt64,
        relocs: UInt64,
        count: UInt32,
        output: UInt64,
        output_size: UInt32
    ) -> UInt32 {
        let flags: UInt32 = FLAG_DELTA_OFFSET;
        let standard_size = count * 24;
        if should_use_crel(standard_size as UInt64, relocs, count, flags) == 1 {
            let actual_size = compress_relocations(relocs, count, output, flags);
            host_write_u32(output_size, actual_size);
            return ERR_OK;
        }
        return ERR_NOT_IMPLEMENTED;
    }

    proc K::get_shared_type_codes(
        relocs: UInt64,
        count: UInt32,
        dictionary: UInt64
    ) -> UInt32 {
        if relocs == 0 {
            return 0;
        }
        let dict_size: UInt32 = 0;
        let i: UInt32 = 0;
        while i < count {
            let reloc_type = host_read_u32(relocs + i * 32 + 8);
            let j: UInt32 = 0;
            let found = 0;
            while j < dict_size {
                let dict_type = host_read_u32(dictionary + j * 4);
                if dict_type == reloc_type {
                    found = 1;
                    j = dict_size;
                }
                j = j + 1;
            }
            if found == 0 {
                if dict_size < MAX_DICTIONARY_SIZE {
                    host_write_u32(dictionary + dict_size * 4, reloc_type);
                    dict_size = dict_size + 1;
                }
            }
            i = i + 1;
        }
        return dict_size;
    }

    proc K::compress_with_shared_types(
        relocs: UInt64,
        count: UInt32,
        dictionary: UInt64,
        dict_count: UInt32,
        output: UInt64
    ) -> UInt64 {
        let header_size = crel_header_size();
        let dict_size_bytes = dict_count * 4;
        host_write_u32(output, CREL_MAGIC);
        host_write_u32(output + 4, CREL_VERSION);
        host_write_u32(output + 8, count);
        host_write_u32(output + 12, FLAG_DICTIONARY | FLAG_DELTA_OFFSET);
        let i: UInt32 = 0;
        while i < dict_count {
            let dict_type = host_read_u32(dictionary + i * 4);
            host_write_u32(output + header_size + i * 4, dict_type);
            i = i + 1;
        }
        return (header_size + dict_size_bytes) as UInt64;
    }

    proc K::convert_rel_to_crel(
        input_relocs: UInt64,
        input_count: UInt32,
        output: UInt64,
        use_compression: UInt32
    ) -> UInt32 {
        if use_compression == 1 {
            let flags = FLAG_DELTA_OFFSET | FLAG_COMPRESSED;
            let size = compress_relocations(input_relocs, input_count, output, flags);
            return size as UInt32;
        } else {
            return ERR_NOT_IMPLEMENTED;
        }
    }

    proc K::is_crel_section(section_type: UInt32) -> UInt32 {
        if section_type == SHT_CREL {
            return 1;
        }
        return 0;
    }

    proc K::supports_crel(target_machine: UInt16) -> UInt32 {
        if target_machine == 62 {
            return 1;
        }
        if target_machine == 183 {
            return 1;
        }
        if target_machine == 243 {
            return 1;
        }
        if target_machine == 40 {
            return 1;
        }
        if target_machine == 21 {
            return 1;
        }
        return 0;
    }
}
