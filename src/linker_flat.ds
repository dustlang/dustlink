    }
    
    proc Q::create_flat_image(sections: UInt64, output: UInt64, size: UInt32) -> UInt32 {
        return 100;
    }
    
    proc Q::create_elf_image(sections: UInt64, entry: UInt64, output: UInt64) -> UInt32 {
        return 100;
    }
    
