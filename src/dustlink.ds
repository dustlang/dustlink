// Description:
//   DustLink top-level linker orchestration for the internal Dust pipeline.
//   Provides:
//     - VERSION_MAJOR, VERSION_MINOR: Version info
//     - FORMAT_ELF64, FORMAT_FLAT, FORMAT_MBR, FORMAT_PE64: Output formats
//     - Link configuration and execution
//     - Host runtime integration

forge DustLink {
    const VERSION_MAJOR: UInt8 = 0;
    const VERSION_MINOR: UInt8 = 6;

    const FORMAT_ELF64: UInt32 = 1;
    const FORMAT_FLAT: UInt32 = 2;
    const FORMAT_MBR: UInt32 = 3;
    const FORMAT_PE64: UInt32 = 4;
    const FORMAT_MACHO64: UInt32 = 5;
    const FORMAT_WASM: UInt32 = 6;

    const TARGET_NONE: UInt32 = 0;
    const TARGET_X86_64_LINUX: UInt32 = 1;
    const TARGET_X86_64_WINDOWS: UInt32 = 2;
    const TARGET_X86_64_MACOS: UInt32 = 3;
    const TARGET_AARCH64_LINUX: UInt32 = 4;
    const TARGET_AARCH64_WINDOWS: UInt32 = 5;
    const TARGET_AARCH64_MACOS: UInt32 = 6;
    const TARGET_RISCV64_LINUX: UInt32 = 7;
    const TARGET_RISCV32_LINUX: UInt32 = 8;
    const TARGET_ARM64_LINUX: UInt32 = 9;
    const TARGET_ARM32_LINUX: UInt32 = 10;
    const TARGET_ARM32_EABI: UInt32 = 11;
    const TARGET_RISCV64_ELF: UInt32 = 12;
    const TARGET_RISCV32_ELF: UInt32 = 13;
    const TARGET_PPC64_LINUX: UInt32 = 14;
    const TARGET_PPC64LE_LINUX: UInt32 = 15;
    const TARGET_PPC32_LINUX: UInt32 = 16;
    const TARGET_PPC32_VLE: UInt32 = 17;
    const TARGET_MIPS64_ELF: UInt32 = 18;
    const TARGET_MIPS32_ELF: UInt32 = 19;
    const TARGET_MIPS32EL_ELF: UInt32 = 20;
    const TARGET_MIPS64EL_ELF: UInt32 = 21;
    const TARGET_AMDGPU_GFX600: UInt32 = 22;
    const TARGET_AMDGPU_GFX700: UInt32 = 23;
    const TARGET_AMDGPU_GFX800: UInt32 = 24;
    const TARGET_AMDGPU_GFX900: UInt32 = 25;
    const TARGET_AMDGPU_GFX906: UInt32 = 26;
    const TARGET_AMDGPU_GFX908: UInt32 = 27;
    const TARGET_AMDGPU_GFX90A: UInt32 = 28;
    const TARGET_AMDGPU_GFX940: UInt32 = 29;
    const TARGET_HEXAGON_ELF: UInt32 = 30;
    const TARGET_SPARC64_ELF: UInt32 = 31;
    const TARGET_SPARC32_ELF: UInt32 = 32;

    const ERR_OK: UInt32 = 0;
    const ERR_FILE_NOT_FOUND: UInt32 = 1;
    const ERR_INVALID_FORMAT: UInt32 = 2;
    const ERR_INVALID_ADDRESS: UInt32 = 8;
    const ERR_INVALID_ENTRY: UInt32 = 9;
    const ERR_WRITE_FAILED: UInt32 = 10;
    const ERR_INVALID_IMAGE: UInt32 = 11;
    const ERR_EMPTY_INPUT: UInt32 = 15;

    proc K::is_error(code: UInt32) -> UInt32 {
        if code == ERR_OK {
            return 0;
        } else {
            return 1;
        }
    }

    proc K::format_supported(format: UInt32) -> UInt32 {
        if format == FORMAT_ELF64 {
            return 1;
        } else {
            if format == FORMAT_FLAT {
                return 1;
            } else {
                if format == FORMAT_MBR {
                    return 1;
                } else {
                    if format == FORMAT_PE64 {
                        return 1;
                    } else {
                        if format == FORMAT_MACHO64 {
                            return 1;
                        } else {
                            if format == FORMAT_WASM {
                                return 1;
                            } else {
                                return 0;
                            }
                        }
                    }
                }
            }
        }
    }

    proc K::is_riscv_target(target: UInt32) -> UInt32 {
        if target == TARGET_RISCV64_LINUX { return 1; }
        if target == TARGET_RISCV32_LINUX { return 1; }
        if target == TARGET_RISCV64_ELF { return 1; }
        if target == TARGET_RISCV32_ELF { return 1; }
        return 0;
    }

    proc K::is_arm_target(target: UInt32) -> UInt32 {
        if target == TARGET_ARM64_LINUX { return 1; }
        if target == TARGET_ARM32_LINUX { return 1; }
        if target == TARGET_ARM32_EABI { return 1; }
        return 0;
    }

    proc K::get_elf_machine_type(target: UInt32) -> UInt16 {
        if target == TARGET_X86_64_LINUX { return 62; }
        if target == TARGET_X86_64_WINDOWS { return 62; }
        if target == TARGET_X86_64_MACOS { return 62; }
        if target == TARGET_AARCH64_LINUX { return 183; }
        if target == TARGET_AARCH64_WINDOWS { return 183; }
        if target == TARGET_AARCH64_MACOS { return 183; }
        if target == TARGET_RISCV64_LINUX { return 243; }
        if target == TARGET_RISCV32_LINUX { return 243; }
        if target == TARGET_RISCV64_ELF { return 243; }
        if target == TARGET_RISCV32_ELF { return 243; }
        if target == TARGET_ARM64_LINUX { return 183; }
        if target == TARGET_ARM32_LINUX { return 40; }
        if target == TARGET_ARM32_EABI { return 40; }
        if target == TARGET_PPC64_LINUX { return 21; }
        if target == TARGET_PPC64LE_LINUX { return 21; }
        if target == TARGET_PPC32_LINUX { return 20; }
        if target == TARGET_PPC32_VLE { return 20; }
        if target == TARGET_MIPS64_ELF { return 8; }
        if target == TARGET_MIPS32_ELF { return 8; }
        if target == TARGET_MIPS32EL_ELF { return 8; }
        if target == TARGET_MIPS64EL_ELF { return 8; }
        if target == TARGET_AMDGPU_GFX600 { return 224; }
        if target == TARGET_AMDGPU_GFX700 { return 224; }
        if target == TARGET_AMDGPU_GFX800 { return 224; }
        if target == TARGET_AMDGPU_GFX900 { return 224; }
        if target == TARGET_AMDGPU_GFX906 { return 224; }
        if target == TARGET_AMDGPU_GFX908 { return 224; }
        if target == TARGET_AMDGPU_GFX90A { return 224; }
        if target == TARGET_AMDGPU_GFX940 { return 224; }
        if target == TARGET_HEXAGON_ELF { return 164; }
        if target == TARGET_SPARC64_ELF { return 2; }
        if target == TARGET_SPARC32_ELF { return 2; }
        return 0;
    }

    proc K::is_ppc_target(target: UInt32) -> UInt32 {
        if target == TARGET_PPC64_LINUX { return 1; }
        if target == TARGET_PPC64LE_LINUX { return 1; }
        if target == TARGET_PPC32_LINUX { return 1; }
        if target == TARGET_PPC32_VLE { return 1; }
        return 0;
    }

    proc K::is_mips_target(target: UInt32) -> UInt32 {
        if target == TARGET_MIPS64_ELF { return 1; }
        if target == TARGET_MIPS32_ELF { return 1; }
        if target == TARGET_MIPS32EL_ELF { return 1; }
        if target == TARGET_MIPS64EL_ELF { return 1; }
        return 0;
    }

    proc K::is_amdgpu_target(target: UInt32) -> UInt32 {
        if target == TARGET_AMDGPU_GFX600 { return 1; }
        if target == TARGET_AMDGPU_GFX700 { return 1; }
        if target == TARGET_AMDGPU_GFX800 { return 1; }
        if target == TARGET_AMDGPU_GFX900 { return 1; }
        if target == TARGET_AMDGPU_GFX906 { return 1; }
        if target == TARGET_AMDGPU_GFX908 { return 1; }
        if target == TARGET_AMDGPU_GFX90A { return 1; }
        if target == TARGET_AMDGPU_GFX940 { return 1; }
        return 0;
    }

    proc K::is_hexagon_target(target: UInt32) -> UInt32 {
        if target == TARGET_HEXAGON_ELF { return 1; }
        return 0;
    }

    proc K::is_sparc_target(target: UInt32) -> UInt32 {
        if target == TARGET_SPARC64_ELF { return 1; }
        if target == TARGET_SPARC32_ELF { return 1; }
        return 0;
    }

    proc K::route_phase2_pipeline(
        object_count: UInt32,
        output_file: UInt64,
        format: UInt32,
        entry: UInt64,
        base: UInt64
    ) -> UInt32 {
        if object_count == 0 {
            return ERR_EMPTY_INPUT;
        } else {
            return link_internal(
                object_count,
                format,
                TARGET_NONE,
                output_file,
                entry,
                base
            );
        }
    }

    proc K::link(input_files: UInt64, output_file: UInt64, format: UInt32) -> UInt32 {
        if input_files == 0 {
            return ERR_EMPTY_INPUT;
        } else {
            let format_status = set_output_format(format);
            if is_error(format_status) == 1 {
                return format_status;
            } else {
                let output_status = set_output(output_file);
                if is_error(output_status) == 1 {
                    return output_status;
                } else {
                    return route_phase2_pipeline(input_files, output_file, format, 1048576, 65536);
                }
            }
        }
    }

    proc K::link_with_options(
        input_files: UInt64,
        output_file: UInt64,
        format: UInt32,
        entry: UInt64,
        base: UInt64
    ) -> UInt32 {
        if input_files == 0 {
            return ERR_EMPTY_INPUT;
        } else {
            let output_status = set_output(output_file);
            if is_error(output_status) == 1 {
                return output_status;
            } else {
                let format_status = set_output_format(format);
                if is_error(format_status) == 1 {
                    return format_status;
                } else {
                    let entry_status = set_entry_point(entry);
                    if is_error(entry_status) == 1 {
                        return entry_status;
                    } else {
                        let base_status = set_base_address(base);
                        if is_error(base_status) == 1 {
                            return base_status;
                        } else {
                            return route_phase2_pipeline(input_files, output_file, format, entry, base);
                        }
                    }
                }
            }
        }
    }

    proc K::add_input_file(path: UInt64) -> UInt32 {
        if path == 0 {
            return ERR_FILE_NOT_FOUND;
        } else {
            return add_object_file(path);
        }
    }

    proc K::set_output(path: UInt64) -> UInt32 {
        if path == 0 {
            return ERR_WRITE_FAILED;
        } else {
            return linker_link_set_output(path);
        }
    }

    proc K::set_output_format(format: UInt32) -> UInt32 {
        if format_supported(format) == 0 {
            return ERR_INVALID_FORMAT;
        } else {
            return set_image_format(format);
        }
    }

    proc K::set_entry_point(addr: UInt64) -> UInt32 {
        if addr == 0 {
            return ERR_INVALID_ENTRY;
        } else {
            return set_entry(addr);
        }
    }

    proc K::set_base_address(addr: UInt64) -> UInt32 {
        if addr == 0 {
            return ERR_INVALID_ADDRESS;
        } else {
            if addr < 4096 {
                return ERR_INVALID_ADDRESS;
            } else {
                return linker_link_set_base_address(addr);
            }
        }
    }

    proc K::add_search_path(path: UInt64) -> UInt32 {
        if path == 0 {
            return ERR_FILE_NOT_FOUND;
        } else {
            return linker_link_add_search_path(path);
        }
    }

    proc K::set_use_default_search_paths(enabled: UInt32) -> UInt32 {
        return host_linker_set_use_default_search_paths(enabled);
    }

    proc K::get_use_default_search_paths() -> UInt32 {
        return host_linker_get_use_default_search_paths();
    }

    proc K::block_default_library(name: UInt64) -> UInt32 {
        if name == 0 {
            return ERR_INVALID_FORMAT;
        } else {
            return host_linker_block_default_library(name);
        }
    }

    proc K::is_default_library_blocked(name: UInt64) -> UInt32 {
        if name == 0 {
            return 0;
        } else {
            return host_linker_is_default_library_blocked(name);
        }
    }

    proc K::set_sysroot(path: UInt64) -> UInt32 {
        if path == 0 {
            return ERR_FILE_NOT_FOUND;
        } else {
            return host_linker_set_sysroot(path);
        }
    }

    proc K::add_rpath(path: UInt64) -> UInt32 {
        if path == 0 {
            return ERR_FILE_NOT_FOUND;
        } else {
            return host_linker_add_rpath(path);
        }
    }

    proc K::add_rpath_link(path: UInt64) -> UInt32 {
        if path == 0 {
            return ERR_FILE_NOT_FOUND;
        } else {
            return host_linker_add_rpath_link(path);
        }
    }

    proc K::set_target(target: UInt32) -> UInt32 {
        if target == TARGET_NONE {
            return LinkerLink::K::set_target(TARGET_NONE);
        } else {
            if target == TARGET_X86_64_LINUX {
                return LinkerLink::K::set_target(TARGET_X86_64_LINUX);
            } else {
                if target == TARGET_X86_64_WINDOWS {
                    return LinkerLink::K::set_target(TARGET_X86_64_WINDOWS);
                } else {
                    if target == TARGET_X86_64_MACOS {
                        return LinkerLink::K::set_target(TARGET_X86_64_MACOS);
                    } else {
                        if target == TARGET_AARCH64_LINUX {
                            return LinkerLink::K::set_target(TARGET_AARCH64_LINUX);
                        } else {
                            if target == TARGET_AARCH64_WINDOWS {
                                return LinkerLink::K::set_target(TARGET_AARCH64_WINDOWS);
                            } else {
                                if target == TARGET_AARCH64_MACOS {
                                    return LinkerLink::K::set_target(TARGET_AARCH64_MACOS);
                                } else {
                                    return LinkerLink::K::set_target(target);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    proc K::add_library(name: UInt64) -> UInt32 {
        if name == 0 {
            return ERR_FILE_NOT_FOUND;
        } else {
            return linker_link_add_library(name);
        }
    }

    proc K::start_group() -> UInt32 {
        return LinkerArchive::K::start_group();
    }

    proc K::end_group_and_resolve() -> UInt32 {
