// Host CLI dispatch tests for DustLink migration path.

forge LinkerHostCliTests {
    const ERR_OK: UInt32 = 0;
    const ERR_MISSING_FLAG_VALUE: UInt32 = 13;
    const ERR_EMPTY_INPUT: UInt32 = 15;
    const FORMAT_ELF64: UInt32 = 1;
    const FORMAT_BINARY: UInt32 = 2;
    const FORMAT_MBR: UInt32 = 3;
    const FORMAT_PE64: UInt32 = 4;
    const FORMAT_MACHO64: UInt32 = 5;

    const TARGET_X86_64_LINUX: UInt32 = 1;
    const TARGET_X86_64_WINDOWS: UInt32 = 2;
    const TARGET_X86_64_MACOS: UInt32 = 3;

    proc K::expect_u32(actual: UInt32, expected: UInt32) -> UInt32 {
        if actual == expected {
            return 1;
        } else {
            return 0;
        }
    }

    proc K::test_run_default_requires_input() -> UInt32 {
        let status = LinkerHostCli::K::run_default_link(1);
        return expect_u32(status, ERR_EMPTY_INPUT);
    }

    proc K::test_output_flag_requires_value() -> UInt32 {
        let status = LinkerHostCli::K::run_with_output_flag(2);
        return expect_u32(status, ERR_MISSING_FLAG_VALUE);
    }

    proc K::test_oformat_flag_requires_value() -> UInt32 {
        let status = LinkerHostCli::K::run_with_oformat_flag(2);
        return expect_u32(status, ERR_MISSING_FLAG_VALUE);
    }

    proc K::test_entry_flag_requires_value() -> UInt32 {
        let status = LinkerHostCli::K::run_with_entry_flag(2);
        return expect_u32(status, ERR_MISSING_FLAG_VALUE);
    }

    proc K::test_image_base_flag_requires_value() -> UInt32 {
        let status = LinkerHostCli::K::run_with_image_base_flag(2);
        return expect_u32(status, ERR_MISSING_FLAG_VALUE);
    }

    proc K::test_oformat_elf64_constant() -> UInt32 {
        return expect_u32(FORMAT_ELF64, 1);
    }

    proc K::test_oformat_binary_constant() -> UInt32 {
        return expect_u32(FORMAT_BINARY, 2);
    }

    proc K::test_oformat_mbr_constant() -> UInt32 {
        return expect_u32(FORMAT_MBR, 3);
    }

    proc K::test_oformat_pe_alias() -> UInt32 {
        let format = LinkerHostCli::K::resolve_oformat("pei-x86-64");
        return expect_u32(format, FORMAT_PE64);
    }

    proc K::test_oformat_macho_alias() -> UInt32 {
        let format = LinkerHostCli::K::resolve_oformat("macho-x86-64");
        return expect_u32(format, FORMAT_MACHO64);
    }

    proc K::test_target_windows_alias() -> UInt32 {
        let target = LinkerHostCli::K::resolve_target("x86_64-windows-msvc");
        return expect_u32(target, TARGET_X86_64_WINDOWS);
    }

    proc K::test_target_macos_alias() -> UInt32 {
        let target = LinkerHostCli::K::resolve_target("x86_64-apple-darwin");
        return expect_u32(target, TARGET_X86_64_MACOS);
    }

    proc K::test_target_linux_alias() -> UInt32 {
        let target = LinkerHostCli::K::resolve_target("elf_x86_64");
        return expect_u32(target, TARGET_X86_64_LINUX);
    }

    proc K::test_default_format_for_windows_target() -> UInt32 {
        let format = LinkerHostCli::K::default_format_for_target(TARGET_X86_64_WINDOWS);
        return expect_u32(format, FORMAT_PE64);
    }

    proc K::test_default_format_for_macos_target() -> UInt32 {
        let format = LinkerHostCli::K::default_format_for_target(TARGET_X86_64_MACOS);
        return expect_u32(format, FORMAT_MACHO64);
    }

    proc K::test_inline_undefined_short_alias() -> UInt32 {
        let token = LinkerHostCli::K::inline_undefined_value("-uputs");
        return expect_u32(LinkerHost::K::str_eq(token, "puts"), 1);
    }

    proc K::test_undefined_flag_requires_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("--undefined");
        return expect_u32(required, 1);
    }

    proc K::test_require_defined_flag_requires_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("--require-defined");
        return expect_u32(required, 1);
    }

    proc K::test_no_undefined_flag_no_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("--no-undefined");
        return expect_u32(required, 0);
    }

    proc K::test_allow_shlib_undefined_flag_no_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("--allow-shlib-undefined");
        return expect_u32(required, 0);
    }

    proc K::test_whole_archive_flag_no_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("--whole-archive");
        return expect_u32(required, 0);
    }

    proc K::test_no_whole_archive_flag_no_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("--no-whole-archive");
        return expect_u32(required, 0);
    }

    proc K::test_sysroot_flag_requires_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("--sysroot");
        return expect_u32(required, 1);
    }

    proc K::test_rpath_flag_requires_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("-rpath");
        return expect_u32(required, 1);
    }

    proc K::test_rpath_link_flag_requires_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("-rpath-link");
        return expect_u32(required, 1);
    }

    proc K::test_inline_sysroot_value() -> UInt32 {
        let value = LinkerHostCli::K::inline_sysroot_value("--sysroot=/opt/sysroot");
        return expect_u32(LinkerHost::K::str_eq(value, "/opt/sysroot"), 1);
    }

    proc K::test_inline_rpath_value() -> UInt32 {
        let value = LinkerHostCli::K::inline_rpath_value("-rpath/usr/lib");
        return expect_u32(LinkerHost::K::str_eq(value, "/usr/lib"), 1);
    }

    proc K::test_inline_rpath_link_value() -> UInt32 {
        let value = LinkerHostCli::K::inline_rpath_link_value("-rpath-link/usr/lib");
        return expect_u32(LinkerHost::K::str_eq(value, "/usr/lib"), 1);
    }

    proc K::test_rpath_link_not_parsed_as_rpath() -> UInt32 {
        let value = LinkerHostCli::K::inline_rpath_value("-rpath-link/usr/lib");
        if value == 0 {
            return 1;
        } else {
            return 0;
        }
    }

    proc K::test_build_id_inline_value() -> UInt32 {
        let value = LinkerHostCli::K::inline_build_id_value("--build-id=sha1");
        return expect_u32(LinkerHost::K::str_eq(value, "sha1"), 1);
    }

    proc K::test_build_id_bare_flag_no_required_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("--build-id");
        return expect_u32(required, 0);
    }

    proc K::test_z_flag_requires_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("-z");
        return expect_u32(required, 1);
    }

    proc K::test_inline_z_short_alias() -> UInt32 {
        let token = LinkerHostCli::K::inline_z_value("-zrelro");
        return expect_u32(LinkerHost::K::str_eq(token, "relro"), 1);
    }

    proc K::test_group_markers_detected() -> UInt32 {
        let a = LinkerHostCli::K::is_start_group_flag("--start-group");
        let b = LinkerHostCli::K::is_end_group_flag("--end-group");
        return expect_u32(a, 1) * expect_u32(b, 1);
    }

    proc K::test_inline_dynamic_linker_value() -> UInt32 {
        let value = LinkerHostCli::K::inline_dynamic_linker_value("--dynamic-linker=/lib64/ld-linux-x86-64.so.2");
        return expect_u32(LinkerHost::K::str_eq(value, "/lib64/ld-linux-x86-64.so.2"), 1);
    }

    proc K::test_inline_soname_value() -> UInt32 {
        let value = LinkerHostCli::K::inline_soname_value("--soname=libdemo.so");
        return expect_u32(LinkerHost::K::str_eq(value, "libdemo.so"), 1);
    }

    proc K::test_dynamic_linker_requires_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("--dynamic-linker");
        return expect_u32(required, 1);
    }

    proc K::test_soname_requires_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("--soname");
        return expect_u32(required, 1);
    }

    proc K::test_shared_flag_no_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("-shared");
        return expect_u32(required, 0);
    }

    proc K::test_pie_flag_no_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("-pie");
        return expect_u32(required, 0);
    }

    proc K::test_enable_new_dtags_flag_no_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("--enable-new-dtags");
        return expect_u32(required, 0);
    }

    proc K::test_disable_new_dtags_flag_no_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("--disable-new-dtags");
        return expect_u32(required, 0);
    }

    proc K::test_copy_dt_needed_entries_flag_no_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("--copy-dt-needed-entries");
        return expect_u32(required, 0);
    }

    proc K::test_no_copy_dt_needed_entries_flag_no_value() -> UInt32 {
        let required = LinkerHostCli::K::requires_value("--no-copy-dt-needed-entries");
        return expect_u32(required, 0);
    }

    proc K::test_ok_constant() -> UInt32 {
        return expect_u32(ERR_OK, 0);
    }

    proc K::run_all_tests() -> UInt32 {
        let passed =
            test_run_default_requires_input()
            + test_output_flag_requires_value()
            + test_oformat_flag_requires_value()
            + test_entry_flag_requires_value()
            + test_image_base_flag_requires_value()
            + test_oformat_elf64_constant()
            + test_oformat_binary_constant()
            + test_oformat_mbr_constant()
            + test_oformat_pe_alias()
            + test_oformat_macho_alias()
            + test_target_windows_alias()
            + test_target_macos_alias()
            + test_target_linux_alias()
            + test_default_format_for_windows_target()
            + test_default_format_for_macos_target()
            + test_inline_undefined_short_alias()
            + test_undefined_flag_requires_value()
            + test_require_defined_flag_requires_value()
            + test_no_undefined_flag_no_value()
            + test_allow_shlib_undefined_flag_no_value()
            + test_whole_archive_flag_no_value()
            + test_no_whole_archive_flag_no_value()
            + test_sysroot_flag_requires_value()
            + test_rpath_flag_requires_value()
            + test_rpath_link_flag_requires_value()
            + test_inline_sysroot_value()
            + test_inline_rpath_value()
            + test_inline_rpath_link_value()
            + test_rpath_link_not_parsed_as_rpath()
            + test_build_id_inline_value()
            + test_build_id_bare_flag_no_required_value()
            + test_z_flag_requires_value()
            + test_inline_z_short_alias()
            + test_group_markers_detected()
            + test_inline_dynamic_linker_value()
            + test_inline_soname_value()
            + test_dynamic_linker_requires_value()
            + test_soname_requires_value()
            + test_shared_flag_no_value()
            + test_pie_flag_no_value()
            + test_enable_new_dtags_flag_no_value()
            + test_disable_new_dtags_flag_no_value()
            + test_copy_dt_needed_entries_flag_no_value()
            + test_no_copy_dt_needed_entries_flag_no_value()
            + test_ok_constant();
        return passed;
    }
}
