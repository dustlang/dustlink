// Description:
// Host runtime shim layer for DustLink.
// Provides host_* functions that Dust linker modules call to interact with
// the underlying operating system and host runtime environment.
//
// Sources:
// Converted from hostlinker_shim.c - Original Layer 0 and Layer 1 host runtime shim

forge ShimHost {
//
// Shape Type Declarations (Dust v0.2 §5 Type System)
//
shape FileHandle {
    fd: Int32,
    path: UInt64,
    mode: UInt32,
    valid: Bool
}

shape MappedRegion {
    base_addr: UInt64,
    length: UInt64,
    offset: Int64,
    prot: UInt32,
    valid: Bool
}

shape ProcessHandle {
    pid: Int32,
    exit_code: Int32,
    status: ProcessStatus,
    valid: Bool
}

enum ProcessStatus {
    Running,
    Stopped,
    Exited,
    Error
}

shape HostError {
    code: Int32,
    message: UInt64,
    context: UInt64,
    recoverable: Bool
}

shape OutputImage {
    path: UInt64,
    file_format: UInt32,
    type_val: UInt32,
    arch_val: UInt32,
    entry_val: UInt64,
    flags_val: UInt32,
    build_id_ptr: UInt64,
    build_id_len: UInt32,
    valid: Bool
}

shape ObjectMetadata {
    path: UInt64,
    file_size: UInt64,
    file_format: UInt16,
    machine: UInt16,
    section_count: UInt32,
    symbol_count: UInt32
}

//
// Effect Declarations (Dust v0.2 §6 Effects)
// All host interactions have explicit effects
//
observe host_read;
observe host_write;
observe host_file_open;
observe host_file_close;
observe host_mmap;
observe host_munmap;
observe host_alloc;
observe host_env_get;

emit host_path_check;
emit host_file_created;
emit host_file_truncated;
emit host_env_set;
emit host_process_spawn;
emit host_process_wait;
emit host_process_kill;
emit host_log_stdout;
emit host_log_stderr;

seal host_linker_build;
seal host_error_log;

/*
 * =============================================================================
 * Layer 0: Host FFI Constants and Error Codes
 * =============================================================================
 */

// Standard C library open() flags
const O_RDONLY: UInt32 = 0;
const O_RDWR: UInt32 = 2;
const O_CREAT: UInt32 = 64;
const O_TRUNC: UInt32 = 512;
const O_WRONLY: UInt32 = 1;

// Memory protection flags for mmap
const PROT_READ: UInt32 = 1;
const PROT_WRITE: UInt32 = 2;
const PROT_EXEC: UInt32 = 4;

// Memory mapping flags
const MAP_PRIVATE: UInt32 = 2;
const MAP_ANONYMOUS: UInt32 = 32;

// Seek whence values
const SEEK_SET: UInt32 = 0;
const SEEK_CUR: UInt32 = 1;
const SEEK_END: UInt32 = 2;

// Standard file descriptors
const STDIN_FILENO: UInt32 = 0;
const STDOUT_FILENO: UInt32 = 1;
const STDERR_FILENO: UInt32 = 2;

// Exit codes
const EXIT_SUCCESS: UInt32 = 0;
const EXIT_FAILURE: UInt32 = 1;

/*
 * =============================================================================
 * Shape Type Declarations (Dust v0.2)
 * Resource types for host operations following §5 Type System
 * =============================================================================
 */

// File handle descriptor
shape FileHandle {
    fd: Int32,
    path: UInt64,
    mode: UInt32,
    valid: Bool
}

// Memory-mapped region descriptor
shape MappedRegion {
    base_addr: UInt64,
    length: UInt64,
    offset: Int64,
    prot: UInt32,
    valid: Bool
}

// Process execution handle
shape ProcessHandle {
    pid: Int32,
    exit_code: Int32,
    status: ProcessStatus,
    valid: Bool
}

enum ProcessStatus {
    Running,
    Stopped,
    Exited,
    Error
}

// Host error information
shape HostError {
    code: Int32,
    message: UInt64,
    context: UInt64,
    recoverable: Bool
}

// String comparison result
shape StrResult {
    equal: Bool,
    length: UInt32
}

// Archive member metadata
shape ArchiveMember {
    path: UInt64,
    index: UInt32,
    is_64bit: Bool,
    is_littleendian: Bool,
    file_format: UInt32
}

// Output image state
shape OutputImage {
    path: UInt64,
    file_format: UInt32,
    type_val: UInt32,
    arch_val: UInt32,
    entry_val: UInt64,
    flags_val: UInt32,
    build_id_ptr: UInt64,
    build_id_len: UInt32,
    valid: Bool
}

// Object file metadata
shape ObjectMetadata {
    path: UInt64,
    file_size: UInt64,
    file_format: UInt16,
    machine: UInt16,
    section_count: UInt32,
    symbol_count: UInt32
}

/*
 * =============================================================================
 * Effect Declarations (Dust v0.2 §6)
 * All host interactions have explicit effects
 * =============================================================================
 */

// Host I/O observation effects (information acquired from host)
observe host_read;        // Bytes read from file/device
observe host_write;       // Bytes written to file/device
observe host_file_open;   // File handle obtained
observe host_file_close;  // File handle released
observe host_mmap;        // Memory region mapped
observe host_munmap;      // Memory region unmapped
observe host_alloc;       // Memory allocated
observe host_env_get;     // Environment variable read

// Host I/O emission effects (irreversible actions)
emit host_path_check;     // Path existence checked
emit host_file_created;   // New file created
emit host_file_truncated; // File truncated
emit host_env_set;        // Environment variable modified
emit host_process_spawn;  // Process started
emit host_process_wait;   // Process waited
emit host_process_kill;   // Process terminated

// Host logging effects
emit host_log_stdout;     // Output to stdout
emit host_log_stderr;     // Output to stderr

// Sealed entries (irreversible permanent records)
seal host_linker_build;   // Build artifact recorded
seal host_error_log;      // Error committed to log

/*
 * =============================================================================
 * Layer 0: CLI Argument Access (host_args_*)
 * Original C signatures:
 * - uint32_t host_args_count(void);
 * - void host_args_get(uint64_t *argv_ptr, uint64_t argv_buf_ptr);
 * - uint64_t host_arg_at(uint32_t index);
 * - void host_args_sizes_get(uint64_t argc_out, uint64_t argv_buf_size_out);
 * =============================================================================
 */

// Get number of command line arguments
proc K::host_args_count() -> UInt32 {
return 0;
}

// Retrieve all command line arguments into provided buffers
// argv_ptr: pointer to array to store argument string pointers
// argv_buf_ptr: pointer to buffer to store argument string data
proc K::host_args_get(argv_ptr: UInt64, argv_buf_ptr: UInt64) {
return;
}

// Get a single command line argument at specified index
// Returns: pointer to argument string, or 0 if index out of bounds
proc K::host_arg_at(index: UInt32) -> UInt64 {
return 0;
}

// Get argument metadata: count and total buffer size needed
// argc_out: pointer to store argument count
// argv_buf_size_out: pointer to store total buffer size
proc K::host_args_sizes_get(argc_out: UInt64, argv_buf_size_out: UInt64) {
return;
}

/*
 * =============================================================================
 * Layer 0: Environment Variable Access (host_env_*)
 * Original C signatures:
 * - uint64_t host_env_get(const char *name);
 * - void host_env_set(const char *name, const char *value);
 * =============================================================================
 */

// Get environment variable value by name
// name: pointer to null-terminated environment variable name
// Returns: pointer to value string, or 0 if not found
proc K::host_env_get(name: UInt64) -> UInt64 {
return 0;
}

// Set environment variable (implementation may vary by platform)
// name: pointer to null-terminated variable name
// value: pointer to null-terminated value string
proc K::host_env_set(name: UInt64, value: UInt64) {
return;
}

/*
 * =============================================================================
 * Layer 0: Path and File Operations (host_path_*, host_file_*)
 * Original C signatures:
 * - uint32_t host_path_exists(const char *path);
 * - uint32_t host_path_is_file(const char *path);
 * - int64_t host_file_open(const char *pathname, uint32_t flags, uint32_t mode);
 * - int64_t host_file_close(uint32_t fd);
 * - int64_t host_file_read(uint32_t fd, void *buf, size_t count);
 * - int64_t host_file_write(uint32_t fd, const void *buf, size_t count);
 * - int64_t host_file_seek(uint32_t fd, int64_t offset, uint32_t whence);
 * - int64_t host_file_tell(uint32_t fd);
 * =============================================================================
 */

// Check if a path exists
// path: pointer to null-terminated path string
// Returns: 1 if exists, 0 otherwise
proc K::host_path_exists(path: UInt64) -> UInt32 {
return 0;
}

// Check if a path points to a regular file (not directory)
// path: pointer to null-terminated path string
// Returns: 1 if file, 0 otherwise
proc K::host_path_is_file(path: UInt64) -> UInt32 {
return 0;
}

// Open a file with specified flags and mode
// pathname: pointer to null-terminated file path
// flags: open flags (O_RDONLY, O_RDWR, O_CREAT, etc.)
// mode: file mode/permissions (when creating)
// Returns: file descriptor (non-negative) or error (< 0)
proc K::host_file_open(pathname: UInt64, flags: UInt32, mode: UInt32) -> Int64 {
return 0;
}

// Close an open file descriptor
// fd: file descriptor to close
// Returns: 0 on success, negative on error
proc K::host_file_close(fd: UInt32) -> Int64 {
return 0;
}

// Read from an open file
// fd: file descriptor
// buf: pointer to buffer to store read data
// count: number of bytes to read
// Returns: number of bytes read, or negative on error
proc K::host_file_read(fd: UInt32, buf: UInt64, count: UInt64) -> Int64 {
return 0;
}

// Write to an open file
// fd: file descriptor
// buf: pointer to buffer containing data to write
// count: number of bytes to write
// Returns: number of bytes written, or negative on error
proc K::host_file_write(fd: UInt32, buf: UInt64, count: UInt64) -> Int64 {
return 0;
}

// Seek to a position in a file
// fd: file descriptor
// offset: offset from whence position
// whence: SEEK_SET, SEEK_CUR, or SEEK_END
// Returns: new file position, or negative on error
proc K::host_file_seek(fd: UInt32, offset: Int64, whence: UInt32) -> Int64 {
return 0;
}

// Get current position in a file
// fd: file descriptor
// Returns: current file offset, or negative on error
proc K::host_file_tell(fd: UInt32) -> Int64 {
return 0;
}

// Map a file or anonymous memory into address space
// addr: preferred address (or 0 for system choice)
// length: size of mapping
// prot: protection flags (PROT_READ, PROT_WRITE, etc.)
// flags: mapping flags (MAP_PRIVATE, MAP_ANONYMOUS, etc.)
// fd: file descriptor (or -1 for anonymous)
// offset: offset in file
// Returns: mapped address, or negative on error
proc K::host_mmap(addr: UInt64, length: UInt64, prot: UInt32, flags: UInt32, fd: Int64, offset: Int64) -> Int64 {
return 0;
}

// Unmap memory mapping
// addr: mapped address from host_mmap
// length: size of mapping
// Returns: 0 on success, negative on error
proc K::host_munmap(addr: UInt64, length: UInt64) -> Int32 {
return 0;
}

/*
 * =============================================================================
 * Layer 0: Output and Logging (host_write_*)
 * Original C signatures:
 * - void host_write_stdout(const char *s);
 * - void host_write_stderr(const char *s);
 * =============================================================================
 */

// Write string to standard output
// s: pointer to null-terminated string
proc K::host_write_stdout(s: UInt64) {
return;
}

// Write string to standard error
// s: pointer to null-terminated string
proc K::host_write_stderr(s: UInt64) {
return;
}

/*
 * =============================================================================
 * Layer 0: Memory Allocation (host_alloc_*)
 * Original C signatures (wrappers):
 * - void *host_alloc(uint64_t size);
 * - void host_free(void *ptr);
 * =============================================================================
 */

// Allocate memory
// size: number of bytes to allocate
