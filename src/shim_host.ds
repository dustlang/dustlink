//
// Binding Contracts (Dust v0.2 §10)
// Specify contractual obligations for cross-module integration
//
bind host_file_open -> host_file_read contract {
    valid_handle = true,
    sequential = true,
    handle_not_closed = true
}

bind host_file_open -> host_file_write contract {
    valid_handle = true,
    sequential = true,
    write_mode = true
}

bind host_file_read -> host_file_close contract {
    handle_valid_until_close = true
}

bind host_file_write -> host_file_close contract {
    handle_valid_until_close = true
}

bind host_mmap -> host_munmap contract {
    region_valid = true,
    bounds_checked = true,
    no_overflow = true
}

bind host_process_spawn -> host_process_wait contract {
    process_exists = true,
    wait_once = true
}

bind host_process_spawn -> host_process_kill contract {
    process_exists = true,
    kill_requires_valid_pid = true
}

bind host_archive_member_count -> host_archive_read_member contract {
    member_index_valid = true,
    read_before_reopen = true
}

bind host_output_begin -> host_output_emit contract {
    output_initialized = true,
    no_partial_output = true
}

bind host_output_set_entry -> host_output_emit contract {
    entry_point_set = true,
    valid_address = true
}
}
