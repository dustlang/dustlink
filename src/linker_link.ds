// DustLink object/link stage orchestration for the internal linker pipeline.

forge LinkerLink {
    const LINKER_NONE: UInt32 = 0;
    const LINKER_INTERNAL: UInt32 = 1;
    const LINKER_INTERNAL_MVP: UInt32 = 1;
    const LINKER_EXTERNAL_COMPAT: UInt32 = 2;

    const FORMAT_ELF64: UInt32 = 1;
    const FORMAT_FLAT: UInt32 = 2;
    const FORMAT_MBR: UInt32 = 3;
    const FORMAT_PE64: UInt32 = 4;
    const FORMAT_MACHO64: UInt32 = 5;

    const OBJECT_FORMAT_UNKNOWN: UInt32 = 0;
    const OBJECT_FORMAT_ELF64: UInt32 = 1;
    const OBJECT_FORMAT_COFF64: UInt32 = 2;
    const OBJECT_FORMAT_MACHO64: UInt32 = 3;

    const TARGET_NONE: UInt32 = 0;
    const TARGET_X86_64_LINUX: UInt32 = 1;
    const TARGET_X86_64_WINDOWS: UInt32 = 2;
    const TARGET_X86_64_MACOS: UInt32 = 3;
    const TARGET_AARCH64_LINUX: UInt32 = 4;
    const TARGET_AARCH64_WINDOWS: UInt32 = 5;
    const TARGET_AARCH64_MACOS: UInt32 = 6;

    const INTERNAL_LINKER_PATH_ID: UInt64 = 4097;

    const ERR_OK: UInt32 = 0;
    const ERR_FILE_NOT_FOUND: UInt32 = 1;
    const ERR_INVALID_FORMAT: UInt32 = 2;
    const ERR_UNDEFINED_SYMBOL: UInt32 = 4;
    const ERR_INVALID_RELOCATION: UInt32 = 6;
    const ERR_INVALID_ADDRESS: UInt32 = 8;
    const ERR_INVALID_ENTRY: UInt32 = 9;
    const ERR_WRITE_FAILED: UInt32 = 10;
    const ERR_INVALID_IMAGE: UInt32 = 11;
    const ERR_UNSUPPORTED_FLAG: UInt32 = 12;
    const ERR_UNSUPPORTED_TARGET: UInt32 = 14;
    const ERR_EMPTY_INPUT: UInt32 = 15;
    const ERR_NOT_IMPLEMENTED_YET: UInt32 = 17;

    proc K::is_supported_target(target: UInt32) -> UInt32 {
        if target == TARGET_NONE {
            return 1;
        } else {
            if target == TARGET_X86_64_LINUX {
                return 1;
            } else {
                if target == TARGET_X86_64_WINDOWS {
                    return 1;
                } else {
                    if target == TARGET_X86_64_MACOS {
                        return 1;
                    } else {
                        if target == TARGET_AARCH64_LINUX {
                            return 1;
                        } else {
                            if target == TARGET_AARCH64_WINDOWS {
                                return 1;
                            } else {
                                if target == TARGET_AARCH64_MACOS {
                                    return 1;
                                } else {
                                    return 0;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    proc K::is_supported_format(format: UInt32) -> UInt32 {
        if format == FORMAT_ELF64 {
            return 1;
        } else {
            if format == FORMAT_FLAT {
                return 1;
            } else {
                if format == FORMAT_MBR {
                    return 1;
                } else {
                    if format == FORMAT_PE64 {
                        return 1;
                    } else {
                        if format == FORMAT_MACHO64 {
                            return 1;
                        } else {
                            return 0;
                        }
                    }
                }
            }
        }
    }

    proc K::validate_object_descriptor(obj: UInt64, file_size: UInt64, kind: UInt32) -> UInt32 {
        if obj == 0 {
            return ERR_FILE_NOT_FOUND;
        } else {
            if file_size == 0 {
                return ERR_FILE_NOT_FOUND;
            } else {
                if kind == OBJECT_FORMAT_UNKNOWN {
                    return ERR_INVALID_FORMAT;
                } else {
                    return ERR_OK;
                }
            }
        }
    }

    proc K::plan_object_set(object_count: UInt32, symbol_count: UInt32, relocation_count: UInt32) -> UInt32 {
        if object_count == 0 {
            return ERR_EMPTY_INPUT;
        } else {
            if symbol_count == 0 {
                return ERR_UNDEFINED_SYMBOL;
            } else {
                if relocation_count > 131072 {
                    return ERR_INVALID_RELOCATION;
                } else {
                    return ERR_OK;
                }
            }
        }
    }

    proc K::ingest_object_by_format(path: UInt64, object_kind: UInt32) -> UInt32 {
        if object_kind == OBJECT_FORMAT_ELF64 {
            return ElfFormat::K::ingest_object_file(path);
        } else {
            if object_kind == OBJECT_FORMAT_COFF64 {
                return host_linker_ingest_coff_object(path);
            } else {
                if object_kind == OBJECT_FORMAT_MACHO64 {
                    return host_linker_ingest_macho_object(path);
                } else {
                    return ERR_INVALID_FORMAT;
                }
            }
        }
    }

    proc K::ingest_path(path: UInt64) -> UInt32 {
        if LinkerArchive::K::is_archive_path(path) == 1 {
            return LinkerArchive::K::ingest_archive(path);
        } else {
            let file_size = LinkerFs::K::file_size(path);
            let object_kind = host_linker_probe_object_format(path);
            let descriptor_status = validate_object_descriptor(path, file_size, object_kind);
            if descriptor_status ! ERR_OK {
                return descriptor_status;
            } else {
                return ingest_object_by_format(path, object_kind);
            }
        }
    }

    proc K::add_object_file(path: UInt64) -> UInt32 {
        let file_status = LinkerFs::K::validate_input_file(path);
        if file_status ! ERR_OK {
            return file_status;
        } else {
            let ingest_status = ingest_path(path);
            if ingest_status ! ERR_OK {
                return ingest_status;
            } else {
                return host_linker_register_input(path);
            }
        }
    }

    proc K::add_library(path: UInt64) -> UInt32 {
        if path == 0 {
            return ERR_FILE_NOT_FOUND;
        } else {
            return LinkerArchive::K::resolve_and_ingest_library(path);
        }
    }

    proc K::add_search_path(path: UInt64) -> UInt32 {
        if path == 0 {
            return ERR_FILE_NOT_FOUND;
        } else {
            if LinkerFs::K::path_exists(path) == 0 {
                return ERR_FILE_NOT_FOUND;
            } else {
                return host_linker_add_search_path(path);
            }
        }
    }

    proc K::set_linker(linker: UInt32) -> UInt32 {
        if linker == LINKER_INTERNAL {
            return ERR_OK;
        } else {
            if linker == LINKER_EXTERNAL_COMPAT {
                return ERR_OK;
            } else {
                return ERR_UNSUPPORTED_FLAG;
            }
        }
    }

    proc K::set_target(target: UInt32) -> UInt32 {
        if is_supported_target(target) == 1 {
            return host_linker_set_target(target);
        } else {
            return ERR_UNSUPPORTED_TARGET;
        }
    }

    proc K::set_output(output: UInt64) -> UInt32 {
        if output == 0 {
            return ERR_WRITE_FAILED;
        } else {
            return host_linker_set_output_path(output);
        }
    }

    proc K::set_entry(entry: UInt64) -> UInt32 {
        if entry == 0 {
            return ERR_INVALID_ENTRY;
        } else {
            return host_linker_set_entry(entry);
        }
    }

    proc K::set_base_address(base: UInt64) -> UInt32 {
        if base == 0 {
            return ERR_INVALID_ADDRESS;
        } else {
            if base < 4096 {
                return ERR_INVALID_ADDRESS;
            } else {
                return host_linker_set_image_base(base);
            }
        }
    }

    proc K::linker_link_set_output(output: UInt64) -> UInt32 {
        return set_output(output);
    }

    proc K::linker_link_set_base_address(base: UInt64) -> UInt32 {
        return set_base_address(base);
    }

    proc K::linker_link_add_search_path(path: UInt64) -> UInt32 {
        return add_search_path(path);
    }

    proc K::linker_link_add_library(path: UInt64) -> UInt32 {
        return add_library(path);
    }

    proc K::ensure_loaded_inputs(expected: UInt32) -> UInt32 {
        let cli_load_status = host_linker_ingest_cli_inputs();
        if cli_load_status ! ERR_OK {
            return cli_load_status;
        } else {
            let loaded_after = host_linker_object_count();
            if loaded_after == 0 {
                return ERR_EMPTY_INPUT;
            } else {
                if loaded_after >= expected {
                    return ERR_OK;
                } else {
                    return ERR_EMPTY_INPUT;
                }
            }
        }
    }

    proc K::resolve_symbols_and_relocs() -> UInt32 {
        let symbol_status = LinkerSymbol::K::resolve_loaded_symbols();
        if symbol_status ! ERR_OK {
            return symbol_status;
        } else {
            let unresolved_status = LinkerSymbol::K::check_unresolved_globals();
            if unresolved_status ! ERR_OK {
                return unresolved_status;
            } else {
                let object_count = host_linker_object_count();
                return LinkerReloc::K::apply_all_relocations(0, object_count);
            }
        }
    }

    proc K::emit_output(
        format: UInt32,
        output: UInt64,
        entry: UInt64,
        base: UInt64
    ) -> UInt32 {
        let payload_size = calculate_image_size();
        let text_size = payload_size;
        if text_size == 0 {
            return ERR_INVALID_IMAGE;
        }
        if format == FORMAT_FLAT {
            let plan_status = compose_flat_image_plan(base, entry, text_size, 0, 0, 0);
            if plan_status ! ERR_OK {
                return plan_status;
            } else {
                return write_flat_output(output);
            }
        } else {
            if format == FORMAT_ELF64 {
                let plan_status_elf = compose_elf_image_plan(base, entry, text_size, 0, 0, 0);
                if plan_status_elf ! ERR_OK {
                    return plan_status_elf;
                } else {
                    return write_elf_output(output, entry, base);
                }
            } else {
                if format == FORMAT_MBR {
                    return host_linker_write_mbr_image(output);
                } else {
                    if format == FORMAT_PE64 {
                        let plan_status_pe = compose_elf_image_plan(base, entry, text_size, 0, 0, 0);
                        if plan_status_pe ! ERR_OK {
                            return plan_status_pe;
                        } else {
                            return host_linker_write_pe_image(output);
                        }
                    } else {
                        if format == FORMAT_MACHO64 {
                            let plan_status_macho = compose_elf_image_plan(base, entry, text_size, 0, 0, 0);
                            if plan_status_macho ! ERR_OK {
                                return plan_status_macho;
                            } else {
                                return host_linker_write_macho_image(output);
                            }
                        } else {
                            return ERR_INVALID_FORMAT;
                        }
                    }
                }
            }
        }
    }

    proc K::link_internal(
        object_count: UInt32,
        format: UInt32,
        target: UInt32,
        output: UInt64,
        entry: UInt64,
        base: UInt64
    ) -> UInt32 {
        if is_supported_format(format) == 0 {
            return ERR_INVALID_FORMAT;
        } else {
            let target_status = set_target(target);
            if target_status ! ERR_OK {
                return target_status;
            } else {
                let output_status = set_output(output);
                if output_status ! ERR_OK {
                    return output_status;
                } else {
                    let entry_status = set_entry(entry);
                    if entry_status ! ERR_OK {
                        return entry_status;
                    } else {
                        let base_status = set_base_address(base);
                        if base_status ! ERR_OK {
                            return base_status;
                        } else {
                            let load_status = ensure_loaded_inputs(object_count);
                            if load_status ! ERR_OK {
                                return load_status;
                            } else {
                                let loaded_objects = host_linker_object_count();
                                let symbol_count = host_linker_total_symbol_count();
                                let relocation_count = host_linker_total_relocation_count();
                                let plan = plan_object_set(loaded_objects, symbol_count, relocation_count);
                                if plan ! ERR_OK {
                                    return plan;
                                } else {
                                    let resolve_status = resolve_symbols_and_relocs();
                                    if resolve_status ! ERR_OK {
                                        return resolve_status;
                                    } else {
                                        return emit_output(format, output, entry, base);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    proc K::link() -> UInt32 {
        let object_count = host_linker_object_count();
        let output = host_linker_get_output_path();
        let format = host_linker_get_output_format();
        let target = host_linker_get_target();
        let entry = host_linker_get_entry();
        let base = host_linker_get_image_base();
        return link_internal(object_count, format, target, output, entry, base);
    }

    proc K::link_with_script(script: UInt64) -> UInt32 {
        if script == 0 {
            return ERR_FILE_NOT_FOUND;
        } else {
            return host_linker_apply_script(script);
        }
    }

    proc K::create_flat_binary(output: UInt64, entry: UInt64) -> UInt32 {
        if output == 0 {
            return ERR_WRITE_FAILED;
        } else {
            if entry == 0 {
                return ERR_INVALID_ENTRY;
            } else {
                return write_flat_output(output);
            }
        }
    }

    proc K::create_mbr_image(output: UInt64, boot_sector: UInt64, kernel: UInt64) -> UInt32 {
        if output == 0 {
            return ERR_WRITE_FAILED;
        } else {
            if boot_sector == 0 {
                return ERR_FILE_NOT_FOUND;
            } else {
                if kernel == 0 {
                    return ERR_FILE_NOT_FOUND;
                } else {
                    return host_linker_write_mbr_boot_image(output, kernel, host_linker_kernel_size(kernel));
                }
            }
        }
    }

    proc K::get_linker_path() -> UInt64 {
        return INTERNAL_LINKER_PATH_ID;
    }

    proc K::find_linker() -> UInt32 {
        return LINKER_INTERNAL;
    }
}
