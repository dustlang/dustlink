// Description:
//   Symbol table parsing and deterministic resolution helpers.
//   Provides:
//     - MAX_SYMBOLS: Maximum symbol count
//     - Symbol binding (SYM_LOCAL, SYM_GLOBAL, SYM_WEAK)
//     - Symbol type definitions
//     - Symbol resolution logic

forge LinkerSymbol {
    const MAX_SYMBOLS: UInt32 = 131072;

    const SYM_LOCAL: UInt8 = 0;
    const SYM_GLOBAL: UInt8 = 1;
    const SYM_WEAK: UInt8 = 2;

    const TYPE_NONE: UInt8 = 0;
    const TYPE_OBJECT: UInt8 = 1;
    const TYPE_FUNC: UInt8 = 2;
    const TYPE_SECTION: UInt8 = 3;
    const TYPE_FILE: UInt8 = 4;

    const BIND_LOCAL: UInt32 = 0;
    const BIND_GLOBAL: UInt32 = 1;
    const BIND_WEAK: UInt32 = 2;

    const SHN_UNDEF: UInt16 = 0;
    const SHN_ABS: UInt16 = 65521;

    const ERR_OK: UInt32 = 0;
    const ERR_INVALID_FORMAT: UInt32 = 2;
    const ERR_INVALID_SECTION: UInt32 = 3;
    const ERR_UNDEFINED_SYMBOL: UInt32 = 4;
    const ERR_MULTIPLE_DEFINITION: UInt32 = 5;

    const UNRESOLVED_POLICY_REPORT_ALL: UInt32 = 0;
    const UNRESOLVED_POLICY_IGNORE_ALL: UInt32 = 1;
    const UNRESOLVED_POLICY_IGNORE_IN_OBJECT_FILES: UInt32 = 2;
    const UNRESOLVED_POLICY_IGNORE_IN_SHARED_LIBS: UInt32 = 3;

    proc K::parse_symbol_bind(info: UInt8) -> UInt8 {
        return info / 16;
    }

    proc K::parse_symbol_type(info: UInt8) -> UInt8 {
        let sym_bind = parse_symbol_bind(info);
        return info - (sym_bind * 16);
    }

    proc K::symbol_is_defined(shndx: UInt16) -> UInt32 {
        if shndx == SHN_UNDEF {
            return 0;
        } else {
            return 1;
        }
    }

    proc K::symbol_is_abs(shndx: UInt16) -> UInt32 {
        if shndx == SHN_ABS {
            return 1;
        } else {
            return 0;
        }
    }

    proc K::validate_symbol_table_shape(symbol_count: UInt32, name_bytes: UInt32) -> UInt32 {
        if symbol_count == 0 {
            return ERR_UNDEFINED_SYMBOL;
        } else {
            if symbol_count > MAX_SYMBOLS {
                return ERR_INVALID_FORMAT;
            } else {
                if name_bytes == 0 {
                    return ERR_INVALID_FORMAT;
                } else {
                    return ERR_OK;
                }
            }
        }
    }

    proc K::add_symbol(
        name: UInt64,
        value: UInt64,
        size: UInt32,
        sym_type: UInt8,
        sym_bind: UInt8,
        section: UInt32
    ) -> UInt32 {
        if sym_type > TYPE_FILE {
            return ERR_INVALID_FORMAT;
        } else {
            if sym_bind > SYM_WEAK {
                return ERR_INVALID_FORMAT;
            } else {
                if section >= 65535 {
                    return ERR_INVALID_SECTION;
                } else {
                    let register_status = host_linker_object_add_symbol(
                        name,
                        sym_bind,
                        sym_type,
                        section,
                        value,
                        size,
                        0
                    );
                    return register_status;
                }
            }
        }
    }

    proc K::find_symbol(name: UInt64) -> UInt32 {
        return host_linker_global_symbol_defined(name);
    }

    proc K::get_symbol(name: UInt64) -> UInt64 {
        return host_linker_global_symbol_address(name);
    }

    proc K::get_symbol_count() -> UInt32 {
        return host_linker_global_symbol_count();
    }

    proc K::resolve_symbol(name: UInt64) -> UInt64 {
        return host_linker_global_symbol_address(name);
    }

    proc K::define_symbol(name: UInt64, value: UInt64) -> UInt32 {
        if name == 0 {
            return ERR_UNDEFINED_SYMBOL;
        } else {
            return host_linker_global_symbol_define_absolute(name, value);
        }
    }

    proc K::select_definition(
        lhs_defined: UInt32,
        lhs_bind: UInt8,
        rhs_defined: UInt32,
        rhs_bind: UInt8
    ) -> UInt32 {
        if lhs_defined == 1 {
            if rhs_defined == 1 {
                if lhs_bind == SYM_GLOBAL {
                    if rhs_bind == SYM_GLOBAL {
                        return ERR_MULTIPLE_DEFINITION;
                    } else {
                        return 1;
                    }
                } else {
                    if rhs_bind == SYM_GLOBAL {
                        return 2;
                    } else {
                        if lhs_bind == SYM_WEAK {
                            return 1;
                        } else {
                            return 2;
                        }
                    }
                }
            } else {
                return 1;
            }
        } else {
            if rhs_defined == 1 {
                return 2;
            } else {
                return ERR_UNDEFINED_SYMBOL;
            }
        }
    }

    proc K::calc_symbol_runtime_address(
        image_base: UInt64,
        section_addr: UInt64,
        symbol_value: UInt64,
        shndx: UInt16
    ) -> UInt64 {
        if shndx == SHN_UNDEF {
            return 0;
        } else {
            if shndx == SHN_ABS {
                return symbol_value;
            } else {
                return image_base + section_addr + symbol_value;
            }
        }
    }

    proc K::resolve_undefined(undefined_count: UInt32, weak_fallbacks: UInt32) -> UInt32 {
        if undefined_count == 0 {
            return ERR_OK;
        } else {
            if weak_fallbacks >= undefined_count {
                return ERR_OK;
            } else {
                return ERR_UNDEFINED_SYMBOL;
            }
        }
    }

    proc K::merge_binding(lhs: UInt32, rhs: UInt32) -> UInt32 {
        if lhs == BIND_GLOBAL {
            return BIND_GLOBAL;
        } else {
            if rhs == BIND_GLOBAL {
                return BIND_GLOBAL;
            } else {
                if lhs == BIND_WEAK {
                    return BIND_WEAK;
                } else {
                    if rhs == BIND_WEAK {
                        return BIND_WEAK;
                    } else {
                        return BIND_LOCAL;
                    }
                }
            }
        }
    }

    proc K::prefer_concrete_weak_over_zero_addr_fallback(
        decision: UInt32,
        lhs_bind: UInt8,
        rhs_bind: UInt8,
        name_hash: UInt64
    ) -> UInt32 {
        if decision == 1 {
            if lhs_bind == SYM_WEAK {
                if rhs_bind == SYM_WEAK {
                    if host_linker_global_symbol_address(name_hash) == 0 {
                        return 2;
                    }
                }
            }
        }
        return decision;
    }

    proc K::resolve_symbol_slot(object_index: UInt32, symbol_index: UInt32) -> UInt32 {
        let name_hash = host_linker_object_symbol_name_hash(object_index, symbol_index);
        let rhs_defined = host_linker_object_symbol_defined(object_index, symbol_index);
        let rhs_bind = host_linker_object_symbol_bind(object_index, symbol_index);

        if rhs_defined == 0 {
            return ERR_OK;
        } else {
            let lhs_defined = host_linker_global_symbol_defined(name_hash);
            let lhs_bind = host_linker_global_symbol_bind(name_hash);
            let base_decision = select_definition(lhs_defined, lhs_bind, rhs_defined, rhs_bind);
            let decision = prefer_concrete_weak_over_zero_addr_fallback(
                base_decision,
                lhs_bind,
                rhs_bind,
                name_hash
            );
            if decision == ERR_MULTIPLE_DEFINITION {
                if host_linker_get_allow_multiple_definition() == 1 {
                    return ERR_OK;
                } else {
                    return ERR_MULTIPLE_DEFINITION;
                }
            } else {
                if decision == ERR_UNDEFINED_SYMBOL {
                    return ERR_UNDEFINED_SYMBOL;
                } else {
                    if decision == 2 {
                        return host_linker_global_symbol_set(
                            name_hash,
                            object_index,
                            symbol_index,
                            rhs_bind,
                            rhs_defined
                        );
                    } else {
                        return ERR_OK;
                    }
                }
            }
        }
    }

    proc K::resolve_object_symbols(
        object_index: UInt32,
        symbol_index: UInt32,
        symbol_count: UInt32
    ) -> UInt32 {
        if symbol_index >= symbol_count {
            return ERR_OK;
        } else {
            let slot_status = resolve_symbol_slot(object_index, symbol_index);
            if slot_status ! ERR_OK {
                return slot_status;
            } else {
                return resolve_object_symbols(object_index, symbol_index + 1, symbol_count);
            }
        }
    }

    proc K::resolve_loaded_symbol_graph(
        object_index: UInt32,
        object_count: UInt32
    ) -> UInt32 {
        if object_index >= object_count {
            return ERR_OK;
        } else {
            let symbol_count = host_linker_object_symbol_count(object_index);
            let object_status = resolve_object_symbols(object_index, 0, symbol_count);
            if object_status ! ERR_OK {
                return object_status;
            } else {
                return resolve_loaded_symbol_graph(object_index + 1, object_count);
            }
        }
    }

    proc K::resolve_loaded_symbols() -> UInt32 {
        let object_count = host_linker_object_count();
        if object_count == 0 {
            return ERR_UNDEFINED_SYMBOL;
        } else {
            return resolve_loaded_symbol_graph(0, object_count);
        }
    }

    proc K::unresolved_policy_allows(policy: UInt32, allow_dynamic: UInt32) -> UInt32 {
        if policy == UNRESOLVED_POLICY_IGNORE_ALL {
            return 1;
        } else {
            if policy == UNRESOLVED_POLICY_IGNORE_IN_OBJECT_FILES {
                return 1;
            } else {
                if policy == UNRESOLVED_POLICY_IGNORE_IN_SHARED_LIBS {
                    return 0;
                } else {
                    if policy == UNRESOLVED_POLICY_REPORT_ALL {
                        return allow_dynamic;
                    } else {
                        return 0;
                    }
                }
            }
        }
    }

    proc K::shared_unresolved_policy_allows(policy: UInt32, allow_shlib_undefined: UInt32) -> UInt32 {
        if policy == UNRESOLVED_POLICY_IGNORE_ALL {
            return 1;
        } else {
            if policy == UNRESOLVED_POLICY_IGNORE_IN_SHARED_LIBS {
                return 1;
            } else {
                if policy == UNRESOLVED_POLICY_IGNORE_IN_OBJECT_FILES {
                    return allow_shlib_undefined;
                } else {
                    if policy == UNRESOLVED_POLICY_REPORT_ALL {
                        return allow_shlib_undefined;
                    } else {
                        return 0;
                    }
                }
            }
        }
    }

    proc K::check_unresolved_globals() -> UInt32 {
        let object_unresolved = host_linker_unresolved_symbol_count();
        let shared_unresolved = DustLink::K::shared_undefined_symbol_count();
        if object_unresolved == 0 {
            if shared_unresolved == 0 {
                return host_linker_check_required_symbols();
            }
        }

        let weak_fallbacks = host_linker_weak_fallback_count();
        let policy = host_linker_get_unresolved_policy();
        let warn_unresolved = host_linker_get_warn_unresolved();
        let allow_dynamic = host_linker_allow_dynamic_unresolved();
        let allow_shlib_undefined = DustLink::K::get_allow_shlib_undefined();

        if object_unresolved > 0 {
            let object_status = resolve_undefined(object_unresolved, weak_fallbacks);
            if object_status ! ERR_OK {
                if host_linker_get_no_undefined() == 1 {
                    return object_status;
                }

                if warn_unresolved == 1 {
                    let warn_only = DustLink::K::emit_unresolved_warning(object_unresolved, weak_fallbacks);
                    if warn_only ! ERR_OK {
                        return warn_only;
                    }
                } else {
                    let allow_by_policy = unresolved_policy_allows(policy, allow_dynamic);
                    if allow_by_policy == 0 {
                        return object_status;
                    }
                }
            }
        }

        if shared_unresolved > 0 {
            if host_linker_get_no_undefined() == 1 {
                return ERR_UNDEFINED_SYMBOL;
            }

            let shared_allowed = shared_unresolved_policy_allows(policy, allow_shlib_undefined);
            if shared_allowed == 0 {
                if warn_unresolved == 1 {
                    let warn_shared = DustLink::K::emit_unresolved_warning(shared_unresolved, 0);
                    if warn_shared ! ERR_OK {
                        return warn_shared;
                    }
                } else {
                    return ERR_UNDEFINED_SYMBOL;
                }
            } else {
                if warn_unresolved == 1 {
                    let warn_shared_ok = DustLink::K::emit_unresolved_warning(shared_unresolved, 0);
                    if warn_shared_ok ! ERR_OK {
                        return warn_shared_ok;
                    }
                }
            }
        }

        return host_linker_check_required_symbols();
    }
}
