    proc run_all_tests() -> UInt32 {
        let passed = 0;
        
        passed = passed + DustLinkTests::test_k_link();
        passed = passed + DustLinkTests::test_k_link_with_options();
        passed = passed + DustLinkTests::test_k_add_input_file();
        passed = passed + DustLinkTests::test_k_set_output();
        passed = passed + DustLinkTests::test_k_set_output_format();
        passed = passed + DustLinkTests::test_k_set_entry_point();
        passed = passed + DustLinkTests::test_k_set_base_address();
        passed = passed + DustLinkTests::test_k_add_search_path();
        passed = passed + DustLinkTests::test_k_add_library();
        passed = passed + DustLinkTests::test_k_run();
        passed = passed + DustLinkTests::test_k_get_error();
        passed = passed + DustLinkTests::test_k_print_sections();
        passed = passed + DustLinkTests::test_k_print_symbols();
        passed = passed + DustLinkTests::test_k_print_relocations();
        passed = passed + DustLinkTests::test_k_strip_debug();
        passed = passed + DustLinkTests::test_k_create_map_file();
        passed = passed + DustLinkTests::test_k_verify_image();
        passed = passed + DustLinkTests::test_q_link_returns_error();
        passed = passed + DustLinkTests::test_q_link_with_options_returns_error();
        passed = passed + DustLinkTests::test_q_add_input_file_returns_error();
        passed = passed + DustLinkTests::test_q_set_output_returns_error();
        passed = passed + DustLinkTests::test_q_set_output_format_returns_error();
        passed = passed + DustLinkTests::test_q_set_entry_point_returns_error();
        passed = passed + DustLinkTests::test_q_set_base_address_returns_error();
        passed = passed + DustLinkTests::test_q_add_search_path_returns_error();
        passed = passed + DustLinkTests::test_q_add_library_returns_error();
        passed = passed + DustLinkTests::test_q_run_returns_error();
        passed = passed + DustLinkTests::test_q_get_error();
        passed = passed + DustLinkTests::test_q_print_sections_returns_error();
        passed = passed + DustLinkTests::test_q_print_symbols_returns_error();
        passed = passed + DustLinkTests::test_q_print_relocations_returns_error();
        passed = passed + DustLinkTests::test_q_strip_debug_returns_error();
        passed = passed + DustLinkTests::test_q_create_map_file_returns_error();
        passed = passed + DustLinkTests::test_q_verify_image_returns_error();
        passed = passed + DustLinkTests::test_phi_link_returns_error();
        passed = passed + DustLinkTests::test_phi_link_with_options_returns_error();
        passed = passed + DustLinkTests::test_phi_add_input_file_returns_error();
        passed = passed + DustLinkTests::test_phi_set_output_returns_error();
        passed = passed + DustLinkTests::test_phi_set_output_format_returns_error();
        passed = passed + DustLinkTests::test_phi_set_entry_point_returns_error();
        passed = passed + DustLinkTests::test_phi_set_base_address_returns_error();
        passed = passed + DustLinkTests::test_phi_add_search_path_returns_error();
        passed = passed + DustLinkTests::test_phi_add_library_returns_error();
        passed = passed + DustLinkTests::test_phi_run_returns_error();
        passed = passed + DustLinkTests::test_phi_get_error();
        passed = passed + DustLinkTests::test_phi_print_sections_returns_error();
        passed = passed + DustLinkTests::test_phi_print_symbols_returns_error();
        passed = passed + DustLinkTests::test_phi_print_relocations_returns_error();
        passed = passed + DustLinkTests::test_phi_strip_debug_returns_error();
        passed = passed + DustLinkTests::test_phi_create_map_file_returns_error();
        passed = passed + DustLinkTests::test_phi_verify_image_returns_error();
        
        return passed;
    }
