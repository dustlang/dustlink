// Link stage behavior tests for the Dust internal linker profile.

forge LinkerLinkTests {
    const ERR_OK: UInt32 = 0;
    const ERR_FILE_NOT_FOUND: UInt32 = 1;
    const ERR_INVALID_ADDRESS: UInt32 = 8;
    const ERR_INVALID_ENTRY: UInt32 = 9;
    const ERR_WRITE_FAILED: UInt32 = 10;
    const ERR_UNSUPPORTED_FLAG: UInt32 = 12;
    const ERR_UNSUPPORTED_TARGET: UInt32 = 14;
    const ERR_CONFLICTING_OPTIONS: UInt32 = 16;
    const LINKER_INTERNAL: UInt32 = 1;
    const TARGET_X86_64_LINUX: UInt32 = 1;
    const TARGET_AARCH64_LINUX: UInt32 = 4;
    const FORMAT_ELF64: UInt32 = 1;
    const FORMAT_PE64: UInt32 = 4;
    const FORMAT_MACHO64: UInt32 = 5;

    proc K::expect_u32(actual: UInt32, expected: UInt32) -> UInt32 {
        if actual == expected {
            return 1;
        } else {
            return 0;
        }
    }

    proc K::test_add_object_requires_path() -> UInt32 {
        let result = LinkerLink::K::add_object_file(0);
        return expect_u32(result, ERR_FILE_NOT_FOUND);
    }

    proc K::test_set_linker_internal_ok() -> UInt32 {
        let result = LinkerLink::K::set_linker(LINKER_INTERNAL);
        return expect_u32(result, ERR_OK);
    }

    proc K::test_set_linker_invalid_rejected() -> UInt32 {
        let result = LinkerLink::K::set_linker(99);
        return expect_u32(result, ERR_UNSUPPORTED_FLAG);
    }

    proc K::test_target_linux_supported() -> UInt32 {
        let result = LinkerLink::K::set_target(TARGET_X86_64_LINUX);
        return expect_u32(result, ERR_OK);
    }

    proc K::test_target_aarch64_linux_supported() -> UInt32 {
        let result = LinkerLink::K::set_target(TARGET_AARCH64_LINUX);
        return expect_u32(result, ERR_OK);
    }

    proc K::test_target_invalid_rejected() -> UInt32 {
        let result = LinkerLink::K::set_target(99);
        return expect_u32(result, ERR_UNSUPPORTED_TARGET);
    }

    proc K::test_set_output_requires_path() -> UInt32 {
        let result = LinkerLink::K::set_output(0);
        return expect_u32(result, ERR_WRITE_FAILED);
    }

    proc K::test_entry_requires_nonzero() -> UInt32 {
        let result = LinkerLink::K::set_entry(0);
        return expect_u32(result, ERR_INVALID_ENTRY);
    }

    proc K::test_base_requires_page_alignment() -> UInt32 {
        let result = LinkerLink::K::set_base_address(12345);
        return expect_u32(result, ERR_INVALID_ADDRESS);
    }

    proc K::test_create_flat_binary_basic() -> UInt32 {
        let result = LinkerLink::K::create_flat_binary(1, 1048576);
        return expect_u32(result, ERR_OK);
    }

    proc K::test_create_mbr_image_requires_kernel() -> UInt32 {
        let result = LinkerLink::K::create_mbr_image(1, 1, 0);
        return expect_u32(result, ERR_FILE_NOT_FOUND);
    }

    proc K::test_find_linker_prefers_internal() -> UInt32 {
        let result = LinkerLink::K::find_linker();
        return expect_u32(result, LINKER_INTERNAL);
    }

    proc K::test_format_elf_supported() -> UInt32 {
        let result = LinkerLink::K::is_supported_format(FORMAT_ELF64);
        return expect_u32(result, 1);
    }

    proc K::test_format_pe_supported() -> UInt32 {
        let result = LinkerLink::K::is_supported_format(FORMAT_PE64);
        return expect_u32(result, 1);
    }

    proc K::test_format_macho_supported() -> UInt32 {
        let result = LinkerLink::K::is_supported_format(FORMAT_MACHO64);
        return expect_u32(result, 1);
    }

    proc K::test_group_push_pop_roundtrip() -> UInt32 {
        DustLink::K::reset_state();
        let s = DustLink::K::start_group();
        if s ! ERR_OK {
            return 0;
        }
        let depth_after_start = host_linker_group_depth();
        if depth_after_start ! 1 {
            return 0;
        }
        let e = DustLink::K::end_group_and_resolve();
        if e ! ERR_OK {
            return 0;
        }
        let depth_after_end = host_linker_group_depth();
        return expect_u32(depth_after_end, 0);
    }

    proc K::test_end_group_without_start_rejected() -> UInt32 {
        DustLink::K::reset_state();
        let result = DustLink::K::end_group_and_resolve();
        return expect_u32(result, ERR_CONFLICTING_OPTIONS);
    }

    proc K::test_start_lib_push_pop_roundtrip() -> UInt32 {
        DustLink::K::reset_state();
        let s = DustLink::K::start_lib_begin();
        if s ! ERR_OK {
            return 0;
        }
        let depth_after_start = DustLink::K::start_lib_depth();
        if depth_after_start ! 1 {
            return 0;
        }
        let e = DustLink::K::end_start_lib_and_resolve();
        if e ! ERR_OK {
            return 0;
        }
        let depth_after_end = DustLink::K::start_lib_depth();
        return expect_u32(depth_after_end, 0);
    }

    proc K::test_end_start_lib_without_start_rejected() -> UInt32 {
        DustLink::K::reset_state();
        let result = DustLink::K::end_start_lib_and_resolve();
        return expect_u32(result, ERR_CONFLICTING_OPTIONS);
    }

    proc K::test_validate_no_open_start_libs_conflict_when_unclosed() -> UInt32 {
        DustLink::K::reset_state();
        let s = DustLink::K::start_lib_begin();
        if s ! ERR_OK {
            return 0;
        }
        let bad = DustLink::K::validate_no_open_start_libs();
        if bad ! ERR_CONFLICTING_OPTIONS {
            return 0;
        }
        let e = DustLink::K::end_start_lib_and_resolve();
        if e ! ERR_OK {
            return 0;
        }
        let ok = DustLink::K::validate_no_open_start_libs();
        return expect_u32(ok, ERR_OK);
    }

    proc K::test_q_rejected() -> UInt32 {
        let result = LinkerLink::Q::link();
        return expect_u32(result, 100);
    }

    proc K::test_phi_rejected() -> UInt32 {
        let result = LinkerLink::Φ::link();
        return expect_u32(result, 100);
    }

    proc K::run_all_tests() -> UInt32 {
        let passed =
            test_add_object_requires_path()
            + test_set_linker_internal_ok()
            + test_set_linker_invalid_rejected()
            + test_target_linux_supported()
            + test_target_aarch64_linux_supported()
            + test_target_invalid_rejected()
            + test_set_output_requires_path()
            + test_entry_requires_nonzero()
            + test_base_requires_page_alignment()
            + test_create_flat_binary_basic()
            + test_create_mbr_image_requires_kernel()
            + test_find_linker_prefers_internal()
            + test_format_elf_supported()
            + test_format_pe_supported()
            + test_format_macho_supported()
            + test_group_push_pop_roundtrip()
            + test_end_group_without_start_rejected()
            + test_start_lib_push_pop_roundtrip()
            + test_end_start_lib_without_start_rejected()
            + test_validate_no_open_start_libs_conflict_when_unclosed()
            + test_q_rejected()
            + test_phi_rejected();
        return passed;
    }
}

