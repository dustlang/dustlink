        passed = passed + LinkerLinkTests::test_q_link_with_script_returns_error();
        passed = passed + LinkerLinkTests::test_q_create_flat_binary_returns_error();
        passed = passed + LinkerLinkTests::test_q_create_mbr_image_returns_error();
        passed = passed + LinkerLinkTests::test_q_get_linker_path();
        passed = passed + LinkerLinkTests::test_q_find_linker_returns_error();
        passed = passed + LinkerLinkTests::test_phi_add_object_file_returns_error();
