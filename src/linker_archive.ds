// Archive (.a) ingestion and deterministic -L/-l resolution.

forge LinkerArchive {
    const ERR_OK: UInt32 = 0;
    const ERR_FILE_NOT_FOUND: UInt32 = 1;
    const ERR_INVALID_FORMAT: UInt32 = 2;
    const ERR_CONFLICTING_OPTIONS: UInt32 = 16;

    const TARGET_NONE: UInt32 = 0;
    const TARGET_X86_64_LINUX: UInt32 = 1;
    const TARGET_X86_64_WINDOWS: UInt32 = 2;
    const TARGET_X86_64_MACOS: UInt32 = 3;
    const TARGET_AARCH64_LINUX: UInt32 = 4;
    const TARGET_AARCH64_WINDOWS: UInt32 = 5;
    const TARGET_AARCH64_MACOS: UInt32 = 6;

    proc K::is_windows_target(target: UInt32) -> UInt32 {
        if target == TARGET_X86_64_WINDOWS {
            return 1;
        } else {
            if target == TARGET_AARCH64_WINDOWS {
                return 1;
            } else {
                return 0;
            }
        }
    }

    proc K::is_macos_target(target: UInt32) -> UInt32 {
        if target == TARGET_X86_64_MACOS {
            return 1;
        } else {
            if target == TARGET_AARCH64_MACOS {
                return 1;
            } else {
                return 0;
            }
        }
    }

    proc K::is_archive_path(path: UInt64) -> UInt32 {
        if LinkerFs::K::str_ends_with(path, ".a") == 1 {
            return 1;
        } else {
            if LinkerFs::K::str_ends_with(path, ".lib") == 1 {
                return 1;
            } else {
                return 0;
            }
        }
    }

    proc K::archive_member_count(path: UInt64) -> UInt32 {
        return host_archive_member_count(path);
    }

    proc K::archive_member_kind(path: UInt64, index: UInt32) -> UInt32 {
        return host_archive_member_object_kind(path, index);
    }

    proc K::archive_extract_member_object(path: UInt64, index: UInt32) -> UInt64 {
        return host_archive_extract_member_object(path, index);
    }

    proc K::archive_member_matches_unresolved(path: UInt64, index: UInt32) -> UInt32 {
        return host_archive_member_matches_unresolved(path, index);
    }

    proc K::archive_member_is_loaded(path: UInt64, index: UInt32) -> UInt32 {
        return host_archive_member_is_loaded(path, index);
    }

    proc K::archive_member_mark_loaded(path: UInt64, index: UInt32) -> UInt32 {
        return host_archive_member_mark_loaded(path, index);
    }

    proc K::archive_progress_reset() -> UInt32 {
        return host_linker_archive_progress_reset();
    }

    proc K::archive_progress_add(delta: UInt32) -> UInt32 {
        return host_linker_archive_progress_add(delta);
    }

    proc K::archive_progress_get() -> UInt32 {
        return host_linker_archive_progress_get();
    }

    proc K::group_push_start() -> UInt32 {
        return host_linker_group_push_start();
    }

    proc K::group_pop_start() -> UInt32 {
        return host_linker_group_pop_start();
    }

    proc K::group_depth() -> UInt32 {
        return host_linker_group_depth();
    }

    proc K::start_lib_push_start() -> UInt32 {
        return host_linker_start_lib_push_start();
    }

    proc K::start_lib_pop_start() -> UInt32 {
        return host_linker_start_lib_pop_start();
    }

    proc K::start_lib_depth() -> UInt32 {
        return host_linker_start_lib_depth();
    }

    proc K::start_lib_register_member(path: UInt64) -> UInt32 {
        return host_linker_start_lib_register_member(path);
    }

    proc K::start_lib_member_count() -> UInt32 {
        return host_linker_start_lib_member_count();
    }

    proc K::get_start_lib_member(index: UInt32) -> UInt64 {
        return host_linker_get_start_lib_member(index);
    }

    proc K::start_lib_member_is_loaded(index: UInt32) -> UInt32 {
        return host_linker_start_lib_member_is_loaded(index);
    }

    proc K::start_lib_member_mark_loaded(index: UInt32) -> UInt32 {
        return host_linker_start_lib_member_mark_loaded(index);
    }

    proc K::start_lib_member_matches_unresolved(index: UInt32) -> UInt32 {
        return host_linker_start_lib_member_matches_unresolved(index);
    }

    proc K::start_lib_progress_reset() -> UInt32 {
        return host_linker_start_lib_progress_reset();
    }

    proc K::start_lib_progress_add(delta: UInt32) -> UInt32 {
        return host_linker_start_lib_progress_add(delta);
    }

    proc K::start_lib_progress_get() -> UInt32 {
        return host_linker_start_lib_progress_get();
    }

    proc K::validate_archive(path: UInt64) -> UInt32 {
        let file_status = LinkerFs::K::validate_input_file(path);
        if file_status ! ERR_OK {
            return file_status;
        } else {
            if is_archive_path(path) == 0 {
                return ERR_INVALID_FORMAT;
            } else {
                let magic_ok = host_archive_validate_magic(path);
                if magic_ok == 1 {
                    return ERR_OK;
                } else {
                    return ERR_INVALID_FORMAT;
                }
            }
        }
    }

    proc K::ingest_object_file(path: UInt64) -> UInt32 {
        let object_kind = host_linker_probe_object_format(path);
        if object_kind == 1 {
            return ElfFormat::K::ingest_object_file(path);
        } else {
            if object_kind == 2 {
                return host_linker_ingest_coff_object(path);
            } else {
                if object_kind == 3 {
                    return host_linker_ingest_macho_object(path);
                } else {
                    return ERR_INVALID_FORMAT;
                }
            }
        }
    }

    proc K::archive_member_selected_for_ingest(path: UInt64, index: UInt32) -> UInt32 {
        if host_linker_get_whole_archive() == 1 {
            return 1;
        } else {
            return archive_member_matches_unresolved(path, index);
        }
    }

    proc K::ingest_archive_member_if_needed(path: UInt64, index: UInt32) -> UInt32 {
        if archive_member_is_loaded(path, index) == 1 {
            return ERR_OK;
        } else {
            let member_kind = archive_member_kind(path, index);
            if member_kind == 0 {
                return ERR_OK;
            } else {
                let should_ingest = archive_member_selected_for_ingest(path, index);
                if should_ingest == 0 {
                    return ERR_OK;
                } else {
                    let obj_path = archive_extract_member_object(path, index);
                    if obj_path == 0 {
                        return ERR_INVALID_FORMAT;
                    } else {
                        let ingest_status = ingest_object_file(obj_path);
                        if ingest_status ! ERR_OK {
                            return ingest_status;
                        } else {
                            let mark = archive_member_mark_loaded(path, index);
                            if mark == 1 {
                                let add = archive_progress_add(1);
                                if add ! ERR_OK {
                                    return add;
                                } else {
                                    return ERR_OK;
                                }
                            } else {
                                return ERR_OK;
                            }
                        }
                    }
                }
            }
        }
    }

    proc K::ingest_archive_members(path: UInt64, index: UInt32, total: UInt32) -> UInt32 {
        if index >= total {
            return ERR_OK;
        } else {
            let ingest_status = ingest_archive_member_if_needed(path, index);
            if ingest_status ! ERR_OK {
                return ingest_status;
            } else {
                return ingest_archive_members(path, index + 1, total);
            }
        }
    }

    proc K::ingest_archive_fixpoint(path: UInt64, total: UInt32, round: UInt32) -> UInt32 {
        if round >= total {
            return ERR_OK;
        } else {
            let reset_status = archive_progress_reset();
            if reset_status ! ERR_OK {
                return reset_status;
            } else {
                let pass_status = ingest_archive_members(path, 0, total);
                if pass_status ! ERR_OK {
                    return pass_status;
                } else {
                    let added = archive_progress_get();
                    if added == 0 {
                        return ERR_OK;
                    } else {
                        let resolved = LinkerSymbol::K::resolve_loaded_symbols();
                        if resolved ! ERR_OK {
                            return resolved;
                        } else {
                            return ingest_archive_fixpoint(path, total, round + 1);
                        }
                    }
                }
            }
        }
    }

    proc K::ingest_archive(path: UInt64) -> UInt32 {
        let status = validate_archive(path);
        if status ! ERR_OK {
            return status;
        } else {
            let member_count = archive_member_count(path);
            if member_count == 0 {
                return ERR_INVALID_FORMAT;
            } else {
                let register_status = host_linker_register_archive(path);
                if register_status ! ERR_OK {
                    return register_status;
                } else {
                    return ingest_archive_fixpoint(path, member_count, 0);
                }
            }
        }
    }

    proc K::register_archive_for_group(path: UInt64) -> UInt32 {
        let status = validate_archive(path);
        if status ! ERR_OK {
            return status;
        } else {
            return host_linker_register_archive(path);
        }
    }

    proc K::resolve_registered_archives_pass(index: UInt32, start: UInt32, end: UInt32) -> UInt32 {
        if index >= end {
            return ERR_OK;
        } else {
            if index < start {
                return resolve_registered_archives_pass(index + 1, start, end);
            }
            let archive_path = host_linker_get_archive(index);
            if archive_path == 0 {
                return resolve_registered_archives_pass(index + 1, start, end);
            } else {
                let member_count = archive_member_count(archive_path);
                if member_count == 0 {
                    return resolve_registered_archives_pass(index + 1, start, end);
                } else {
                    let status = ingest_archive_fixpoint(archive_path, member_count, 0);
                    if status ! ERR_OK {
                        return status;
                    } else {
                        return resolve_registered_archives_pass(index + 1, start, end);
                    }
                }
            }
        }
    }

    proc K::resolve_registered_archives_fixpoint(start: UInt32, end: UInt32, round: UInt32) -> UInt32 {
        if round >= 4096 {
            return ERR_OK;
        } else {
            let before = host_linker_object_count();
            let pass_status = resolve_registered_archives_pass(start, start, end);
            if pass_status ! ERR_OK {
                return pass_status;
            } else {
                let after = host_linker_object_count();
                if after <= before {
                    return ERR_OK;
                } else {
                    return resolve_registered_archives_fixpoint(start, end, round + 1);
                }
            }
        }
    }

    proc K::resolve_registered_archives_range(start: UInt32, end: UInt32) -> UInt32 {
        if start >= end {
            return ERR_OK;
        } else {
            return resolve_registered_archives_fixpoint(start, end, 0);
        }
    }

    proc K::resolve_registered_archives() -> UInt32 {
        let count = host_linker_archive_count();
        if count == 0 {
            return ERR_OK;
        } else {
            return resolve_registered_archives_range(0, count);
        }
    }

    proc K::start_group() -> UInt32 {
        return group_push_start();
    }

    proc K::end_group_and_resolve() -> UInt32 {
        let depth = group_depth();
        if depth == 0 {
            return ERR_CONFLICTING_OPTIONS;
        } else {
            let start = group_pop_start();
            if start == 4294967295 {
                return ERR_CONFLICTING_OPTIONS;
            } else {
                let end = host_linker_archive_count();
                return resolve_registered_archives_range(start, end);
            }
        }
    }

    proc K::validate_no_open_groups() -> UInt32 {
        if group_depth() == 0 {
            return ERR_OK;
        } else {
            return ERR_CONFLICTING_OPTIONS;
        }
    }

    proc K::start_lib_member_selected_for_ingest(index: UInt32) -> UInt32 {
        if host_linker_get_whole_archive() == 1 {
            return 1;
        } else {
            return start_lib_member_matches_unresolved(index);
        }
    }

    proc K::ingest_start_lib_member_if_needed(index: UInt32) -> UInt32 {
        if start_lib_member_is_loaded(index) == 1 {
            return ERR_OK;
        } else {
            let should_ingest = start_lib_member_selected_for_ingest(index);
            if should_ingest == 0 {
                return ERR_OK;
            } else {
                let path = get_start_lib_member(index);
                if path == 0 {
                    return ERR_INVALID_FORMAT;
                } else {
                    let ingest_status = ingest_object_file(path);
                    if ingest_status ! ERR_OK {
                        return ingest_status;
                    } else {
                        let mark = start_lib_member_mark_loaded(index);
                        if mark == 1 {
                            return start_lib_progress_add(1);
                        } else {
                            return ERR_OK;
                        }
                    }
                }
            }
        }
    }

    proc K::ingest_start_lib_range_pass(index: UInt32, start: UInt32, end: UInt32) -> UInt32 {
        if index >= end {
            return ERR_OK;
        } else {
            if index < start {
                return ingest_start_lib_range_pass(index + 1, start, end);
            } else {
                let status = ingest_start_lib_member_if_needed(index);
                if status ! ERR_OK {
                    return status;
                } else {
                    return ingest_start_lib_range_pass(index + 1, start, end);
                }
            }
        }
    }

    proc K::resolve_start_lib_range_fixpoint(start: UInt32, end: UInt32, round: UInt32) -> UInt32 {
        if start >= end {
            return ERR_OK;
        } else {
            if round >= 4096 {
                return ERR_OK;
            } else {
                let reset_status = start_lib_progress_reset();
                if reset_status ! ERR_OK {
                    return reset_status;
                } else {
                    let pass_status = ingest_start_lib_range_pass(start, start, end);
                    if pass_status ! ERR_OK {
                        return pass_status;
                    } else {
                        let added = start_lib_progress_get();
                        if added == 0 {
                            return ERR_OK;
                        } else {
                            let resolved = LinkerSymbol::K::resolve_loaded_symbols();
                            if resolved ! ERR_OK {
                                return resolved;
                            } else {
                                return resolve_start_lib_range_fixpoint(start, end, round + 1);
                            }
                        }
                    }
                }
            }
        }
    }

    proc K::start_lib_begin() -> UInt32 {
        return start_lib_push_start();
    }

    proc K::register_start_lib_member(path: UInt64) -> UInt32 {
        let file_status = LinkerFs::K::validate_input_file(path);
        if file_status ! ERR_OK {
            return file_status;
        } else {
            if is_archive_path(path) == 1 {
                return ERR_INVALID_FORMAT;
            } else {
                let kind = host_linker_probe_object_format(path);
                if kind == 0 {
                    return ERR_INVALID_FORMAT;
                } else {
                    let reg = start_lib_register_member(path);
                    if reg ! ERR_OK {
                        return reg;
                    } else {
                        return host_linker_register_input(path);
                    }
                }
            }
        }
    }

    proc K::end_start_lib_and_resolve() -> UInt32 {
        let depth = start_lib_depth();
        if depth == 0 {
            return ERR_CONFLICTING_OPTIONS;
        } else {
            let start = start_lib_pop_start();
            if start == 4294967295 {
                return ERR_CONFLICTING_OPTIONS;
            } else {
                let end = start_lib_member_count();
                return resolve_start_lib_range_fixpoint(start, end, 0);
            }
        }
    }

    proc K::validate_no_open_start_libs() -> UInt32 {
        if start_lib_depth() == 0 {
            return ERR_OK;
        } else {
            return ERR_CONFLICTING_OPTIONS;
        }
    }

    proc K::path_is_existing_file(path: UInt64) -> UInt32 {
        if path == 0 {
            return 0;
        } else {
            if LinkerFs::K::path_exists(path) == 0 {
                return 0;
            } else {
                return LinkerFs::K::path_is_file(path);
            }
        }
    }

    proc K::is_shared_library_path(path: UInt64) -> UInt32 {
        if LinkerFs::K::str_ends_with(path, ".so") == 1 {
            return 1;
        } else {
            if LinkerFs::K::str_ends_with(path, ".dylib") == 1 {
                return 1;
            } else {
                if LinkerFs::K::str_ends_with(path, ".dll") == 1 {
                    return 1;
                } else {
                    return 0;
                }
            }
        }
    }

    proc K::exact_library_leaf(name: UInt64) -> UInt64 {
        if LinkerFs::K::str_starts_with(name, ":") == 1 {
            return LinkerFs::K::str_after_prefix(name, ":");
        } else {
            return 0;
        }
    }

    proc K::candidate_unix_lib_name(name: UInt64) -> UInt64 {
        let prefixed = LinkerFs::K::str_concat("lib", name);
        return LinkerFs::K::str_concat(prefixed, ".a");
    }

    proc K::candidate_unix_plain_name(name: UInt64) -> UInt64 {
        return LinkerFs::K::str_concat(name, ".a");
    }

    proc K::candidate_windows_plain_name(name: UInt64) -> UInt64 {
        return LinkerFs::K::str_concat(name, ".lib");
    }

    proc K::candidate_windows_lib_name(name: UInt64) -> UInt64 {
        let prefixed = LinkerFs::K::str_concat("lib", name);
        return LinkerFs::K::str_concat(prefixed, ".lib");
    }

    proc K::candidate_unix_shared_name(name: UInt64) -> UInt64 {
        let prefixed = LinkerFs::K::str_concat("lib", name);
        return LinkerFs::K::str_concat(prefixed, ".so");
    }

    proc K::candidate_macos_shared_name(name: UInt64) -> UInt64 {
        let prefixed = LinkerFs::K::str_concat("lib", name);
        return LinkerFs::K::str_concat(prefixed, ".dylib");
    }

    proc K::candidate_windows_shared_name(name: UInt64) -> UInt64 {
        return LinkerFs::K::str_concat(name, ".dll");
    }

    proc K::candidate_windows_lib_shared_name(name: UInt64) -> UInt64 {
        let prefixed = LinkerFs::K::str_concat("lib", name);
        return LinkerFs::K::str_concat(prefixed, ".dll");
    }

    proc K::resolve_versioned_shared_library_in_path(search_path: UInt64, name: UInt64, target: UInt32) -> UInt64 {
        let candidate = host_linker_find_versioned_shared_in_path(search_path, name, target);
        if candidate == 0 {
            return 0;
        } else {
            if path_is_existing_file(candidate) == 1 {
                return candidate;
            } else {
                return 0;
            }
        }
    }

    proc K::resolve_exact_library_in_path(search_path: UInt64, name: UInt64) -> UInt64 {
        let leaf = exact_library_leaf(name);
        if leaf == 0 {
            return 0;
        } else {
            let candidate = LinkerFs::K::path_join(search_path, leaf);
            if path_is_existing_file(candidate) == 1 {
                return candidate;
            } else {
                return 0;
            }
        }
    }

    proc K::resolve_static_library_in_path(search_path: UInt64, name: UInt64) -> UInt64 {
        let exact = resolve_exact_library_in_path(search_path, name);
        if exact ! 0 {
            return exact;
        }

        let unix_with_prefix = LinkerFs::K::path_join(search_path, candidate_unix_lib_name(name));
        if path_is_existing_file(unix_with_prefix) == 1 {
            return unix_with_prefix;
        }

        let unix_plain = LinkerFs::K::path_join(search_path, candidate_unix_plain_name(name));
        if path_is_existing_file(unix_plain) == 1 {
            return unix_plain;
        }

        let windows_plain = LinkerFs::K::path_join(search_path, candidate_windows_plain_name(name));
        if path_is_existing_file(windows_plain) == 1 {
            return windows_plain;
        }

        let windows_with_prefix = LinkerFs::K::path_join(search_path, candidate_windows_lib_name(name));
        if path_is_existing_file(windows_with_prefix) == 1 {
            return windows_with_prefix;
        }

        return 0;
    }

    proc K::resolve_shared_library_in_path(search_path: UInt64, name: UInt64, target: UInt32) -> UInt64 {
        let exact = resolve_exact_library_in_path(search_path, name);
        if exact ! 0 {
            if is_shared_library_path(exact) == 1 {
                return exact;
            } else {
                return 0;
            }
        }

        if is_windows_target(target) == 1 {
            let win_plain = LinkerFs::K::path_join(search_path, candidate_windows_shared_name(name));
            if path_is_existing_file(win_plain) == 1 {
                return win_plain;
            }
            let win_pref = LinkerFs::K::path_join(search_path, candidate_windows_lib_shared_name(name));
            if path_is_existing_file(win_pref) == 1 {
                return win_pref;
            }
        } else {
            if is_macos_target(target) == 1 {
                let mac = LinkerFs::K::path_join(search_path, candidate_macos_shared_name(name));
                if path_is_existing_file(mac) == 1 {
                    return mac;
                }
                let unix = LinkerFs::K::path_join(search_path, candidate_unix_shared_name(name));
                if path_is_existing_file(unix) == 1 {
                    return unix;
                }
            } else {
                let unix_linux = LinkerFs::K::path_join(search_path, candidate_unix_shared_name(name));
                if path_is_existing_file(unix_linux) == 1 {
                    return unix_linux;
                }
                let mac_linux = LinkerFs::K::path_join(search_path, candidate_macos_shared_name(name));
                if path_is_existing_file(mac_linux) == 1 {
                    return mac_linux;
                }
                let win_linux = LinkerFs::K::path_join(search_path, candidate_windows_shared_name(name));
                if path_is_existing_file(win_linux) == 1 {
                    return win_linux;
                }
            }
        }

        return resolve_versioned_shared_library_in_path(search_path, name, target);
    }

    proc K::resolve_library_with_search_paths_static(
        name: UInt64,
        path_index: UInt32,
        path_count: UInt32
    ) -> UInt64 {
        if path_index >= path_count {
            return 0;
        } else {
            let search_path = host_linker_get_search_path(path_index);
            let found = resolve_static_library_in_path(search_path, name);
            if found ! 0 {
                return found;
            } else {
                return resolve_library_with_search_paths_static(name, path_index + 1, path_count);
            }
        }
    }

    proc K::resolve_library_with_search_paths_dynamic(
        name: UInt64,
        target: UInt32,
        path_index: UInt32,
        path_count: UInt32
    ) -> UInt64 {
        if path_index >= path_count {
            return 0;
        } else {
            let search_path = host_linker_get_search_path(path_index);
            let shared = resolve_shared_library_in_path(search_path, name, target);
            if shared ! 0 {
                return shared;
            } else {
                let archive = resolve_static_library_in_path(search_path, name);
                if archive ! 0 {
                    return archive;
                } else {
                    return resolve_library_with_search_paths_dynamic(name, target, path_index + 1, path_count);
                }
            }
        }
    }

    proc K::resolve_library_with_search_paths(
        name: UInt64,
        target: UInt32,
        static_mode: UInt32,
        path_index: UInt32,
        path_count: UInt32
    ) -> UInt64 {
        if static_mode == 1 {
            return resolve_library_with_search_paths_static(name, path_index, path_count);
        } else {
            return resolve_library_with_search_paths_dynamic(name, target, path_index, path_count);
        }
    }

    proc K::resolve_library_with_rpath_links_dynamic(
        name: UInt64,
        target: UInt32,
        path_index: UInt32,
        path_count: UInt32
    ) -> UInt64 {
        if path_index >= path_count {
            return 0;
        } else {
            let search_path = host_linker_get_rpath_link(path_index);
            if search_path == 0 {
                return resolve_library_with_rpath_links_dynamic(name, target, path_index + 1, path_count);
            } else {
                let shared = resolve_shared_library_in_path(search_path, name, target);
                if shared ! 0 {
                    return shared;
                } else {
                    let archive = resolve_static_library_in_path(search_path, name);
                    if archive ! 0 {
                        return archive;
                    } else {
                        return resolve_library_with_rpath_links_dynamic(name, target, path_index + 1, path_count);
                    }
                }
            }
        }
    }

    proc K::resolve_library_with_default_paths_static(
        name: UInt64,
        path_index: UInt32,
        path_count: UInt32
    ) -> UInt64 {
        if path_index >= path_count {
            return 0;
        } else {
            let search_path = host_linker_get_default_search_path(path_index);
            if search_path == 0 {
                return resolve_library_with_default_paths_static(name, path_index + 1, path_count);
            } else {
                let found = resolve_static_library_in_path(search_path, name);
                if found ! 0 {
                    return found;
                } else {
                    return resolve_library_with_default_paths_static(name, path_index + 1, path_count);
                }
            }
        }
    }

    proc K::resolve_library_with_default_paths_dynamic(
        name: UInt64,
        target: UInt32,
        path_index: UInt32,
        path_count: UInt32
    ) -> UInt64 {
        if path_index >= path_count {
            return 0;
        } else {
            let search_path = host_linker_get_default_search_path(path_index);
            if search_path == 0 {
                return resolve_library_with_default_paths_dynamic(name, target, path_index + 1, path_count);
            } else {
                let shared = resolve_shared_library_in_path(search_path, name, target);
                if shared ! 0 {
                    return shared;
                } else {
                    let archive = resolve_static_library_in_path(search_path, name);
                    if archive ! 0 {
                        return archive;
                    } else {
                        return resolve_library_with_default_paths_dynamic(name, target, path_index + 1, path_count);
                    }
                }
            }
        }
    }

    proc K::resolve_library_with_default_paths(
        name: UInt64,
        target: UInt32,
        static_mode: UInt32,
        path_index: UInt32,
        path_count: UInt32
    ) -> UInt64 {
        if static_mode == 1 {
            return resolve_library_with_default_paths_static(name, path_index, path_count);
        } else {
            return resolve_library_with_default_paths_dynamic(name, target, path_index, path_count);
        }
    }

    proc K::resolve_library_with_search_order(
        name: UInt64,
        target: UInt32,
        static_mode: UInt32
    ) -> UInt64 {
        let explicit_count = host_linker_search_path_count();
        let explicit = resolve_library_with_search_paths(name, target, static_mode, 0, explicit_count);
        if explicit ! 0 {
            return explicit;
        }
        if static_mode == 0 {
            let rpath_link_count = host_linker_rpath_link_count();
            let rpath_link_hit = resolve_library_with_rpath_links_dynamic(name, target, 0, rpath_link_count);
            if rpath_link_hit ! 0 {
                return rpath_link_hit;
            }
        }
        if host_linker_get_use_default_search_paths() == 0 {
            return 0;
        }
        let default_count = host_linker_default_search_path_count();
        return resolve_library_with_default_paths(name, target, static_mode, 0, default_count);
    }

    proc K::ingest_resolved_library(name: UInt64, path: UInt64) -> UInt32 {
        if is_shared_library_path(path) == 1 {
            let shared_status = host_linker_ingest_shared_object(path);
            if shared_status ! ERR_OK {
                return shared_status;
            }
            let retained = host_linker_last_shared_object_retained();
            let note_status = host_linker_note_needed_library(name, path, retained);
            if note_status ! ERR_OK {
                return note_status;
            } else {
                return ERR_OK;
            }
        } else {
            if is_archive_path(path) == 1 {
                return ingest_archive(path);
            } else {
                return ingest_object_file(path);
            }
        }
    }

    proc K::resolve_and_ingest_library(name: UInt64) -> UInt32 {
        if name == 0 {
            return ERR_FILE_NOT_FOUND;
        } else {
            if host_linker_is_default_library_blocked(name) == 1 {
                return ERR_OK;
            }
            let target = host_linker_get_target();
            let static_mode = host_linker_get_static();
            let library = resolve_library_with_search_order(name, target, static_mode);
            if library == 0 {
                return ERR_FILE_NOT_FOUND;
            } else {
                if is_archive_path(library) == 1 {
                    if group_depth() > 0 {
                        return register_archive_for_group(library);
                    } else {
                        return ingest_archive(library);
                    }
                } else {
                    return ingest_resolved_library(name, library);
                }
            }
        }
    }
}
